DATA = HERE.parent / 'apps'
STATE = Path(os.environ.get('XDG_RUNTIME_DIR') or '/tmp') / 'fake-apps.json'
DATA_HOME = Path(os.environ.get('XDG_DATA_HOME') or Path.home() / '.local/share')
FLATPAK_SYSTEM = Path(os.environ.get('ARCTIC_FLATPAK_SYSTEM_DIR') or DATA / 'flatpak')

