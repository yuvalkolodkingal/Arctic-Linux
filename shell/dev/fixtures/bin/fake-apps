#!/usr/bin/env python3
"""Stand-ins for flatpak, rpm, dnf5, pkexec and arctic-webapp, for Get apps screenshots.

shell/dev/headless.sh --app-fixtures puts shell/dev/fixtures/bin first on PATH; each command
there is a link to this script, which answers from canned Fedora 44-like data (300 packages,
40 Flathub apps, a few installed apps and a web app) so nothing from the developer's own
system shows up. Installs and removals print dnf5 / flatpak-like progress and are remembered
in $XDG_RUNTIME_DIR/fake-apps.json for the session. Test data only; never packaged.
"""
