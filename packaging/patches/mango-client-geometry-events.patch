diff --git a/src/ipc/ipc.c b/src/ipc/ipc.c
index 8839228..a8c87ad 100644
--- a/src/ipc/ipc.c
+++ b/src/ipc/ipc.c
@@ -30,6 +30,31 @@
 
 static struct wl_list ipc_watch_clients;
 static int ipc_device_watch_count;
+static struct wl_event_source *ipc_geometry_timer;
+static bool ipc_geometry_pending;
+
+static int ipc_flush_client_geometry(void *data) {
+	(void)data;
+	ipc_geometry_pending = false;
+	printstatus(IPC_WATCH_ALL_CLIENTS | IPC_WATCH_CLIENT |
+				IPC_WATCH_FOCUSING_CLIENT);
+	return 0;
+}
+
+void ipc_schedule_client_geometry(void) {
+	if (!ipc_geometry_timer || ipc_geometry_pending)
+		return;
+	struct ipc_watch_client *wc;
+	wl_list_for_each(wc, &ipc_watch_clients, link) {
+		if (wc->type & (IPC_WATCH_ALL_CLIENTS | IPC_WATCH_CLIENT |
+						IPC_WATCH_FOCUSING_CLIENT)) {
+			/* A fixed deadline prevents continuous dragging from starving delivery. */
+			ipc_geometry_pending = true;
+			wl_event_source_timer_update(ipc_geometry_timer, 60);
+			return;
+		}
+	}
+}
 
 const char *ipc_device_type_str(struct wlr_input_device *dev) {
 	if (!dev)
@@ -520,6 +545,11 @@ static struct wl_event_source *ipc_event_source = NULL;
 static char ipc_socket_path[256];
 
 void ipc_cleanup(void) {
+	if (ipc_geometry_timer) {
+		wl_event_source_remove(ipc_geometry_timer);
+		ipc_geometry_timer = NULL;
+	}
+	ipc_geometry_pending = false;
 	if (ipc_event_source)
 		wl_event_source_remove(ipc_event_source);
 	if (ipc_socket_fd >= 0)
@@ -632,6 +662,9 @@ void handle_command(int client_fd, const char *cmd_raw) {
 	if (strcmp(cmd, "get version") == 0) {
 		resp = cJSON_CreateObject();
 		cJSON_AddStringToObject(resp, "version", VERSION);
+	} else if (strcmp(cmd, "get capabilities") == 0) {
+		resp = cJSON_CreateObject();
+		cJSON_AddBoolToObject(resp, "client_geometry_events", ipc_geometry_timer != NULL);
 	} else if (strcmp(cmd, "get cursorpos") == 0) {
 		resp = cJSON_CreateObject();
 		cJSON_AddNumberToObject(resp, "x", server.cursor->x);
@@ -1358,4 +1391,6 @@ void ipc_init(struct wl_event_loop *loop) {
 
 	ipc_event_source = wl_event_loop_add_fd(
 		loop, ipc_socket_fd, WL_EVENT_READABLE, ipc_handle_connection, loop);
+	ipc_geometry_timer =
+		wl_event_loop_add_timer(loop, ipc_flush_client_geometry, NULL);
 }
