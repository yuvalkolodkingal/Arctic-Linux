[Unit]
Description=Arctic Linux: finish installing apps put off during installation
Documentation=file:///usr/share/doc/arctic-installer
# Only when the installer left something to do (see /usr/libexec/arctic/arctic-firstboot).
ConditionPathExists=/var/lib/arctic/pending.json
# A post-boot timer starts downloads without pulling the network wait into login.
After=network-online.target nix-daemon.service

[Service]
# The downloads can take a long time: run them in the background. The start job completes
# once the script has started, so nothing waits for it.
Type=exec
ExecStart=/usr/libexec/arctic/arctic-firstboot
# Apps that cannot be installed stay in pending.json; the timer retries after 15 minutes.
Nice=10
IOSchedulingClass=idle
