[Unit]
Description=VoxType local voice-to-text daemon
Documentation=https://voxtype.io/docs/
PartOf=graphical-session.target
After=graphical-session.target pipewire.service pipewire-pulse.service
ConditionPathExists=/var/lib/arctic/dictation/upstream-direct-v1
ConditionPathExists=%h/.config/voxtype/config.toml
ConditionPathExists=%t/arctic/voxtype-session-started-v1

[Service]
Type=simple
UMask=0077
# Arctic's managed daemon needs only local Wayland, PipeWire and control sockets.
# This also prevents a user-edited config or inherited child hook from reaching
# a remote transcription endpoint.
RestrictAddressFamilies=AF_UNIX
# -q suppresses upstream info-level transcript excerpts. Remove inherited
# overrides that could bypass Arctic's local-only, no-hotkey and safe-output
# config; explicitly select that canonical file.
UnsetEnvironment=RUST_LOG SONIOX_API_KEY VOXTYPE_CONFIG VOXTYPE_ENGINE VOXTYPE_MODEL VOXTYPE_LANGUAGE VOXTYPE_TRANSLATE VOXTYPE_THREADS VOXTYPE_ON_DEMAND_LOADING
UnsetEnvironment=VOXTYPE_GPU_ISOLATION VOXTYPE_GPU_DEVICE VOXTYPE_FLASH_ATTENTION VOXTYPE_VULKAN_DEVICE VOXTYPE_CPU_BACKUP VOXTYPE_REMOTE_ENDPOINT VOXTYPE_WHISPER_API_KEY
UnsetEnvironment=VOXTYPE_OPENVINO_DIR VOXTYPE_OPENVINO_DEVICE VOXTYPE_OPENVINO_MODEL VOXTYPE_COHERE_MODEL_DIR VOXTYPE_MEETING_DIARIZATION
UnsetEnvironment=VOXTYPE_HOTKEY VOXTYPE_HOTKEY_ENABLED VOXTYPE_CANCEL_KEY VOXTYPE_AUDIO_DEVICE VOXTYPE_MAX_DURATION_SECS VOXTYPE_AUDIO_FEEDBACK
UnsetEnvironment=VOXTYPE_PAUSE_MEDIA VOXTYPE_DUCK_MEDIA VOXTYPE_DUCK_MEDIA_VOLUME_PERCENT VOXTYPE_DUCK_MEDIA_FADE_MS
UnsetEnvironment=VOXTYPE_OUTPUT_MODE VOXTYPE_APPEND_TEXT VOXTYPE_AUTO_SUBMIT VOXTYPE_SHIFT_ENTER_NEWLINES VOXTYPE_PRE_TYPE_DELAY VOXTYPE_TYPE_DELAY
UnsetEnvironment=VOXTYPE_FALLBACK_TO_CLIPBOARD VOXTYPE_PASTE_KEYS VOXTYPE_WTYPE_SHIFT_PREFIX VOXTYPE_DOTOOL_XKB_LAYOUT VOXTYPE_DOTOOL_XKB_VARIANT
UnsetEnvironment=VOXTYPE_EITYPE_XKB_LAYOUT VOXTYPE_EITYPE_XKB_VARIANT VOXTYPE_SMART_AUTO_SUBMIT VOXTYPE_FILTER_FILLERS VOXTYPE_SPOKEN_PUNCTUATION
UnsetEnvironment=VOXTYPE_RESTORE_CLIPBOARD VOXTYPE_RESTORE_CLIPBOARD_DELAY_MS VOXTYPE_CONTEXT
ExecStart=/usr/bin/voxtype --config %h/.config/voxtype/config.toml -q daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
