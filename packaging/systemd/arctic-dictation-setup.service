[Unit]
Description=Install Arctic's local dictation engine and multilingual model
ConditionPathExists=/var/lib/arctic/dictation/pending.json
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/python3 -I /usr/share/arctic/dictation/dictation.py --system-setup
Restart=on-failure
RestartSec=15min
TimeoutStartSec=12min
RuntimeMaxSec=12min
Nice=10
IOSchedulingClass=idle
UMask=0077
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
