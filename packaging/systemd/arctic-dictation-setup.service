[Unit]
Description=Install official VoxType and its multilingual model
# Do not pull NetworkManager-wait-online into login; the post-boot timer retries offline.
After=network-online.target

[Service]
Type=exec
ExecCondition=/usr/libexec/arctic/arctic-voxtype-setup --needs-resume
ExecStart=/usr/libexec/arctic/arctic-voxtype-setup --resume
TimeoutStartSec=12min
RuntimeMaxSec=12min
Nice=10
IOSchedulingClass=idle
UMask=0077
StandardOutput=null
StandardError=null
