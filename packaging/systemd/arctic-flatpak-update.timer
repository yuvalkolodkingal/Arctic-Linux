[Unit]
Description=Daily update of Flatpak apps (Arctic Linux)
Documentation=https://github.com/yuvalkolodkingal/Arctic-Linux/wiki/Updates
ConditionKernelCommandLine=!rd.live.image

[Timer]
# Some time after each boot (not at the same moment as the system update check), then once a
# day; a day missed while the computer was off is caught up at boot.
OnBootSec=20min
OnCalendar=daily
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
