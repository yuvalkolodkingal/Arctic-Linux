[Unit]
Description=Arctic Linux: install updates in the background
Documentation=https://github.com/yuvalkolodkingal/Arctic-Linux/wiki/Updates man:dnf5-offline(8)
# Never on the live USB: nothing there survives a restart.
ConditionKernelCommandLine=!rd.live.image
Wants=network-online.target
After=network-online.target

[Service]
# `arctic-update stage`: `dnf5 upgrade -y --refresh` into the running system (INSTALL=now, the
# default), or dnf5's offline transaction for the next start (INSTALL=restart). It skips
# metered connections (METERED= in /etc/arctic/update.conf) and does nothing with AUTO=off.
Type=oneshot
ExecStart=/usr/bin/arctic-update stage
# In the background, behind everything you do. Updates are installed while the desktop runs
# (INSTALL=now), and a transaction is heavy work: rpm's scriptlets, a new kernel's initramfs,
# a driver build. Nice=19 alone still shares the processors with the compositor, which shows
# as stuttering animations. CPUWeight=idle gives this unit, with everything dnf starts, only
# the processor time nothing else wants; the disk priority is the lowest too.
Nice=19
CPUWeight=idle
IOSchedulingClass=idle
# A slow mirror must not keep it running forever; the next check tries again.
TimeoutStartSec=3h
