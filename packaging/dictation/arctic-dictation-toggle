#!/bin/sh
# Activation guard only. Official VoxType owns recording and transcription;
# this helper exposes fixed setup guidance instead of its potentially sensitive stderr.
set -eu
notify_not_ready() {
    notify-send -a 'Arctic Dictation' -i dialog-warning 'Dictation is not ready' \
        'Open Settings → Dictation to finish setup or resolve the reported error.' >/dev/null 2>&1 || :
}
snapshot=$(arctic-dictation status 2>/dev/null || :)
case "$snapshot" in
    *'"state":"ready"'*|*'"state":"recording"'*) ;;
    *) notify_not_ready; exit 69 ;;
esac
if ! voxtype record toggle >/dev/null 2>&1; then
    notify_not_ready
    exit 69
fi
