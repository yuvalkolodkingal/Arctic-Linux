#!/bin/sh
# Select the conservative official-binary profile from the intersection of all
# logical CPU flags. The AVX2 asset is built for Haswell and needs more than AVX2.
set -eu
cpuinfo=/proc/cpuinfo
if [ "$#" = 2 ] && [ "$1" = --cpuinfo ]; then
    cpuinfo=$2
elif [ "$#" != 0 ]; then
    echo 'usage: arctic-voxtype-host-profile [--cpuinfo FILE]' >&2
    exit 2
fi
if awk '
BEGIN {
    split("avx avx2 fma f16c bmi1 bmi2 movbe popcnt xsave", required)
    processors = 0; flag_lines = 0; safe = 1
}
{
    key = $0; sub(/:.*/, "", key); gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
    if (key == "processor") processors++
    if (key == "flags") {
        flag_lines++
        values = $0; sub(/^[^:]*:[[:space:]]*/, "", values)
        delete present
        count = split(tolower(values), words, /[[:space:]]+/)
        for (i = 1; i <= count; i++) present[words[i]] = 1
        for (i in required) if (!present[required[i]]) safe = 0
        if (!present["abm"] && !present["lzcnt"]) safe = 0
    }
}
END { exit !(safe && processors > 0 && flag_lines == processors) }
' "$cpuinfo" 2>/dev/null; then
    printf '%s\n' turbo-q5-v3
else
    printf '%s\n' small-v2
fi
