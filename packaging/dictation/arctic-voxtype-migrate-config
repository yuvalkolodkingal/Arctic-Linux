#!/usr/bin/python3
"""Move an unmodified Arctic VoxType config to the resident-model default.

This runs as the desktop user before user sessions start.  It deliberately
recognizes only byte-exact configs emitted by the previous Arctic generator;
anything else is a custom config and is left byte-for-byte unchanged.
"""

import fcntl
import os
from pathlib import Path
import stat
import subprocess
import sys
import tempfile


MIGRATED = 0
ALREADY_CURRENT = 20
CUSTOM_PRESERVED = 21
MISSING_PRESERVED = 22
UNSAFE_PRESERVED = 23
CONCURRENT_RETRY = 24

MODELS = {
    "/opt/arctic/voxtype/models/ggml-small.bin",
    "/opt/arctic/voxtype/models/ggml-large-v3-turbo-q5_0.bin",
}
VALIDATORS = {
    "/opt/arctic/voxtype/1.1.1/voxtype-baseline",
    "/opt/arctic/voxtype/1.1.1/voxtype-avx2",
}
LANGUAGES = ('["he", "en"]', '"he"', '"en"')


def canonical(model: str, language: str, resident: bool) -> bytes:
    demand = "false" if resident else "true"
    return f'''# Managed safe defaults for Arctic's local-only VoxType integration.
engine = "whisper"
state_file = "auto"

[hotkey]
enabled = false

[audio]
device = "default"
sample_rate = 16000
max_duration_secs = 60
pause_media = false
duck_media = false

[whisper]
mode = "local"
model = "{model}"
language = {language}
translate = false
on_demand_loading = {demand}

[text]
filter_filler_words = false

[output]
mode = "type"
driver_order = ["wtype"]
fallback_to_clipboard = false
auto_submit = false
shift_enter_newlines = false
wait_for_modifier_release = false

[output.notification]
on_recording_start = false
on_recording_stop = false
on_transcription = false

[osd]
enabled = false
'''.encode()


def owned_directory(path: Path, *, private: bool = True) -> int:
    before = path.lstat()
    mode = stat.S_IMODE(before.st_mode)
    if (not stat.S_ISDIR(before.st_mode) or before.st_uid != os.getuid()
            or (mode != 0o700 if private else bool(mode & 0o022))):
        raise ValueError("unsafe directory")
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    after = os.fstat(fd)
    if (after.st_dev, after.st_ino) != (before.st_dev, before.st_ino):
        os.close(fd)
        raise ValueError("directory changed")
    return fd


def read_owned_config(path: Path) -> tuple[bytes, tuple[int, int, int, int]]:
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or stat.S_IMODE(info.st_mode) != 0o600):
            raise ValueError("unsafe config")
        chunks = []
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            chunks.append(chunk)
        return b"".join(chunks), (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns)
    finally:
        os.close(fd)


def main() -> int:
    if len(sys.argv) != 3 or os.geteuid() == 0:
        return 2 if len(sys.argv) != 3 else 77
    model, validator = sys.argv[1:]
    if model not in MODELS or validator not in VALIDATORS or not os.access(validator, os.X_OK):
        return 2
    home_raw = os.environ.get("HOME", "")
    if not home_raw.startswith("/"):
        return UNSAFE_PRESERVED
    home = Path(home_raw)
    directory = home / ".config" / "voxtype"
    config = directory / "config.toml"
    try:
        home_fd = owned_directory(home, private=False)
        os.close(home_fd)
        config_fd = owned_directory(home / ".config")
        os.close(config_fd)
        directory_fd = owned_directory(directory)
    except FileNotFoundError:
        return MISSING_PRESERVED
    except (OSError, ValueError):
        return UNSAFE_PRESERVED
    try:
        # The early-boot service means no Settings process or user daemon is
        # active. The lock also serializes two manually invoked retries; the
        # identity re-check below protects against an editor that ignores it.
        fcntl.flock(directory_fd, fcntl.LOCK_EX)
        try:
            original, identity = read_owned_config(config)
        except FileNotFoundError:
            return MISSING_PRESERVED
        except (OSError, ValueError):
            return UNSAFE_PRESERVED

        old = {canonical(model, language, False) for language in LANGUAGES}
        current = {canonical(model, language, True) for language in LANGUAGES}
        if original in current:
            return ALREADY_CURRENT
        if original not in old:
            return CUSTOM_PRESERVED
        replacement = original.replace(
            b"on_demand_loading = true\n", b"on_demand_loading = false\n", 1)

        temporary = None
        try:
            fd, temporary = tempfile.mkstemp(prefix=".config.toml.arctic-resident-v1.", dir=directory)
            with os.fdopen(fd, "wb") as stream:
                os.fchmod(stream.fileno(), 0o600)
                stream.write(replacement)
                stream.flush()
                os.fsync(stream.fileno())
            checked = subprocess.run(
                [validator, "--config", temporary, "config", "get",
                 "whisper.on_demand_loading", "--json"],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL, timeout=30, check=False,
            )
            if checked.returncode != 0:
                return UNSAFE_PRESERVED
            # A non-Arctic editor does not share the lock.  Re-read immediately
            # before rename and abandon the candidate if any byte or identity
            # changed while validation ran.
            try:
                latest, latest_identity = read_owned_config(config)
            except (FileNotFoundError, OSError, ValueError):
                return CONCURRENT_RETRY
            if latest != original or latest_identity != identity:
                return CONCURRENT_RETRY
            os.replace(temporary, config)
            temporary = None
            os.fsync(directory_fd)
            return MIGRATED
        finally:
            if temporary is not None:
                try:
                    os.unlink(temporary)
                except FileNotFoundError:
                    pass
    finally:
        os.close(directory_fd)


if __name__ == "__main__":
    raise SystemExit(main())
