#!/bin/sh
# Select a verified official VoxType binary. All runtime operations are handled
# by upstream; this launcher only keeps a verified 1.1.0 install usable while
# its signed 1.1.1 replacement is pending, then follows the atomic receipt.
set -eu
current_lib=/opt/arctic/voxtype/1.1.1
previous_lib=/opt/arctic/voxtype/1.1.0
lib=
backend=
receipt=/var/lib/arctic/dictation/verified.json
if [ -r /var/lib/arctic/dictation/backend ]; then
    IFS= read -r selected < /var/lib/arctic/dictation/backend || :
    case "$selected" in cpu|vulkan) backend=$selected ;; esac
fi
receipt_backend=
cpu_binary=
cpu_bytes=
runtime_version=
if [ -r /var/lib/arctic/dictation/upstream-direct-v1 ] && [ -r "$receipt" ] \
        && grep -Fq '"integration":"upstream-direct-v1"' "$receipt" \
        && grep -Fq '"version":"1.1.1"' "$receipt"; then
    runtime_version=1.1.1
    lib=$current_lib
    if grep -Fq '"backend":"cpu"' "$receipt" \
            && ! grep -Fq '"backend":"vulkan"' "$receipt" \
            && ! grep -Fq '"vulkan_binary"' "$receipt"; then
        receipt_backend=cpu
    elif grep -Fq '"backend":"vulkan"' "$receipt" \
            && ! grep -Fq '"backend":"cpu"' "$receipt" \
            && grep -Fq '"vulkan_binary":"voxtype-vulkan"' "$receipt" \
            && grep -Fq '"vulkan_binary_bytes":66575872' "$receipt" \
            && grep -Fq '"vulkan_binary_sha256":"102a7caa22facc5c257c526ae4a9e63c04c027297fec4ca370209a1f94ae9863"' "$receipt"; then
        receipt_backend=vulkan
    fi
    if grep -Fq '"profile":"small-v2"' "$receipt" \
            && ! grep -Fq '"profile":"turbo-q5-v3"' "$receipt" \
            && grep -Fq '"binary":"voxtype-baseline"' "$receipt" \
            && grep -Fq '"binary_bytes":18838904' "$receipt" \
            && grep -Fq '"binary_sha256":"cc051aac0870e21d7378edbcde3ceff10238af12a11650ab897d0ad9195225af"' "$receipt"; then
        cpu_binary=voxtype-baseline
        cpu_bytes=18838904
    elif grep -Fq '"profile":"turbo-q5-v3"' "$receipt" \
            && ! grep -Fq '"profile":"small-v2"' "$receipt" \
            && grep -Fq '"binary":"voxtype-avx2"' "$receipt" \
            && grep -Fq '"binary_bytes":19415936' "$receipt" \
            && grep -Fq '"binary_sha256":"3462262980e5a75391ffdeb7d3b63f9f638d6261df042f04f9119dfb7aab7770"' "$receipt"; then
        cpu_binary=voxtype-avx2
        cpu_bytes=19415936
    fi
elif [ -r /var/lib/arctic/dictation/upstream-direct-v1 ] && [ -r "$receipt" ] \
        && grep -Fq '"integration":"upstream-direct-v1"' "$receipt" \
        && grep -Fq '"version":"1.1.0"' "$receipt" \
        && grep -Fq '"source_commit":"e2638ca63f566f1682bcedc0abea8e4b25211c21"' "$receipt" \
        && grep -Fq '"release_signing_fingerprint":"9CCF7915B750CAE8B095ED1AA3FC9F33FD209279"' "$receipt"; then
    runtime_version=1.1.0
    lib=$previous_lib
    # The 1.1.1 setup stages CPU before publishing its receipt. Until that
    # atomic switch, the previous receipt remains the backend authority.
    if grep -Fq '"backend":"cpu"' "$receipt" \
            && ! grep -Fq '"backend":"vulkan"' "$receipt" \
            && ! grep -Fq '"vulkan_binary"' "$receipt"; then
        receipt_backend=cpu
    elif grep -Fq '"backend":"vulkan"' "$receipt" \
            && ! grep -Fq '"backend":"cpu"' "$receipt" \
            && grep -Fq '"vulkan_binary":"voxtype-vulkan"' "$receipt" \
            && grep -Fq '"vulkan_binary_bytes":66342968' "$receipt" \
            && grep -Fq '"vulkan_binary_sha256":"db2c7938392ff08ec8b50b8afb90f8bd3d0111eccf5943df2f51c40a0368fec2"' "$receipt"; then
        receipt_backend=vulkan
    fi
    backend=$receipt_backend
    if grep -Fq '"profile":"small-v2"' "$receipt" \
            && ! grep -Fq '"profile":"turbo-q5-v3"' "$receipt" \
            && grep -Fq '"binary":"voxtype-baseline"' "$receipt" \
            && grep -Fq '"binary_bytes":18579224' "$receipt" \
            && grep -Fq '"binary_sha256":"1c9d78b4f6805e4f12ba3670949d3c22788269bdbc54215afffa42cafd0b4a7a"' "$receipt"; then
        cpu_binary=voxtype-baseline
        cpu_bytes=18579224
    elif grep -Fq '"profile":"turbo-q5-v3"' "$receipt" \
            && ! grep -Fq '"profile":"small-v2"' "$receipt" \
            && grep -Fq '"binary":"voxtype-avx2"' "$receipt" \
            && grep -Fq '"binary_bytes":19153728' "$receipt" \
            && grep -Fq '"binary_sha256":"e7d5de68cc8fc610c3c961c47f879451db9bee4a2df152e9a66f1078072e7f28"' "$receipt"; then
        cpu_binary=voxtype-avx2
        cpu_bytes=19153728
    fi
fi
if [ -z "$runtime_version" ] || [ -z "$receipt_backend" ] || [ -z "$cpu_binary" ] \
        || [ "$backend" != "$receipt_backend" ]; then
    echo "VoxType backend state is incomplete. Open Settings -> Dictation and select CPU or Vulkan again." >&2
    exit 69
fi
if [ "$cpu_binary" = voxtype-avx2 ] \
        && [ "$(/usr/libexec/arctic/arctic-voxtype-host-profile)" != turbo-q5-v3 ]; then
    echo "VoxType's verified AVX2 profile is unsafe on this CPU. Open Settings -> Dictation and retry setup." >&2
    exit 69
fi
if [ "$backend" = vulkan ] && [ -x "$lib/voxtype-vulkan" ] \
        && { [ "$runtime_version" = 1.1.1 ] && [ "$(stat -c %s "$lib/voxtype-vulkan" 2>/dev/null || true)" = 66575872 ] \
             || [ "$runtime_version" = 1.1.0 ] && [ "$(stat -c %s "$lib/voxtype-vulkan" 2>/dev/null || true)" = 66342968 ]; }; then
    exec "$lib/voxtype-vulkan" "$@"
fi
if [ "$backend" = cpu ] && [ -x "$lib/$cpu_binary" ] \
        && [ "$(stat -c %s "$lib/$cpu_binary" 2>/dev/null || true)" = "$cpu_bytes" ]; then
    exec "$lib/$cpu_binary" "$@"
fi
echo "VoxType is not ready. Open Settings -> Dictation to finish setup." >&2
exit 69
