cleanup() { [ -z "$cleanup_tmp" ] || rm -rf -- "$cleanup_tmp"; }
prepare_state_dir() {
    [[ ! -L $STATE ]] || return 1
    install -d -m 0755 -o root -g root "$STATE"
    [[ -d $STATE && ! -L $STATE && $(stat -c %u:%a "$STATE") == 0:755 ]]
    # Publish a newly created state path through the stable /var/lib anchor
    # before any queue, receipt or error file is written beneath it.
    durable_sync_tree "$STATE" "$STATE_ROOT"
}
durable_atomic_text() {
    python3 - "$1" "$2" "$3" <<'PY'
import os, stat, sys, tempfile
path, raw_mode, value = sys.argv[1:]
parent = os.path.dirname(path)
info = os.lstat(parent)
if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
    raise SystemExit(1)
fd, temporary = tempfile.mkstemp(prefix='.' + os.path.basename(path) + '.', dir=parent)
try:
    with os.fdopen(fd, 'wb') as stream:
        os.fchmod(stream.fileno(), int(raw_mode, 8))
        stream.write(value.encode('utf-8') + b'\n')
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, path)
    directory = os.open(parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
except BaseException:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
    raise
PY
}
durable_sync_file() {
    python3 - "$1" <<'PY'
import os, stat, sys
path = sys.argv[1]
fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
try:
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0:
        raise SystemExit(1)
    os.fsync(fd)
finally:
    os.close(fd)
parent = os.open(os.path.dirname(path), os.O_RDONLY | os.O_DIRECTORY)
try:
    os.fsync(parent)
finally:
    os.close(parent)
PY
}
durable_sync_dir() {
    python3 - "$1" <<'PY'
import os, sys
fd = os.open(sys.argv[1], os.O_RDONLY | os.O_DIRECTORY)
try:
    os.fsync(fd)
finally:
    os.close(fd)
PY
}
durable_sync_tree() {
    python3 - "$1" "$2" <<'PY'
import os, stat, sys
path, anchor = map(os.path.abspath, sys.argv[1:])
if os.path.commonpath((path, anchor)) != anchor or path == anchor:
    raise SystemExit(1)
directories = []
current = path
while True:
    directories.append(current)
    if current == anchor:
        break
    current = os.path.dirname(current)
for directory in directories:
    before = os.lstat(directory)
    if not stat.S_ISDIR(before.st_mode) or before.st_uid != 0 or before.st_mode & 0o022:
        raise SystemExit(1)
    fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        info = os.fstat(fd)
        if ((info.st_dev, info.st_ino) != (before.st_dev, before.st_ino)
                or not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022):
            raise SystemExit(1)
        os.fsync(fd)
    finally:
        os.close(fd)
PY
}
prepare_storage_dir() {
    [[ ! -L $1 ]] || return 1
    install -d -m 0755 -o root -g root "$1"
    [[ -d $1 && ! -L $1 && $(stat -c %u:%a "$1") == 0:755 ]]
    durable_sync_tree "$1" "$STORAGE_ROOT"
}
durable_remove() {
    rm -f -- "$@"
    durable_sync_dir "$STATE"
}
fail() {
    trap - ERR
    prepare_state_dir
    durable_atomic_text "$STATE/setup.state" 0644 failed
    durable_atomic_text "$STATE/setup.error" 0644 setup
    printf '%s\n' 'VoxType setup did not finish. Check the connection and retry in Settings.' >&2
    exit 1
}
backend_fail() {
    trap - ERR
    prepare_state_dir
    durable_atomic_text "$STATE/setup.error" 0644 backend-vulkan
    printf '%s\n' 'Vulkan could not initialize the verified local model. CPU remains selected.' >&2
    exit 1
}
trap cleanup EXIT
trap fail ERR
usage() {
    echo 'usage: arctic-voxtype-setup --install USER [--offline] | --migrate-legacy USER | --resume | --retry | --backend cpu|vulkan | --disclosure' >&2
    exit 2
}
acquire_setup_lock() {
    local lockdir=/run/lock/arctic-voxtype-setup
    # Lock the dedicated root-only directory itself, avoiding a writable lock
    # file or symlink target. A short bounded wait keeps concurrent UI retries
    # responsive while the first installer/timer operation continues intact.
    if [[ -L $lockdir ]]; then
        printf '%s\n' 'VoxType setup is already running or its lock is unsafe. Try again shortly.' >&2
        exit 75
    fi
    install -d -m 0700 -o root -g root "$lockdir"
    [[ ! -L $lockdir && -d $lockdir && $(stat -c %u:%a "$lockdir") == 0:700 ]] || {
        printf '%s\n' 'VoxType setup is already running or its lock is unsafe. Try again shortly.' >&2
        exit 75
    }
    exec 9<"$lockdir"
    flock --exclusive --timeout 10 9 || {
        printf '%s\n' 'VoxType setup is already running. Try again shortly.' >&2
        exit 75
    }
}
valid_user() { [[ "$1" =~ ^[a-z_][a-z0-9_-]*$ ]] && getent passwd "$1" >/dev/null; }
user_from_uid() {
    local uid=${PKEXEC_UID:-}
    [[ "$uid" =~ ^[0-9]+$ ]] || return 1
    getent passwd "$uid" | cut -d: -f1
}
queue_user() {
    prepare_state_dir
    durable_atomic_text "$STATE/user" 0600 "$1"
    # Pending is durable before setup starts. Until the direct marker is also
    # durable, a crash therefore leaves both a retry and every legacy byte.
    durable_atomic_text "$STATE/pending" 0644 "$VERSION"
    durable_atomic_text "$STATE/setup.state" 0644 queued
}
read_queued_user() {
    local user=
    [[ -r "$STATE/user" ]] || return 1
    IFS= read -r user <"$STATE/user"
    valid_user "$user" || return 1
    printf '%s\n' "$user"
}
verify_file() {
    [[ $(stat -c %s "$1") = "$2" ]]
    printf '%s  %s\n' "$3" "$1" | sha256sum --check --status
}
trusted_exact_file() {
    local path=$1 mode=$2 bytes=$3 sha=$4
    [[ -f $path && ! -L $path && $(stat -c %u:%a "$path") == "0:$mode" ]] || return 1
    verify_file "$path" "$bytes" "$sha"
}
download_pinned() {
    local url=$1 dest=$2 bytes=$3 sha=$4 part="$2.part" rc=0
    mkdir -p "$(dirname "$dest")"
    if [ -f "$dest" ] && verify_file "$dest" "$bytes" "$sha"; then return; fi
    # A complete but invalid partial cannot be resumed: curl would start at EOF
    # and repeatedly receive 416. Discard it before the retryable transfer.
    if [ -f "$part" ] && [ "$(stat -c %s "$part")" -ge "$bytes" ]; then rm -f -- "$part"; fi
    curl --fail --location --retry 3 --retry-delay 2 --connect-timeout 20 \
        --speed-limit 1024 --speed-time 60 --continue-at - --output "$part" "$url" || rc=$?
    if [ "$rc" != 0 ]; then
        # A mirror may not support ranges. Preserve valid partials on ordinary
        # network failures; restart only when curl reports range rejection.
        [ "$rc" = 33 ] || return "$rc"
        rm -f -- "$part"
        curl --fail --location --retry 3 --retry-delay 2 --connect-timeout 20 \
            --speed-limit 1024 --speed-time 60 --output "$part" "$url"
    fi
    verify_file "$part" "$bytes" "$sha"
    mv -f -- "$part" "$dest"
}
verify_signature() {
    local status
    status=$(gpgv --status-fd 1 --keyring "$3" "$1" "$2" 2>/dev/null)
    grep -Fq "[GNUPG:] VALIDSIG $FINGERPRINT " <<<"$status"
}
prepare_keyring() {
    local shown
    shown=$(gpg --batch --show-keys --with-colons "$KEY" | awk -F: '$1=="fpr" {print $10; exit}')
    [[ "$shown" = "$FINGERPRINT" ]]
    gpg --batch --yes --dearmor --output "$1" "$KEY"
}
asset_values() {
    case "$1" in
        baseline) printf '%s\n%s\n%s\n%s\n' "$BASELINE_BYTES" "$BASELINE_SHA" "$BASELINE_SIG_BYTES" "$BASELINE_SIG_SHA" ;;
        avx2) printf '%s\n%s\n%s\n%s\n' "$AVX2_BYTES" "$AVX2_SHA" "$AVX2_SIG_BYTES" "$AVX2_SIG_SHA" ;;
        vulkan) printf '%s\n%s\n%s\n%s\n' "$VULKAN_BYTES" "$VULKAN_SHA" "$VULKAN_SIG_BYTES" "$VULKAN_SIG_SHA" ;;
        *) return 1 ;;
    esac
}
install_asset() {
    local variant=$1 tmp=$2 keyring=$3 name bytes sha sig_bytes sig_sha target legacy=
    local -a values
    name="voxtype-$VERSION-linux-x86_64-$variant"
    mapfile -t values < <(asset_values "$variant")
    bytes=${values[0]}; sha=${values[1]}; sig_bytes=${values[2]}; sig_sha=${values[3]}
    grep -Fq "$sha  $name" "$tmp/SHA256SUMS.txt"
    target="$DEST/voxtype-$variant"
    case "$variant" in baseline) legacy="$DEST/voxtype-cpu" ;; avx2) legacy="$DEST/voxtype-cpu-avx2" ;; esac
    if trusted_exact_file "$target" 755 "$bytes" "$sha"; then return; fi
    if [[ -n $legacy ]] && trusted_exact_file "$legacy" 755 "$bytes" "$sha"; then
        cp --reflink=auto -- "$legacy" "$target.new"
        chmod 0755 "$target.new"; verify_file "$target.new" "$bytes" "$sha"
        mv -f "$target.new" "$target"
        return
    fi
    download_pinned "$RELEASE/$name" "$CACHE/$name" "$bytes" "$sha"
    download_pinned "$RELEASE/$name.asc" "$CACHE/$name.asc" "$sig_bytes" "$sig_sha"
    verify_signature "$CACHE/$name.asc" "$CACHE/$name" "$keyring"
    install -D -m 0755 "$CACHE/$name" "$target.new"
    mv -f "$target.new" "$target"
}
prepare_release_metadata() {
    prepare_keyring "$2"
    download_pinned "$RELEASE/SHA256SUMS.txt" "$CACHE/SHA256SUMS.txt" "$SUMS_BYTES" "$SUMS_SHA"
    download_pinned "$RELEASE/SHA256SUMS.txt.asc" "$CACHE/SHA256SUMS.txt.asc" "$SUMS_SIG_BYTES" "$SUMS_SIG_SHA"
    cp "$CACHE/SHA256SUMS.txt" "$1/SHA256SUMS.txt"
    cp "$CACHE/SHA256SUMS.txt.asc" "$1/SHA256SUMS.txt.asc"
    verify_file "$1/SHA256SUMS.txt" "$SUMS_BYTES" "$SUMS_SHA"
    verify_file "$1/SHA256SUMS.txt.asc" "$SUMS_SIG_BYTES" "$SUMS_SIG_SHA"
    verify_signature "$1/SHA256SUMS.txt.asc" "$1/SHA256SUMS.txt" "$2"
}
legacy_binary_path() {
    case "$1" in
        baseline) printf '%s\n' "$DEST/voxtype-cpu" ;;
        avx2) printf '%s\n' "$DEST/voxtype-cpu-avx2" ;;
        *) return 1 ;;
    esac
}
legacy_profile() {
    local host_profile=$1
    python3 - "$STATE" "$DEST" "$host_profile" <<'PY'
import json, os, re, stat, sys

state, payload, host_profile = sys.argv[1:]
profiles = {
    'small-v2': {
        'profile_sha256': 'd4b9326169fe0773b36857ce4b2c52d31294c4c421933c5fbb41422227e92756',
