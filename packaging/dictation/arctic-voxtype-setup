def root_json(path):
    try:
        info = os.lstat(path)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o644 or not 0 < info.st_size <= 65536:
            return None, True
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            current = os.fstat(fd)
            if (current.st_dev, current.st_ino, current.st_size) != (info.st_dev, info.st_ino, info.st_size):
                return None, True
            raw = os.read(fd, info.st_size + 1)
        finally:
            os.close(fd)
        if len(raw) != info.st_size:
            return None, True
        def unique(pairs):
            value = {}
            for key, item in pairs:
                if key in value:
                    raise ValueError
                value[key] = item
            return value
        value = json.loads(raw, object_pairs_hook=unique)
        return (value if type(value) is dict else None), True
    except FileNotFoundError:
        return None, False
    except (OSError, UnicodeError, ValueError, RecursionError):
        return None, True

def safe_for_host(profile):
    return profile == 'small-v2' or host_profile == 'turbo-q5-v3'

receipt, receipt_exists = root_json(os.path.join(state, 'verified.json'))
if receipt_exists:
    if receipt is None:
        raise SystemExit(1)
    profile = receipt.get('profile')
    expected = profiles.get(profile)
    if expected is None or not safe_for_host(profile):
        raise SystemExit(1)
    legacy_keys = {'version', 'source_commit', 'profile_sha256', 'profile', 'model',
                   'cpu_variant', 'model_download_bytes', 'download_bytes', 'files'}
    direct_keys = {'integration', 'version', 'source_commit', 'release_signing_fingerprint',
                   'user', 'profile', 'binary', 'binary_bytes', 'binary_sha256',
                   'model_path', 'model', 'model_bytes', 'model_sha256', 'backend'}
    if set(receipt) == legacy_keys:
        fixed = {key: expected[key] for key in ('profile_sha256', 'model', 'cpu_variant',
                                                'model_download_bytes', 'download_bytes')}
        fixed.update(version='1.1.0', source_commit='e2638ca63f566f1682bcedc0abea8e4b25211c21', profile=profile)
        if any(receipt.get(key) != value for key, value in fixed.items()):
            raise SystemExit(1)
        files = receipt.get('files')
        if type(files) is not dict or set(files) != set(expected['files']):
            raise SystemExit(1)
        for key, (name, size, digest, mode) in expected['files'].items():
            path = os.path.join(payload, name)
            try:
                info = os.lstat(path)
            except OSError:
                raise SystemExit(1) from None
            recorded = files.get(key)
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) != mode
                    or info.st_size != size or type(recorded) is not dict
                    or set(recorded) != {'sha256', 'size', 'mtime_ns'}
                    or recorded != {'sha256': digest, 'size': size, 'mtime_ns': info.st_mtime_ns}):
                raise SystemExit(1)
    elif set(receipt) == direct_keys:
        cpu = expected['cpu_variant']
        binary_size = 18579224 if cpu == 'baseline' else 19153728
        binary_sha = ('1c9d78b4f6805e4f12ba3670949d3c22788269bdbc54215afffa42cafd0b4a7a'
                      if cpu == 'baseline' else 'e7d5de68cc8fc610c3c961c47f879451db9bee4a2df152e9a66f1078072e7f28')
        model_name = 'ggml-' + expected['model'] + '.bin'
        model_size = expected['model_download_bytes']
        model_sha = expected['files']['model'][2]
        fixed = dict(integration='upstream-direct-v1', version='1.1.0',
                     source_commit='e2638ca63f566f1682bcedc0abea8e4b25211c21',
                     release_signing_fingerprint='9CCF7915B750CAE8B095ED1AA3FC9F33FD209279',
                     profile=profile, binary='voxtype-' + cpu, binary_bytes=binary_size,
                     binary_sha256=binary_sha, model_path='/opt/arctic/voxtype/models/' + model_name,
                     model=expected['model'] + '.bin', model_bytes=model_size,
                     model_sha256=model_sha, backend='cpu')
        if any(receipt.get(key) != value for key, value in fixed.items()):
            raise SystemExit(1)
        user = receipt.get('user')
        if type(user) is not str or re.fullmatch(r'[a-z_][a-z0-9_-]{0,31}', user) is None:
            raise SystemExit(1)
    else:
        raise SystemExit(1)
    print(profile)
    raise SystemExit(0)

selection, selection_exists = root_json(os.path.join(state, 'profile-selection.json'))
if selection_exists:
    if selection is None or set(selection) != {'selection'} or selection.get('selection') not in ('compatibility', 'recommended'):
        raise SystemExit(1)
    print('small-v2' if selection['selection'] == 'compatibility' else host_profile)
    raise SystemExit(0)
raise SystemExit(2)
PY
}
quarantine_invalid_legacy_state() {
    python3 - "$STATE" <<'PY'
import os, stat, sys
state = sys.argv[1]
sources = []
for name in ('verified.json', 'profile-selection.json'):
    path = os.path.join(state, name)
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        continue
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o644:
        raise SystemExit(1)
    sources.append(path)
if not sources:
    raise SystemExit(1)
for path in sources:
    target = path + '.rejected-upstream-direct-v1'
    os.replace(path, target)
directory = os.open(state, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    os.fsync(directory)
finally:
    os.close(directory)
PY
}
legacy_payload_usable() {
    local variant=$1 model_name=$2 model_bytes=$3 model_sha=$4 binary_bytes binary_sha
    local binary
    local -a values
    mapfile -t values < <(asset_values "$variant")
    binary_bytes=${values[0]}; binary_sha=${values[1]}
    binary=$(legacy_binary_path "$variant")
    if ! trusted_exact_file "$DEST/voxtype-$variant" 755 "$binary_bytes" "$binary_sha"; then
        trusted_exact_file "$binary" 755 "$binary_bytes" "$binary_sha" || return 1
    fi
    if ! trusted_exact_file "$MODELS/$model_name" 644 "$model_bytes" "$model_sha"; then
        trusted_exact_file "$DEST/$model_name" 644 "$model_bytes" "$model_sha" || return 1
    fi
}
prepare_packaged_release_metadata() {
    local tmp=$1 keyring=$2 variant=$3 source name bytes sha sig_bytes sig_sha
    local -a values
    name="voxtype-$VERSION-linux-x86_64-$variant"
    mapfile -t values < <(asset_values "$variant")
    bytes=${values[0]}; sha=${values[1]}; sig_bytes=${values[2]}; sig_sha=${values[3]}
    prepare_keyring "$keyring"
    verify_file "$PROVENANCE/SHA256SUMS.txt" "$SUMS_BYTES" "$SUMS_SHA"
    verify_file "$PROVENANCE/SHA256SUMS.txt.asc" "$SUMS_SIG_BYTES" "$SUMS_SIG_SHA"
    verify_signature "$PROVENANCE/SHA256SUMS.txt.asc" "$PROVENANCE/SHA256SUMS.txt" "$keyring"
    grep -Fxq "$sha  $name" "$PROVENANCE/SHA256SUMS.txt"
    verify_file "$PROVENANCE/$name.asc" "$sig_bytes" "$sig_sha"
    source="$DEST/voxtype-$variant"
    trusted_exact_file "$source" 755 "$bytes" "$sha" || source=$(legacy_binary_path "$variant")
    trusted_exact_file "$source" 755 "$bytes" "$sha"
    verify_signature "$PROVENANCE/$name.asc" "$source" "$keyring"
    cp -- "$PROVENANCE/SHA256SUMS.txt" "$tmp/SHA256SUMS.txt"
    cp -- "$PROVENANCE/SHA256SUMS.txt.asc" "$tmp/SHA256SUMS.txt.asc"
}
as_user() {
    local user=$1 home=$2
    shift 2
    runuser -u "$user" -- env HOME="$home" XDG_CONFIG_HOME="$home/.config" XDG_DATA_HOME="$home/.local/share" "$@"
}
configure_user() {
    local user=$1 home=$2 model=$3
    as_user "$user" "$home" /usr/libexec/arctic/arctic-voxtype-configure "$model"
}

reuse_legacy_model() {
    local name=$1 bytes=$2 sha=$3 source="$DEST/$1" target="$MODELS/$1"
    trusted_exact_file "$target" 644 "$bytes" "$sha" && return 0
    trusted_exact_file "$source" 644 "$bytes" "$sha" || return 1
    prepare_storage_dir "$MODELS"
    cp --reflink=auto -- "$source" "$target.new"
    chmod 0644 "$target.new"; verify_file "$target.new" "$bytes" "$sha"
    mv -f "$target.new" "$target"
}

cleanup_legacy_payload() {
    # Keep the old controller payload usable until the direct receipt and marker
    # are both durable. Exact compatible bytes were copied/reflinked above.
    [[ -f $STATE/verified.json && ! -L $STATE/verified.json && $(stat -c %u:%a "$STATE/verified.json") == 0:644 ]] || return
    trusted_exact_file "$STATE/upstream-direct-v1" 644 19 f488e43c61459fd06e37fe8d5590ed9bc844806f1e703fba8a2de65dd945e8d8 || return
    rm -f -- "$DEST/voxtype-cpu" "$DEST/voxtype-cpu-avx2" "$DEST/voxtype-vulkan" \
        "$DEST/$SMALL_NAME" "$DEST/$TURBO_NAME"
    durable_sync_dir "$DEST"
}

setup_user() {
    local user=$1 mode=${2:-online} home tmp keyring host_profile selected_profile profile_status legacy_state=valid cpu profile model_name model_bytes model_sha model_url model_path binary_bytes binary_sha packaged=0 receipt_json uid
    home=$(getent passwd "$user" | cut -d: -f6); [[ -n "$home" && "$home" = /* ]]
    durable_atomic_text "$STATE/setup.state" 0644 downloading
    tmp=$(mktemp -d /var/tmp/arctic-voxtype.XXXXXX); cleanup_tmp=$tmp; keyring="$tmp/release-key.gpg"
    host_profile=$(/usr/libexec/arctic/arctic-voxtype-host-profile)
    if selected_profile=$(legacy_profile "$host_profile"); then
        :
    else
        profile_status=$?
        if [[ $profile_status == 2 ]]; then
            # A fresh install has no legacy state and follows the host profile.
            # The migration-only entry point must never infer a legacy choice.
            [[ $mode != legacy-only ]] || return 1
            legacy_state=absent
        else
            # The synchronous RPM migration stays fail closed and leaves every
            # old byte. Its later online resume may quarantine structurally
            # trusted but invalid state and perform the ordinary signed repair.
            [[ $mode != legacy-only ]] || return 1
            quarantine_invalid_legacy_state
            legacy_state=quarantined
        fi
        selected_profile=$host_profile
    fi
    if [[ $selected_profile == turbo-q5-v3 ]]; then
        cpu=avx2; profile=turbo-q5-v3; model_name=$TURBO_NAME; model_bytes=$TURBO_BYTES; model_sha=$TURBO_SHA; model_url=$TURBO_URL
        binary_bytes=$AVX2_BYTES; binary_sha=$AVX2_SHA
    elif [[ $selected_profile == small-v2 ]]; then
        cpu=baseline; profile=small-v2; model_name=$SMALL_NAME; model_bytes=$SMALL_BYTES; model_sha=$SMALL_SHA; model_url=$SMALL_URL
        binary_bytes=$BASELINE_BYTES; binary_sha=$BASELINE_SHA
    else
        return 1
    fi
    if [[ $legacy_state == valid ]] && legacy_payload_usable "$cpu" "$model_name" "$model_bytes" "$model_sha"; then
        packaged=1
    fi
    if [[ $packaged == 1 ]]; then
        # An update from Arctic's former controller already has these exact
        # upstream bytes. Authenticate the binary with provenance shipped in
        # the signed RPM and complete the direct migration without a network.
        prepare_packaged_release_metadata "$tmp" "$keyring" "$cpu"
    else
        [[ $mode != legacy-only ]] || return 1
        prepare_release_metadata "$tmp" "$keyring"
    fi
    prepare_storage_dir "$DEST"
    prepare_storage_dir "$MODELS"
    install_asset "$cpu" "$tmp" "$keyring"
    model_path="$MODELS/$model_name"
    if ! reuse_legacy_model "$model_name" "$model_bytes" "$model_sha"; then
        download_pinned "$model_url" "$CACHE/$model_name" "$model_bytes" "$model_sha"
        install -D -m 0644 "$CACHE/$model_name" "$model_path.new"
        mv -f "$model_path.new" "$model_path"
    fi
    # Persist the direct payload before a receipt can attest it. Both calls also
    # fsync the containing directories so a power loss cannot retain a receipt
    # while losing the renamed binary or model.
    durable_sync_file "$DEST/voxtype-$cpu"
    durable_sync_file "$model_path"
    durable_sync_tree "$DEST" "$STORAGE_ROOT"
    durable_sync_tree "$MODELS" "$STORAGE_ROOT"
    configure_user "$user" "$home" "$model_path"
    systemctl --global enable voxtype.service >/dev/null
    uid=$(id -u "$user")
    durable_atomic_text "$STATE/backend" 0644 cpu
    printf -v receipt_json '{"integration":"upstream-direct-v1","version":"%s","source_commit":"%s","release_signing_fingerprint":"%s","user":"%s","profile":"%s","binary":"voxtype-%s","binary_bytes":%s,"binary_sha256":"%s","model_path":"%s","model":"%s","model_bytes":%s,"model_sha256":"%s","backend":"cpu"}' \
        "$VERSION" "$SOURCE_COMMIT" "$FINGERPRINT" "$user" "$profile" "$cpu" "$binary_bytes" "$binary_sha" "$model_path" "${model_name#ggml-}" "$model_bytes" "$model_sha"
    durable_atomic_text "$STATE/verified.json" 0644 "$receipt_json"
    # This is the commit point. Pending remains durable until after this marker
    # and its directory entry are fsynced; cleanup is forbidden before it.
    durable_atomic_text "$STATE/upstream-direct-v1" 0644 upstream-direct-v1
    # The durable marker commits direct integration. No later housekeeping or
    # current-session activation failure may run the pre-commit error handler.
    trap - ERR
    cleanup_legacy_payload || :
    durable_remove "$STATE/pending" "$STATE/setup.error" || :
    durable_atomic_text "$STATE/setup.state" 0644 ready || :
    if [ -S "/run/user/$uid/bus" ]; then
        runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            systemctl --user daemon-reload >/dev/null 2>&1 || :
        runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            systemctl --user enable --now voxtype.service >/dev/null 2>&1 || :
    fi
    return 0
}
update_receipt_backend() {
    python3 - "$STATE/verified.json" "$1" <<'PY'
import json, os, sys, tempfile
path, backend = sys.argv[1:]
with open(path, encoding='utf-8') as src:
    data = json.load(src)
data['backend'] = backend
fd, tmp = tempfile.mkstemp(prefix='verified.json.', dir=os.path.dirname(path))
with os.fdopen(fd, 'w', encoding='utf-8') as out:
    json.dump(data, out, separators=(',', ':')); out.write('\n')
os.chmod(tmp, 0o644); os.replace(tmp, path)
PY
}
set_backend() {
    local backend=$1 user tmp keyring uid home config fixture receipt
    trap backend_fail ERR
    user=$(user_from_uid) || usage; valid_user "$user" || usage; [[ -r "$STATE/verified.json" ]] || fail
    case "$backend" in
        cpu)
            printf '%s\n' cpu | install -m 0644 /dev/stdin "$STATE/backend"
            update_receipt_backend cpu
            rm -f "$STATE/setup.error"
            ;;
        vulkan)
            # Selection remains CPU until both the driver probe and real local
            # model initialization through the official Vulkan binary pass.
            printf '%s\n' cpu | install -m 0644 /dev/stdin "$STATE/backend"
            update_receipt_backend cpu
            tmp=$(mktemp -d /var/tmp/arctic-voxtype.XXXXXX); cleanup_tmp=$tmp; keyring="$tmp/release-key.gpg"
            prepare_release_metadata "$tmp" "$keyring"; install_asset vulkan "$tmp" "$keyring"
            command -v vulkaninfo >/dev/null
            uid=$(id -u "$user"); home=$(getent passwd "$user" | cut -d: -f6)
            runuser -u "$user" -- env HOME="$home" vulkaninfo --summary >/dev/null
            config="$home/.config/voxtype/config.toml"; fixture="$tmp/silence.wav"
            python3 - "$fixture" <<'PY'
import struct, sys, wave
with wave.open(sys.argv[1], 'wb') as out:
    out.setnchannels(1); out.setsampwidth(2); out.setframerate(16000)
    out.writeframes(struct.pack('<16000h', *([0] * 16000)))
PY
            runuser -u "$user" -- env HOME="$home" XDG_CONFIG_HOME="$home/.config" RUST_LOG=error \
                timeout 120 "$DEST/voxtype-vulkan" -q --config "$config" transcribe "$fixture" >/dev/null 2>&1
            printf '%s\n' vulkan | install -m 0644 /dev/stdin "$STATE/backend"
            receipt="$STATE/verified.json"
            python3 - "$receipt" "$VULKAN_BYTES" "$VULKAN_SHA" <<'PY'
import json, os, sys, tempfile
path, size, sha = sys.argv[1:]
with open(path, encoding='utf-8') as src:
    data = json.load(src)
data.update(backend='vulkan', vulkan_binary='voxtype-vulkan', vulkan_binary_bytes=int(size), vulkan_binary_sha256=sha)
fd, tmp = tempfile.mkstemp(prefix='verified.json.', dir=os.path.dirname(path))
with os.fdopen(fd, 'w', encoding='utf-8') as out:
    json.dump(data, out, separators=(',', ':')); out.write('\n')
os.chmod(tmp, 0o644); os.replace(tmp, path)
PY
            rm -f "$STATE/setup.error"
            ;;
        *) usage ;;
    esac
}
if [[ ${1:-} == --disclosure ]]; then
    [[ $# = 1 ]] || usage
    printf 'VoxType %s: compatibility CPU %s bytes; modern CPU %s bytes; optional Vulkan %s additional bytes.\n' \
        "$VERSION" "$((BASELINE_BYTES + SMALL_BYTES))" "$((AVX2_BYTES + TURBO_BYTES))" "$VULKAN_BYTES"
    exit 0
fi
[[ $EUID -eq 0 ]] || usage
acquire_setup_lock
case ${1:-} in
    --install)
        [[ $# = 2 || $# = 3 ]] || usage; valid_user "$2" || usage; queue_user "$2"
        if [[ ${3:-} = --offline ]]; then exit 0; fi
        [[ $# = 2 ]] || usage; setup_user "$2" ;;
    --migrate-legacy)
        [[ $# = 2 ]] || usage; valid_user "$2" || usage; queue_user "$2"
        setup_user "$2" legacy-only ;;
    --resume) [[ $# = 1 ]] || usage; setup_user "$(read_queued_user)" ;;
    --retry)
        [[ $# = 1 ]] || usage; retry_user=$(user_from_uid) || retry_user=$(read_queued_user)
        valid_user "$retry_user" || usage; queue_user "$retry_user"; setup_user "$retry_user" ;;
    --backend) [[ $# = 2 ]] || usage; set_backend "$2" ;;
    *) usage ;;
esac
