#!/bin/sh
# Arctic setup/readiness adapter. Recording and transcription commands are
# intentionally absent: Mango and the shell invoke official VoxType directly.
set -eu
private_runtime() {
    uid=$(id -u)
    base=${XDG_RUNTIME_DIR:-/run/user/$uid}
    if [ -z "$base" ] || [ ! -d "$base" ] || [ -L "$base" ] || [ "$(stat -c %u:%a "$base" 2>/dev/null || true)" != "$uid:700" ]; then
        runtime=/tmp/arctic-dictation-$uid
        legacy=/tmp/arctic-$uid
    else
        runtime=$base/arctic-dictation
        legacy=$base/arctic
    fi
    if [ ! -e "$runtime" ] && [ ! -L "$runtime" ]; then mkdir -m 0700 "$runtime" 2>/dev/null || return 1; fi
    [ ! -L "$runtime" ] && [ -d "$runtime" ] \
        && [ "$(stat -c %u:%a "$runtime" 2>/dev/null || true)" = "$uid:700" ] || return 1
    # Preserve the lazy-start marker across an update from the former shared
    # Arctic directory. Remove only known, type-checked transient state; the
    # per-login runtime base clears any remaining legacy lock automatically.
    if [ ! -L "$legacy" ] && [ -d "$legacy" ] \
            && [ "$(stat -c %u "$legacy" 2>/dev/null || true)" = "$uid" ]; then
        old_session=$legacy/voxtype-session-started-v1
        new_session=$runtime/voxtype-session-started-v1
        if [ ! -L "$old_session" ] && [ -d "$old_session" ] \
                && [ "$(stat -c %u:%a "$old_session" 2>/dev/null || true)" = "$uid:700" ]; then
            if [ ! -e "$new_session" ] && [ ! -L "$new_session" ]; then
                mkdir -m 0700 "$new_session" 2>/dev/null || return 1
            fi
            [ ! -L "$new_session" ] && [ -d "$new_session" ] \
                && [ "$(stat -c %u:%a "$new_session" 2>/dev/null || true)" = "$uid:700" ] || return 1
            rmdir "$old_session" 2>/dev/null || :
        fi
        old_starting=$legacy/voxtype-starting
        if [ ! -L "$old_starting" ] && [ -d "$old_starting" ] \
                && [ "$(stat -c %u:%a "$old_starting" 2>/dev/null || true)" = "$uid:700" ]; then
            rmdir "$old_starting" 2>/dev/null || :
        fi
        for old_file in "$legacy/voxtype-error" "$legacy/voxtype-journal.cursor"; do
            if [ ! -L "$old_file" ] && [ -f "$old_file" ] \
                    && [ "$(stat -c %u "$old_file" 2>/dev/null || true)" = "$uid" ]; then
                rm -f "$old_file" || :
            fi
        done
    fi
    printf '%s\n' "$runtime"
}
restart_started_service() {
    runtime=$(private_runtime 2>/dev/null) || return 1
    session_marker=$runtime/voxtype-session-started-v1
    if [ -e "$session_marker" ] || [ -L "$session_marker" ]; then
        [ ! -L "$session_marker" ] && [ -d "$session_marker" ] \
            && [ "$(stat -c %u:%a "$session_marker" 2>/dev/null || true)" = "$(id -u):700" ] \
            || return 1
        # try-restart deliberately preserves lazy startup and a manual stop,
        # but it is a no-op after an audio-device failure has left the official
        # daemon failed. Recover only that explicit failed state; the valid
        # per-login activation marker prevents a stale unit failure from
        # turning a settings change into the first activation of the session.
        if systemctl --user is-failed --quiet voxtype.service; then
            systemctl --user reset-failed voxtype.service || :
            systemctl --user restart voxtype.service
        else
            systemctl --user try-restart voxtype.service
        fi
    else
        systemctl --user try-restart voxtype.service
    fi
}
clear_runtime_error() {
    runtime=$(private_runtime 2>/dev/null) || return 0
    rm -f "$runtime/voxtype-error"
}
journal_events() {
    runtime=$1
    cursor_file=$runtime/voxtype-journal.cursor
    if [ -e "$cursor_file" ] || [ -L "$cursor_file" ]; then
        [ ! -L "$cursor_file" ] && [ -f "$cursor_file" ] \
            && [ "$(stat -c %u "$cursor_file" 2>/dev/null || true)" = "$(id -u)" ] \
            || return 0
        journalctl --user -u voxtype.service -n 40 --no-pager -o cat \
            --cursor-file="$cursor_file" 2>/dev/null || true
        return 0
    fi

    # journalctl rejects --since together with --cursor-file. Seed the cursor
    # first, then use a bounded initial look-back so an error emitted just
    # before the first status poll is still projected. Later polls read only
    # entries after that private cursor.
    seed=$(journalctl --user -u voxtype.service -n 0 --no-pager -o cat \
        --show-cursor 2>/dev/null || true)
    case "$seed" in
        '-- cursor: '*) cursor=${seed#-- cursor: } ;;
        *) cursor= ;;
    esac
    case "$cursor" in
        ''|*[!A-Za-z0-9_:.';'=-]*) ;;
        *)
            temporary=$(mktemp "$runtime/.voxtype-journal.cursor.XXXXXX") || return 0
            if ! printf '%s\n' "$cursor" >"$temporary" || ! chmod 0600 "$temporary" \
                    || ! mv -f -- "$temporary" "$cursor_file"; then
                rm -f -- "$temporary"
                return 0
            fi
            ;;
    esac
    journalctl --user -u voxtype.service --since '-30 seconds' -n 40 --no-pager -o cat \
        2>/dev/null || true
}
status() {
    state=unavailable error= language=auto backend= backend_state_valid=false integrity_ready=false
    runtime_version=1.1.1 upgrade_pending=false
    if [ "$(/usr/libexec/arctic/arctic-voxtype-host-profile)" = turbo-q5-v3 ]; then
        profile=turbo-q5-v3; model=large-v3-turbo-q5_0; model_bytes=574041195; download_bytes=593457131
    else
        profile=small-v2; model=small; model_bytes=487601967; download_bytes=506440871
    fi
    [ -r /var/lib/arctic/dictation/backend ] && IFS= read -r backend </var/lib/arctic/dictation/backend || :
    case "$backend" in cpu|vulkan) backend_state_valid=true ;; *) backend=cpu ;; esac
    if [ -r /var/lib/arctic/dictation/upstream-direct-v1 ] && [ -r /var/lib/arctic/dictation/verified.json ]; then
        receipt=/var/lib/arctic/dictation/verified.json
        binary_path= model_path= binary_bytes= receipt_backend=
        if ! grep -Fq '"integration":"upstream-direct-v1"' "$receipt"; then
            state=error
            if [ -r /var/lib/arctic/dictation/pending ]; then
                state=queued
                error=''
            else
                error='The VoxType setup receipt is obsolete or damaged. Retry setup to repair it.'
            fi
        elif grep -Fq '"version":"1.1.1"' "$receipt"; then
            if grep -Fq '"backend":"cpu"' "$receipt" \
                    && ! grep -Fq '"backend":"vulkan"' "$receipt" \
                    && ! grep -Fq '"vulkan_binary"' "$receipt"; then
                receipt_backend=cpu
            elif grep -Fq '"backend":"vulkan"' "$receipt" \
                    && ! grep -Fq '"backend":"cpu"' "$receipt" \
                    && grep -Fq '"vulkan_binary":"voxtype-vulkan"' "$receipt" \
                    && grep -Fq '"vulkan_binary_bytes":66575872' "$receipt" \
                    && grep -Fq '"vulkan_binary_sha256":"102a7caa22facc5c257c526ae4a9e63c04c027297fec4ca370209a1f94ae9863"' "$receipt"; then
                receipt_backend=vulkan
            fi
        elif grep -Fq '"version":"1.1.0"' "$receipt" \
                && [ ! -r /var/lib/arctic/dictation/previous-direct-rejected ] \
                && grep -Fq '"source_commit":"e2638ca63f566f1682bcedc0abea8e4b25211c21"' "$receipt" \
                && grep -Fq '"release_signing_fingerprint":"9CCF7915B750CAE8B095ED1AA3FC9F33FD209279"' "$receipt"; then
            runtime_version=1.1.0
            [ ! -r /var/lib/arctic/dictation/pending ] || upgrade_pending=true
            if grep -Fq '"backend":"cpu"' "$receipt" \
                    && ! grep -Fq '"backend":"vulkan"' "$receipt" \
                    && ! grep -Fq '"vulkan_binary"' "$receipt"; then
                receipt_backend=cpu
            elif grep -Fq '"backend":"vulkan"' "$receipt" \
                    && ! grep -Fq '"backend":"cpu"' "$receipt" \
                    && grep -Fq '"vulkan_binary":"voxtype-vulkan"' "$receipt" \
                    && grep -Fq '"vulkan_binary_bytes":66342968' "$receipt" \
                    && grep -Fq '"vulkan_binary_sha256":"db2c7938392ff08ec8b50b8afb90f8bd3d0111eccf5943df2f51c40a0368fec2"' "$receipt"; then
                receipt_backend=vulkan
            fi
            # The new setup stages CPU before its receipt commit. The old
            # receipt remains authoritative until that atomic switch.
            backend=$receipt_backend
        else
            state=error
            error='The VoxType setup receipt is obsolete or damaged. Retry setup to repair it.'
        fi
        if [ -n "$receipt_backend" ] && [ "$runtime_version" = 1.1.1 ] && [ "$backend_state_valid" != true ]; then
            state=error
            error='The VoxType backend update was interrupted. Select CPU or Vulkan again to finish it.'
            receipt_backend=
        elif [ -n "$receipt_backend" ] && [ "$receipt_backend" != "$backend" ]; then
            state=error
            error='The VoxType backend update was interrupted. Select CPU or Vulkan again to finish it.'
            receipt_backend=
        elif [ -n "$receipt_backend" ] && grep -Fq '"profile":"small-v2"' "$receipt"; then
            profile=small-v2; model=small; model_bytes=487601967; download_bytes=506440871
            if [ "$runtime_version" = 1.1.0 ]; then
                binary_path=/opt/arctic/voxtype/1.1.0/voxtype-baseline; binary_bytes=18579224
            else
                binary_path=/opt/arctic/voxtype/1.1.1/voxtype-baseline; binary_bytes=18838904
            fi
            model_path=/opt/arctic/voxtype/models/ggml-small.bin
        elif [ -n "$receipt_backend" ] && grep -Fq '"profile":"turbo-q5-v3"' "$receipt"; then
            profile=turbo-q5-v3; model=large-v3-turbo-q5_0; model_bytes=574041195; download_bytes=593457131
            if [ "$runtime_version" = 1.1.0 ]; then
                binary_path=/opt/arctic/voxtype/1.1.0/voxtype-avx2; binary_bytes=19153728
            else
                binary_path=/opt/arctic/voxtype/1.1.1/voxtype-avx2; binary_bytes=19415936
            fi
            model_path=/opt/arctic/voxtype/models/ggml-large-v3-turbo-q5_0.bin
        elif [ -n "$receipt_backend" ]; then
            state=error
            error='The VoxType setup receipt is obsolete or damaged. Retry setup to repair it.'
        fi
        if [ -n "$binary_path" ]; then
            user_config=${XDG_CONFIG_HOME:-$HOME/.config}/voxtype/config.toml
            if [ ! -x "$binary_path" ] || [ "$(stat -c %s "$binary_path" 2>/dev/null || true)" != "$binary_bytes" ]; then
                state=error
                error='The verified VoxType app is missing or damaged. Retry setup to repair it.'
            elif [ ! -f "$model_path" ] || [ "$(stat -c %s "$model_path" 2>/dev/null || true)" != "$model_bytes" ]; then
                state=error
                error='The verified local Whisper model is missing or damaged. Retry setup to repair it.'
            elif [ ! -r "$user_config" ]; then
                state=error
                error='Dictation is not prepared for this account. Retry setup to create its private VoxType configuration.'
            elif [ "$backend" = vulkan ] && { \
                    [ "$runtime_version" = 1.1.1 ] && { [ ! -x /opt/arctic/voxtype/1.1.1/voxtype-vulkan ] || [ "$(stat -c %s /opt/arctic/voxtype/1.1.1/voxtype-vulkan 2>/dev/null || true)" != 66575872 ]; } \
                    || [ "$runtime_version" = 1.1.0 ] && { [ ! -x /opt/arctic/voxtype/1.1.0/voxtype-vulkan ] || [ "$(stat -c %s /opt/arctic/voxtype/1.1.0/voxtype-vulkan 2>/dev/null || true)" != 66342968 ]; }; }; then
                state=error
                error='The verified Vulkan VoxType app is missing or damaged. Select CPU or retry Vulkan setup.'
            else
                integrity_ready=true
            fi
        fi
        if [ "$integrity_ready" = true ]; then
            configured=$(voxtype config get whisper.language 2>/dev/null || true)
            case "$configured" in
                he,en|en,he) language=auto ;;
                he) language=he ;;
                en) language=en ;;
            esac
            if ! runtime=$(private_runtime); then
                state=error
                error='The private dictation runtime directory is unsafe. Sign out and back in before trying again.'
            else
                upstream=$(voxtype status 2>/dev/null || true)
                case "$upstream" in
                    idle) state=ready ;;
                    recording|transcribing) state=$upstream ;;
                    *)
                        if [ -d "$runtime/voxtype-starting" ] \
                                && [ ! -L "$runtime/voxtype-starting" ]; then
                            state=starting
                        elif systemctl --user is-active --quiet voxtype.service; then
                            state=error
                            error='VoxType started but did not publish a usable state. Stop it and retry setup.'
                        else
                            # Installed and ready for an explicit first activation.
                            # The resident model consumes no login memory yet.
                            state=ready
                        fi
                        ;;
                esac
            fi
            if [ "$state" = recording ] || [ "$state" = transcribing ]; then
                rm -f "$runtime/voxtype-error"
            elif [ "$state" != starting ] && [ -n "${runtime:-}" ]; then
                recent=$(journal_events "$runtime")
                case "$recent" in
                    *'Failed to start audio:'*|*'Failed to create audio capture:'*|*'Audio stream error, capture is now dead:'*|*'failed during this recording; the transcript will be short or empty.'*) printf '%s\n' microphone >"$runtime/voxtype-error" ;;
                    *'Transcription failed: Model not found:'*|*'Transcription failed: Failed to load model:'*) printf '%s\n' model >"$runtime/voxtype-error" ;;
                    *'This build has Vulkan support, so transcription will fall back to CPU'*|*'ggml_vulkan: Found 0 Vulkan devices'*) printf '%s\n' gpu-fallback >"$runtime/voxtype-error" ;;
                    *'Transcription failed:'*) printf '%s\n' transcription >"$runtime/voxtype-error" ;;
                    *'Output failed:'*) printf '%s\n' output >"$runtime/voxtype-error" ;;
                esac
                projected=; [ -r "$runtime/voxtype-error" ] && IFS= read -r projected <"$runtime/voxtype-error"
                case "$projected:$backend" in
                    microphone:*) state=error; error='VoxType could not open the microphone. Check the selected input and microphone permission, then try again.' ;;
                    model:*) state=error; error='The local Whisper model could not be loaded. Retry setup to verify and repair it.' ;;
                    gpu-fallback:vulkan) state=error; error='VoxType could not start on Vulkan and is using CPU. Select CPU acceleration, or fix the Vulkan driver and enable Vulkan again.' ;;
                    transcription:vulkan) state=error; error='Vulkan transcription failed. Select CPU acceleration in Dictation settings, then try again.' ;;
                    transcription:*) state=error; error='Local transcription failed. Try a shorter recording; if it repeats, retry setup.' ;;
                    output:*) state=error; error='VoxType could not insert text. Focus a writable text field; the app may reject Wayland text insertion.' ;;
                    service-start:*) state=error; error='VoxType could not start. Verify or repair the signed app and model in Dictation settings, then retry.' ;;
                    service-timeout:*) state=error; error='VoxType took too long to load the local model. Verify or repair setup, then retry.' ;;
                esac
            fi
        fi
        if [ "$upgrade_pending" != true ] && [ -r /var/lib/arctic/dictation/setup.error ]; then
            setup_error=; IFS= read -r setup_error </var/lib/arctic/dictation/setup.error || :
            case "$setup_error" in
                backend-vulkan) state=error; error='Vulkan setup failed its local model check. CPU remains selected; check the Vulkan driver before retrying.' ;;
                setup) state=error; error='VoxType setup or repair did not finish. Check the connection and retry in Settings.' ;;
            esac
        fi
    elif [ -r /var/lib/arctic/dictation/setup.state ]; then
        IFS= read -r state </var/lib/arctic/dictation/setup.state || state=unavailable
        case "$state" in
            queued|downloading) ;;
            failed) state=error; error='VoxType setup did not finish. Check the connection and retry in Settings.' ;;
            *) state=unavailable ;;
        esac
    fi
    ready=$integrity_ready
    printf '{"state":"%s","ready":%s,"error":"%s","version":"%s","upgrade_pending":%s,"language":"%s","backend":"%s","profile":"%s","model":"%s","model_download_bytes":%s,"download_bytes":%s,"vulkan_download_bytes":66575872}\n' \
        "$state" "$ready" "$error" "$runtime_version" "$upgrade_pending" "$language" "$backend" "$profile" "$model" "$model_bytes" "$download_bytes"
}
case ${1:-} in
    status) [ $# = 1 ] || exit 2; status ;;
    retry)
        [ $# = 1 ] || exit 2
        if pkexec /usr/libexec/arctic/arctic-voxtype-setup --retry; then
            clear_runtime_error
            systemctl --user daemon-reload || :
            restart_started_service || :
        fi
        status
        ;;
    set-language)
        [ $# = 2 ] || exit 2
        case "$2" in auto|he|en) ;; *) exit 2 ;; esac
        voxtype config set whisper.language "$2" >/dev/null
        if [ "$2" = auto ]; then
            config=${XDG_CONFIG_HOME:-$HOME/.config}/voxtype/config.toml
            temporary=$(mktemp "$config.XXXXXX")
            awk 'BEGIN{s=""} /^\[/ {s=$0} s=="[whisper]" && /^[[:space:]]*language[[:space:]]*=/ {print "language = [\"he\", \"en\"]"; next} {print}' "$config" >"$temporary"
            chmod 0600 "$temporary"; mv -f "$temporary" "$config"
            voxtype --config "$config" config get whisper.language --json >/dev/null
        fi
        restart_started_service || :
        clear_runtime_error
        status
        ;;
    set-backend)
        [ $# = 2 ] || exit 2
        case "$2" in cpu|vulkan) ;; *) exit 2 ;; esac
        if pkexec /usr/libexec/arctic/arctic-voxtype-setup --backend "$2"; then
            clear_runtime_error
            systemctl --user daemon-reload || :
            restart_started_service || :
        fi
        status
        ;;
    *) echo 'usage: arctic-dictation status|retry|set-language auto|he|en|set-backend cpu|vulkan' >&2; exit 2 ;;
esac
