#!/bin/sh
# Write Arctic's canonical local-only VoxType config as the target user. This
# helper must never run as root inside a user-controlled home directory.
set -eu
umask 077
[ "$#" = 1 ] || [ "$#" = 2 ] || exit 2
case "$1" in
    /opt/arctic/voxtype/models/ggml-small.bin|/opt/arctic/voxtype/models/ggml-large-v3-turbo-q5_0.bin) model=$1 ;;
    *) exit 2 ;;
esac
validator=/usr/bin/voxtype
if [ "$#" = 2 ]; then
    case "$2" in
        /opt/arctic/voxtype/1.1.1/voxtype-baseline|/opt/arctic/voxtype/1.1.1/voxtype-avx2) validator=$2 ;;
        *) exit 2 ;;
    esac
    [ -x "$validator" ] || exit 1
fi
[ "$(id -u)" -ne 0 ] || exit 77
[ -n "${HOME:-}" ] && [ "${HOME#/}" != "$HOME" ] && [ -d "$HOME" ] && [ ! -L "$HOME" ] || exit 1
sync_directory() {
    python3 - "$1" <<'PY'
import os, stat, sys
path = sys.argv[1]
fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    info = os.fstat(fd)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
        raise SystemExit(1)
    os.fsync(fd)
finally:
    os.close(fd)
parent = os.open(os.path.dirname(path), os.O_RDONLY | os.O_DIRECTORY)
try:
    os.fsync(parent)
finally:
    os.close(parent)
PY
}
sync_user_file() {
    python3 - "$1" <<'PY'
import os, stat, sys
path = sys.argv[1]
fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
try:
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600:
        raise SystemExit(1)
    os.fsync(fd)
finally:
    os.close(fd)
parent = os.open(os.path.dirname(path), os.O_RDONLY | os.O_DIRECTORY)
try:
    os.fsync(parent)
finally:
    os.close(parent)
PY
}
base=$HOME/.config
dir=$base/voxtype
for path in "$base" "$dir"; do
    if [ -e "$path" ] || [ -L "$path" ]; then
        [ -d "$path" ] && [ ! -L "$path" ] || exit 1
    else
        mkdir -m 0700 "$path"
    fi
    chmod 0700 "$path"
    sync_directory "$path"
done
config=$dir/config.toml
backup=$dir/config.toml.pre-arctic-voxtype-v1
if [ -e "$config" ] || [ -L "$config" ]; then
    [ -f "$config" ] && [ ! -L "$config" ] || exit 1
    if [ -e "$backup" ] || [ -L "$backup" ]; then
        [ -f "$backup" ] && [ ! -L "$backup" ] || exit 1
    else
        cp -- "$config" "$backup"
        chmod 0600 "$backup"
        sync_user_file "$backup"
    fi
fi
temporary=$(mktemp "$dir/config.toml.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT HUP INT TERM
cat >"$temporary" <<CONFIG
# Managed safe defaults for Arctic's local-only VoxType integration.
engine = "whisper"
state_file = "auto"

[hotkey]
enabled = false

[audio]
device = "default"
sample_rate = 16000
max_duration_secs = 60
pause_media = false
duck_media = false

[whisper]
mode = "local"
model = "$model"
language = ["he", "en"]
translate = false
on_demand_loading = false

[text]
filter_filler_words = false

[output]
mode = "type"
driver_order = ["wtype"]
fallback_to_clipboard = false
auto_submit = false
shift_enter_newlines = false
wait_for_modifier_release = false

[output.notification]
on_recording_start = false
on_recording_stop = false
on_transcription = false

[osd]
enabled = false
CONFIG
chmod 0600 "$temporary"
"$validator" --config "$temporary" config get whisper.language --json >/dev/null
mv -f -T -- "$temporary" "$config"
sync_user_file "$config"
trap - EXIT HUP INT TERM
