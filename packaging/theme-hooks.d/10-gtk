#!/usr/bin/bash
# Arctic Linux theme hook: GTK apps (docs/BUILD-SPEC.md "App theming").
#
# `arctic-theme reload` runs every hook in /usr/share/arctic/theme-hooks.d and
# ~/.config/arctic/theme-hooks.d after a theme change, with ARCTIC_THEME_DIR (the active theme
# folder) and ARCTIC_THEME_MODE (dark|light). Hooks are quick and never fail the switch.
#
# - ~/.config/gtk-{3,4}.0/arctic-colors.css: a copy of the theme's gtk.css, which gtk.css there
#   imports. The dotfiles ship it as a link to ../arctic/current/gtk.css; Flatpak apps see those
#   folders (/var/lib/flatpak/overrides/global) but not /usr/share/arctic, so the link becomes a
#   copy. Only the link or an earlier copy is replaced, never a file of your own. Unchanged
#   copies are left alone.
#
# arctic-theme itself owns the GTK settings: after the hooks it sets color-scheme and gtk-theme
# (adw-gtk3-dark / adw-gtk3, the names the dconf defaults use) and gtk-3.0/settings.ini, so
# running GTK 3 apps, and Flatpak GTK 3 apps through the settings portal, restyle with the
# copies made here.
# Same content? (coreutils only: diffutils' cmp is not always installed.)
same() { command -v sha256sum >/dev/null && [[ -f $1 && -f $2 ]] && [[ "$(sha256sum < "$1")" == "$(sha256sum < "$2")" ]]; }
set -u

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
dir="${ARCTIC_THEME_DIR:-$cfg/arctic/current}"
marker="/* arctic-colors.css: the active theme's gtk.css, copied by the 10-gtk theme hook */"

if [[ -r "$dir/gtk.css" ]]; then
  for gtk in gtk-3.0 gtk-4.0; do
    [[ -d "$cfg/$gtk" ]] || continue
    f="$cfg/$gtk/arctic-colors.css"
    if [[ -L "$f" || ! -e "$f" ]] || { head -n1 "$f" | grep -qxF "$marker"; } 2>/dev/null; then
      tmp="$(mktemp "$f.XXXXXX" 2>/dev/null)" || continue
      if { printf '%s\n' "$marker"; cat "$dir/gtk.css"; } > "$tmp" 2>/dev/null; then
        if [[ ! -L "$f" ]] && same "$tmp" "$f"; then
          :                                   # already current
        else
          chmod 0644 "$tmp" && mv -f "$tmp" "$f"
        fi
      fi
      rm -f "$tmp"
    fi
  done
fi

exit 0
