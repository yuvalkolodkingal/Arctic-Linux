#!/usr/bin/python3
"""arctic-firstboot — finish installing apps the installer had to put off.

When an optional app can't be downloaded during installation (and the person chose to
continue), the installer records it in /var/lib/arctic/pending.json, with the app's install
methods from the catalog (the catalog itself isn't kept on the installed system). The file is
written by internal/installer (finalizePhase); each method is a catalog.Install in its JSON
form, whose empty fields are left out ("ref", "packages", "repos", "swap", …):
    {"version": 2, "nixpkgs": "github:NixOS/nixpkgs/<rev>",
     "modules": [{"id": "zed", "name": "Zed",
                  "install": [{"method": "flatpak", "remote": "flathub", "ref": "dev.zed.Zed", …}]}]}
Drivers (the catalog's hardware category) put off because the computer was offline also
carry what the installer does after their packages (internal/installer/drivers.go):
    {"id": "nvidia", …, "akmod": {"name": "nvidia", "module": "nvidia"},
     "kernel_args": ["rd.driver.blacklist=nouveau,nova_core", …]}
and, when Secure Boot is on, the file has "mok_hash": "/var/lib/arctic/mok.hash", the
SHA-512 crypt hash of the one-time code the installer's Done screen showed. After such a
driver's packages go in, akmods is installed with the development files of the installed
kernels (kernel-devel-matched-<kver>; when that version has left the repositories, the newest
complete kernel with its own) and its signing key is made (kmodgenca) — before the driver,
because the akmod package's %posttrans starts a build in the background right away and that
build signs only with a key that is already there. Then the module is built with akmods for
every kernel that has its development files, its kernel arguments are added with grubby, and
the akmods key is queued for enrolment with mokutil --import --hash-file, so MokManager asks
for that code at the next restart. (A driver whose build the installer put off to boot comes
here too, already installed: the same steps finish it.)
This runs after boot (arctic-firstboot.timer), tries each module's
methods in order until one works — doing what the installer does for each method
(installMethod / setupRepos) — and removes the modules that succeed. When nothing is left,
the file is deleted and the service no longer starts. It never blocks login: it runs in the
background.
"""
import json
import os
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path

PENDING = Path("/var/lib/arctic/pending.json")
# Where /lib/modules and /usr/src/kernels are looked for (tests point it elsewhere).
ROOT = Path("/")
CATALOG = Path("/usr/share/arctic/catalog")
NIX_PROFILE = "/nix/var/nix/profiles/default"
# internal/installer FlatpakRemotes: the catalog's remote names and their .flatpakrepo files.
FLATPAK_REMOTES = {"flathub": "https://dl.flathub.org/repo/flathub.flatpakrepo"}
# internal/installer Options.FedoraRelease's default.
DEFAULT_FEDORA_RELEASE = "44"
# The akmods signing key (internal/wizard MOKKeyPath) and the EFI variables Secure Boot is
# read from (internal/host SecureBoot).
AKMODS_KEY = "/etc/pki/akmods/certs/public_key.der"
# internal/installer KernelFallback: the newest complete kernel with its development files.
KERNEL_FALLBACK = ["akmods", "kernel", "kernel-core", "kernel-modules", "kernel-modules-core",
                   "kernel-modules-extra", "kernel-devel-matched"]
EFIVARS = Path("/sys/firmware/efi/efivars")
EFI_GLOBAL = "8be4df61-93ca-11d2-aa0d-00e098032b8c"
SHIM_GUID = "605dab50-e046-4300-abb6-3dd810dd8b23"


def log(msg):
    print(msg, flush=True)


def run(cmd, quiet=False):
    """Run a command (no shell); True when it succeeded. quiet: a check, not an action."""
    if not quiet:
        log("$ " + " ".join(cmd))
    out = subprocess.DEVNULL if quiet else None
    try:
        return subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=out, stderr=out).returncode == 0
    except OSError as e:
        if not quiet:
            log(f"{cmd[0]}: {e.strerror}")
        return False


def fedora_release():
    """The Fedora release underneath, for the RPM Fusion URLs and keys. Not os-release's
    VERSION_ID, which is Arctic's own version (0.1): the %fedora macro (arctic-release's
    macros.dist), else PLATFORM_ID="platform:f44"."""
    try:
        out = subprocess.run(["rpm", "-E", "%fedora"], capture_output=True, text=True).stdout.strip()
        if out.isdigit():
            return out
    except OSError:
        pass
    try:
        for line in Path("/etc/os-release").read_text().splitlines():
            key, _, value = line.partition("=")
            value = value.strip().strip('"')
            if key == "PLATFORM_ID" and value.startswith("platform:f") and value[10:].isdigit():
                return value[10:]
    except OSError:
        pass
    return DEFAULT_FEDORA_RELEASE


def efi_byte(name):
    """The first data byte of an EFI variable (after its 4 attribute bytes), or None."""
    try:
        data = (EFIVARS / name).read_bytes()
    except OSError:
        return None
    return data[4] if len(data) > 4 else None


def secure_boot():
    """Secure Boot enforced: SecureBoot = 1, not in setup mode, shim validation on."""
    return (efi_byte(f"SecureBoot-{EFI_GLOBAL}") == 1 and efi_byte(f"SetupMode-{EFI_GLOBAL}") != 1
            and efi_byte(f"MokSBStateRT-{SHIM_GUID}") != 1)


def find_manifest(module_id):
    for path in CATALOG.rglob("module.toml"):
        try:
            data = tomllib.loads(path.read_text())
        except (OSError, tomllib.TOMLDecodeError):
            continue
        if data.get("id") == module_id:
            return data
    return None


class FirstBoot:
    """What the installer's installMethod does for one install method, on the running system.
    `run` executes a command and returns whether it worked (tests pass a fake)."""

    def __init__(self, run=run, release=None, nixpkgs="", root=None):
        self.run = run
        self.root = Path(root or ROOT)
        self.akmods_ready = False
        self.release = release or fedora_release()
        self.nixpkgs = nixpkgs or "nixpkgs"
        self.repos_done = set()
        self.copr_done = set()
        self.remotes_done = set()

    def installed(self, package):
        return self.run(["rpm", "-q", "--quiet", package], quiet=True)

    def setup_repos(self, method):
        """internal/installer setupRepos: the RPM Fusion release packages (keys from
        distribution-gpg-keys, never --nogpgcheck), the COPR, then the package swaps
        (ffmpeg-free → ffmpeg). Steps already done by an earlier run are skipped."""
        for repo in method.get("repos") or []:
            if repo in self.repos_done:
                continue
            kind = repo.removeprefix("rpmfusion-")   # free | nonfree
            if not self.installed(f"rpmfusion-{kind}-release"):
                rel = self.release
                key = f"/usr/share/distribution-gpg-keys/rpmfusion/RPM-GPG-KEY-rpmfusion-{kind}-fedora-{rel}"
                url = f"https://mirrors.rpmfusion.org/{kind}/fedora/rpmfusion-{kind}-release-{rel}.noarch.rpm"
                if not (self.run(["rpm", "--import", key]) and self.run(["dnf", "install", "-y", url])):
                    return False
            self.repos_done.add(repo)
        copr = method.get("copr")
        if method.get("method") == "copr" and copr not in self.copr_done:
            if not copr or not self.run(["dnf", "copr", "enable", "-y", copr]):
                return False
            self.copr_done.add(copr)
        for swap in method.get("swap") or []:
            old, _, new = swap.partition("=")
            # Already swapped (or never there): nothing to replace.
            if not self.installed(old):
                continue
            if not self.run(["dnf", "swap", "-y", "--allowerasing", old, new]):
                return False
        return True

    def try_method(self, method):
        kind = method.get("method")
        if kind in ("dnf", "copr"):
            packages = method.get("packages") or []
            return (bool(packages) and self.setup_repos(method)
                    and self.run(["dnf", "install", "-y", *packages]))
        if kind == "flatpak":
            remote = method.get("remote") or "flathub"
            if remote not in self.remotes_done:
                url = FLATPAK_REMOTES.get(remote)
                if not url:
                    log(f"unknown flatpak remote {remote!r}")
                    return False
                if not self.run(["flatpak", "remote-add", "--system", "--if-not-exists", remote, url]):
                    return False
                self.remotes_done.add(remote)
            ref = method.get("ref")
            if not ref:   # a module that only adds the remote (Flathub)
                return True
            return self.run(["flatpak", "install", "--system", "-y", "--noninteractive", remote, ref])
        if kind == "nix":
            attr = method.get("attr")
            if not attr:
                return False
            return self.run(["nix", "--extra-experimental-features", "nix-command flakes", "profile", "add",
                             "--profile", NIX_PROFILE, f"{self.nixpkgs}#{attr}"])
        log(f"unknown install method {kind!r}")
        return False

    def install(self, module):
        """Try a module's methods in order; True when one worked. A driver is then built and
        its kernel arguments added (see the top)."""
        akmod = module.get("akmod")
        if isinstance(akmod, dict) and not self.prepare_akmods():
            return False
        if not any(self.try_method(m) for m in module.get("install") or [] if isinstance(m, dict)):
            return False
        if isinstance(akmod, dict) and not self.build(akmod):
            return False
        args = [a for a in module.get("kernel_args") or [] if isinstance(a, str)]
        if args and not self.run(["grubby", "--update-kernel=ALL", "--args=" + " ".join(args)]):
            return False
        return True

    def kernels(self):
        """Installed kernel versions: /lib/modules/<kver> with its vmlinuz (kernel-core)."""
        try:
            dirs = sorted((self.root / "lib/modules").iterdir())
        except OSError:
            return []
        return [d.name for d in dirs if (d / "vmlinuz").exists()]

    def has_devel(self, kver):
        return (self.root / "usr/src/kernels" / kver / "Makefile").exists()

    def prepare_akmods(self):
        """internal/installer prepareAkmods: akmods with each kernel's own development files
        (never the newest kernel-devel-matched alone, which drags in a kernel without
        kernel-modules), then the signing key, all before the driver's packages."""
        if self.akmods_ready:
            return True
        kvers = self.kernels()
        if not kvers or not self.run(["dnf", "install", "-y", "akmods",
                                      *(f"kernel-devel-matched-{k}" for k in kvers)]):
            log("the kernel's development files aren't available any more: installing the newest kernel with them")
            if not self.run(["dnf", "install", "-y", *KERNEL_FALLBACK]):
                return False
        if not self.run(["kmodgenca", "-a"]):
            return False
        self.akmods_ready = True
        return True

    def build(self, akmod):
        """Build a driver for every kernel with its development files and check it's there
        (the build the akmod's %posttrans started holds akmods' lock; this waits for it)."""
        name, module = akmod.get("name"), akmod.get("module")
        if not isinstance(name, str) or not isinstance(module, str):
            return False
        built = 0
        for kver in self.kernels():
            if not self.has_devel(kver):
                log(f"{name}: no kernel-devel for {kver}, akmods builds it when that kernel boots")
                continue
            if not (self.run(["akmods", "--force", "--kernels", kver, "--akmod", name])
                    and self.run(["modinfo", "-k", kver, "-F", "version", module], quiet=True)):
                return False
            built += 1
        return built > 0


def enroll_key(pending, done, runner, sb=secure_boot):
    """Queue the akmods key for enrolment once a driver that needs it is built (Secure Boot
    on). Returns the mok_hash to keep for a later run ("" when done with it)."""
    hash_file = pending.get("mok_hash") or ""
    if not isinstance(hash_file, str) or not hash_file:
        return ""
    if not any(isinstance(m.get("akmod"), dict) for m in done):
        return hash_file   # wait for the driver
    if not sb():
        log("Secure Boot is off: the driver key needs no enrolment")
    elif runner(["mokutil", "--import", AKMODS_KEY, "--hash-file", hash_file]):
        log("driver key queued: restart and type the one-time code from the installer (Enroll MOK)")
    else:
        log("couldn't ask to enroll the driver key; run: sudo mokutil --import " + AKMODS_KEY)
    Path(hash_file).unlink(missing_ok=True)
    return ""


def retry(pending, firstboot, done=None):
    """Try every pending module; returns the ones still left (the ones installed go to done)."""
    left = []
    for entry in pending.get("modules") or []:
        # Version 1 listed bare ids; look those up in the catalog if it's still installed.
        module = entry if isinstance(entry, dict) else find_manifest(entry)
        if not module:
            log(f"{entry}: no install methods known, dropping it")
            continue
        name = module.get("name") or module.get("id") or "?"
        try:
            ok = firstboot.install(module)
        except Exception as e:   # one bad entry must not stop the others or the rewrite
            log(f"{name}: {e!r}")
            ok = False
        if ok:
            log(f"{name}: installed")
            if done is not None:
                done.append(module)
        else:
            log(f"{name}: still can't be installed, trying again in 15 minutes")
            left.append(module)
    return left


def queue(pending):
    """Merge the installer's version-2 app queue without replacing other pending work."""
    def entries(doc, incoming=False):
        if (type(doc) is not dict or type(doc.get("version")) is not int
                or doc["version"] not in ((2,) if incoming else (1, 2))
                or type(doc.get("modules")) is not list or len(doc["modules"]) > 1024
                or type(doc.get("nixpkgs", "")) is not str):
            raise ValueError("invalid app queue")
        result = {}
        for module in doc["modules"]:
            identifier = module.get("id") if type(module) is dict else module
            if (type(identifier) is not str or not identifier or len(identifier) > 128
                    or any(c not in "abcdefghijklmnopqrstuvwxyz0123456789-" for c in identifier)):
                raise ValueError("invalid app queue entry")
            if incoming and (type(module) is not dict or type(module.get("install")) is not list):
                raise ValueError("invalid new app queue entry")
            if identifier in result and result[identifier] != module:
                raise ValueError("conflicting app queue entries")
            result[identifier] = module
        return result

    new = entries(pending, incoming=True)
    try:
        with PENDING.open("rb") as source:
            raw = source.read((1 << 20) + 1)
        if len(raw) > 1 << 20:
            raise ValueError("app queue is too large")
        old = json.loads(raw)
    except FileNotFoundError:
        old = {"version": 2, "modules": [], "nixpkgs": ""}
    merged = entries(old)
    for key in ("nixpkgs", "mok_hash"):
        if old.get(key) and pending.get(key) and old[key] != pending[key]:
            raise ValueError("app queue configuration differs")
    for identifier, module in new.items():
        previous = merged.get(identifier)
        if previous is not None and previous != module:
            # The fixed installer support entry can accumulate package checks across
            # setup attempts. Other queued definitions are never silently replaced.
            def support(entry):
                return (type(entry) is dict and set(entry) == {"id", "name", "install"}
                        and entry["id"] == "installer-support" and entry["name"] == "Language and app support"
                        and type(entry["install"]) is list and len(entry["install"]) == 1
                        and type(entry["install"][0]) is dict
                        and set(entry["install"][0]) == {"method", "packages", "verified", "download_mb"}
                        and entry["install"][0]["method"] == "dnf"
                        and entry["install"][0]["verified"] is False
                        and type(entry["install"][0]["download_mb"]) in (int, float)
                        and entry["install"][0]["download_mb"] == 0
                        and type(entry["install"][0]["packages"]) is list
                        and all(type(p) is str for p in entry["install"][0]["packages"]))
            if identifier != "installer-support" or not support(previous) or not support(module):
                raise ValueError("app queue entry differs")
            module = dict(module, install=[dict(module["install"][0], packages=list(dict.fromkeys(
                previous["install"][0]["packages"] + module["install"][0]["packages"])))])
        merged[identifier] = module
    doc = dict(old, version=2, modules=list(merged.values()))
    for key, value in pending.items():
        if key not in ("modules", "version") and value:
            doc[key] = value
    data = (json.dumps(doc, indent=2) + "\n").encode()
    if len(data) > 1 << 20:
        raise ValueError("merged app queue is too large")
    PENDING.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=PENDING.parent, prefix=".pending-", delete=False) as target:
            temporary = Path(target.name)
            target.write(data)
            target.flush()
            os.fsync(target.fileno())
        temporary.chmod(0o644)
        temporary.replace(PENDING)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def queue_stdin():
    if os.geteuid() != 0:
        return 1
    try:
        raw = sys.stdin.buffer.read((1 << 20) + 1)
        if len(raw) > 1 << 20:
            raise ValueError("app queue is too large")
        queue(json.loads(raw))
    except (OSError, ValueError, TypeError):
        log("Couldn't save pending app setup; the existing queue was preserved.")
        return 1
    return 0


def main(runner=run, sb=secure_boot):
    if os.geteuid() != 0:
        sys.exit("arctic-firstboot must run as root")
    try:
        pending = json.loads(PENDING.read_text())
    except FileNotFoundError:
        return 0
    except (OSError, ValueError) as e:
        log(f"can't read {PENDING}: {e}")
        return 1
    if not isinstance(pending, dict):
        log(f"can't read {PENDING}: not a JSON object")
        return 1
    nixpkgs = pending.get("nixpkgs") or ""
    done = []
    left = retry(pending, FirstBoot(run=runner, nixpkgs=nixpkgs), done)
    mok_hash = enroll_key(pending, done, runner, sb=sb)
    if left:
        doc = {"version": 2, "nixpkgs": nixpkgs, "modules": left}
        if mok_hash:
            doc["mok_hash"] = mok_hash
        tmp = PENDING.with_suffix(".tmp")
        tmp.write_text(json.dumps(doc, indent=2) + "\n")
        tmp.replace(PENDING)
        return 1
    PENDING.unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    sys.exit(queue_stdin() if sys.argv[1:] == ["--queue"] else main())
