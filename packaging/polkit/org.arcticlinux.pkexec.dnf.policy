<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Arctic Linux: Get apps (the shell's install console) runs `pkexec /usr/bin/dnf5 …`.
     An administrator's password, asked in the shell's own dialog, is kept for a few
     minutes, so installing a second app right after the first doesn't ask again. -->
<policyconfig>
  <vendor>Arctic Linux</vendor>
  <vendor_url>https://github.com/yuvalkolodkingal/O-Tism</vendor_url>
  <action id="org.arcticlinux.pkexec.dnf">
    <description>Install, update or remove software</description>
    <message>Enter your password to install, update or remove software</message>
    <icon_name>system-software-install</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/dnf5</annotate>
  </action>
</policyconfig>
