# Arctic Linux packages: the arctic-* packages and mangowm, which Fedora doesn't ship, signed
# with the Arctic Linux key (/etc/pki/rpm-gpg/RPM-GPG-KEY-arctic). Fedora's own repositories
# (fedora-repos) are unaffected. Published on the project's GitHub Pages site by
# .github/workflows/repo.yml from the main branch (docs/BUILD-SPEC.md §9).
#
# arctic-release installs this file as /usr/share/dnf5/repos.d/arctic.repo and replaces it on
# updates: don't edit it. Change a setting with an override, which updates keep, e.g.
#   sudo dnf config-manager setopt arctic.enabled=0
# (written to /etc/dnf/repos.override.d/99-config_manager.repo). The testing channel is in
# arctic-testing.repo.
[arctic]
name=Arctic Linux $releasever - $basearch
baseurl=https://yuvalkolodkingal.github.io/O-Tism/repo/stable/fedora-$releasever/$basearch/
type=rpm-md
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-arctic
metadata_expire=6h
# The live USB and the installer work offline: an unreachable repository is skipped.
skip_if_unavailable=True
# Before Fedora's repositories (priority 99), so arctic-* and mangowm come from here.
priority=90

[arctic-source]
name=Arctic Linux $releasever - Source
baseurl=https://yuvalkolodkingal.github.io/O-Tism/repo/stable/fedora-$releasever/source/
type=rpm-md
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-arctic
metadata_expire=6h
skip_if_unavailable=True
priority=90
