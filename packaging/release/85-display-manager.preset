# From Fedora's fedora-release-common 44-18 (MIT), shipped unchanged by arctic-release
# so Arctic Linux keeps Fedora's default-service policy. Arctic's own choices are in 80-arctic*.preset.
# We enable all display managers by default. Since only one can
# actually be enabled at the same time the one which is installed
# first wins

enable gdm.service
enable lightdm.service
enable slim.service
enable lxdm.service
enable sddm.service
enable kdm.service
enable xdm.service

# https://bugzilla.redhat.com/show_bug.cgi?id=2417187
enable plasmalogin.service

# https://bugzilla.redhat.com/show_bug.cgi?id=2305602
enable cosmic-greeter.service
