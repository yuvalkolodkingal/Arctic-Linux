# dist macros (arctic-release). Arctic Linux is built on Fedora 44 and builds packages with
# Fedora's dist tag, so packages built here and in Fedora's COPR chroots compare the same way.

%__bootstrap         ~bootstrap
%fedora              44
%fc44                1
%arctic              0.2
%distcore            .fc%{fedora}
%dist                %{!?distprefix0:%{?distprefix}}%{expand:%{lua:for i=0,9999 do print("%{?distprefix" .. i .."}") end}}%{distcore}%{?with_bootstrap:%{__bootstrap}}%{?buildrelease:+build%{buildrelease}}
%dist_vendor         Arctic Linux
%dist_name           Arctic Linux
%dist_purl_namespace fedora
%dist_home_url       https://github.com/yuvalkolodkingal/O-Tism
%dist_bug_report_url https://github.com/yuvalkolodkingal/O-Tism/issues
%dist_debuginfod_url ima:enforcing https://debuginfod.fedoraproject.org/ ima:ignore
