# Arctic Linux testing: builds of the development branch, before it reaches main (the stable
# channel, arctic.repo). Same key, same packages, newer and less tried. Off by default; turn it
# on (and back off) with an override, which updates keep:
#   sudo dnf config-manager setopt arctic-testing.enabled=1
# Turned off again, the testing builds stay installed until the stable channel has newer
# ones (a build of a later commit: every build's Release starts with its commit's time).
#
# arctic-release installs this file as /usr/share/dnf5/repos.d/arctic-testing.repo and
# replaces it on updates: don't edit it (docs/BUILD-SPEC.md §9).
[arctic-testing]
name=Arctic Linux $releasever - $basearch - Testing
baseurl=https://yuvalkolodkingal.github.io/Arctic-Linux/repo/testing/fedora-$releasever/$basearch/
type=rpm-md
enabled=0
gpgcheck=1
# Every package is signed and checked (gpgcheck), and so is the metadata (repomd.xml.asc,
# repo_gpgcheck). dnf imports the key for the metadata check into its cache on the first run
# with -y (the automatic update check, first boot and Get apps all use -y); until then a dnf
# run without -y (dnf-makecache.timer, a declined prompt) skips this repository. The site is
# served over HTTPS only.
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-arctic
metadata_expire=6h
skip_if_unavailable=True
priority=90

[arctic-testing-source]
name=Arctic Linux $releasever - Testing Source
baseurl=https://yuvalkolodkingal.github.io/Arctic-Linux/repo/testing/fedora-$releasever/source/
type=rpm-md
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-arctic
metadata_expire=6h
skip_if_unavailable=True
priority=90
