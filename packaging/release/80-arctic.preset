# Arctic Linux system services (arctic-release). Read before Fedora's 85/90/99 presets,
# so these win.

# Login screen: SDDM with the arctic theme (greeter on mango, sddm-wayland-mango).
enable sddm.service
disable gdm.service
disable lightdm.service
disable plasmalogin.service

# Installer engine, socket-activated on /run/arcticd.sock (group wheel).
enable arcticd.socket
disable arcticd.service
# Finishes app installs the installer had to put off (only runs when pending.json exists).
enable arctic-firstboot.service

# Updates (arctic-update): downloaded daily in the background, installed at the next restart
# by dnf5-offline-transaction.service (static, wanted by system-update.target). Not
# dnf5-automatic: it can only install into the running system (dnf5-plugin-automatic).
enable arctic-update-stage.timer
# Flatpak apps are updated in place, daily (arctic-update flatpak --auto; stream 5).
enable arctic-flatpak-update.timer
disable dnf5-automatic.timer
disable dnf-automatic.timer
# Snapper: the pre/post snapshots around dnf transactions (arctic-snapper.actions) are thinned
# out by the cleanup timer (NUMBER_LIMIT). No hourly timeline snapshots, no boot snapshots.
enable snapper-cleanup.timer
disable snapper-timeline.timer
disable snapper-boot.timer

# Nix: upstream socket activation starts the daemon on the first store request.
# The enforcing install/profile/GUI/reboot trial needs no SELinux policy change.
enable nix-daemon.socket
disable nix-daemon.service

# Live media: Fedora's livesys scripts set up the live user (also in 90-default.preset).
enable livesys.service
enable livesys-late.service

# Power profiles on laptops (tuned-ppd, as Fedora Workstation).
enable tuned.service
enable tuned-ppd.service

# No SSH server by default, as on Fedora's desktop editions (their 81-desktop.preset):
# 90-default.preset would enable it, and firewalld's default zone lets ssh in. Turn it on
# with `sudo systemctl enable --now sshd`.
disable sshd.service
disable sshd.socket

# Optional networking: installation alone does not enroll or connect this machine.
disable tor.service
disable tor-master.service
disable tor@*.service
disable tailscaled.service
