<?xml version="1.0" encoding="utf-8"?>

<!--
  Arctic Linux 0.2 live ISO (kiwi-ng 11, Fedora 44).

  Derived from fedora-kiwi-descriptions (branch f44): the LiveInstall profile
  (components/liveinstall.xml), BootCoreLive (components/boot.xml), BaseCommon/HardwareCommon
  (components/common.xml) and DesktopCommon, flattened into one image without profiles.
  Differences: arctic-release instead of fedora-release, the Arctic desktop instead of a Fedora
  desktop group, no Anaconda (arctic-installer), our own GRUB menu template and theme.

  Built by tools/build-iso.sh, which adds the local Arctic repository (out/repo) with
  kiwi-ng ... add-repo dir:///…/out/repo,rpm-md,arctic-local,1,false,false.
-->
<image schemaversion="7.4" name="Arctic-Linux" displayname="Arctic Linux">
	<description type="system">
		<author>Arctic Linux</author>
		<contact>https://github.com/yuvalkolodkingal/Arctic-Linux/issues</contact>
		<specification>Arctic Linux 0.2 live media (Fedora 44 base, Mango desktop)</specification>
	</description>

	<preferences>
		<version>0.2.1</version>
		<packagemanager>dnf5</packagemanager>
		<locale>en_US</locale>
		<keytable>us</keytable>
		<timezone>UTC</timezone>
		<release-version>44</release-version>
		<bootloader-theme>arctic</bootloader-theme>
		<type image="iso"
			publisher="Arctic Linux" volid="Arctic-Linux-0.2" application_id="Arctic-Linux-0.2"
			primary="true" flags="dmsquash" filesystem="erofs" erofscompression="lzma,level=6"
			fscreateoptions="-Efragments -C 1048576"
			mediacheck="true" firmware="uefi" efiparttable="gpt" efifatimagesize="30"
			kernelcmdline="quiet rhgb">
			<bootloader name="grub2" grub_template="grub-arctic.cfg.iso-template" console="gfxterm" timeout="5"/>
		</type>
	</preferences>

	<!-- Fedora 44 + updates (as fedora-kiwi-descriptions repositories/core.xml). -->
	<repository type="rpm-md" alias="fedora" sourcetype="metalink">
		<source path="https://mirrors.fedoraproject.org/metalink?repo=fedora-$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-$releasever-primary"/>
		</source>
	</repository>
	<repository type="rpm-md" alias="updates" sourcetype="metalink">
		<source path="https://mirrors.fedoraproject.org/metalink?repo=updates-released-f$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-$releasever-primary"/>
		</source>
	</repository>

	<packages type="bootstrap">
		<package name="filesystem"/>
		<!-- In place of fedora-release: its presets must exist before any unit is installed. -->
		<package name="arctic-release"/>
	</packages>

	<packages type="image" patternType="plusRecommended">
		<!-- BaseCommon / HardwareCommon / parts of DesktopCommon -->
		<namedCollection name="core"/>
		<namedCollection name="hardware-support"/>
		<namedCollection name="networkmanager-submodules"/>
		<namedCollection name="guest-desktop-agents"/>
		<!-- The Arctic desktop, the installer and the live session -->
		<package name="arctic-desktop"/>
		<!-- Arctic Settings (arctic-desktop requires it too; named so it is never left out)
		     and the tools its Network, Bluetooth and Sound pages open. -->
		<package name="arctic-settings"/>
		<package name="nm-connection-editor"/>
		<package name="blueman"/>
		<package name="pavucontrol"/>
		<package name="wlr-randr"/>
		<!-- Default apps the installer treats as already in the live image (in_live_image in
		     modules/): listed explicitly because arctic-desktop only recommends them. -->
		<package name="kitty"/>
		<package name="kitty-shell-integration"/>
		<package name="zsh"/>
		<package name="Thunar"/>
		<package name="vlc"/>
		<!-- stream 6: more themes and the terminal's Nerd Font symbols (arctic-shell recommends them). -->
		<package name="arctic-themes-extra"/>
		<package name="arctic-fonts-symbols"/>
		<!-- App theming (docs/BUILD-SPEC.md "App theming"; arctic-desktop-config requires them):
		     adw-gtk3 for GTK 3 apps, qt5ct/qt6ct for Qt 5 (VLC) and Qt 6 apps, btop (recommended
		     by arctic-desktop). Fedora builds qt5ct/qt6ct with KDE colour-scheme support, which
		     pulls KDE Frameworks 5/6 libraries, Breeze icons and plasma-breeze-common. -->
		<package name="adw-gtk3-theme"/>
		<package name="qt5ct"/>
		<package name="qt6ct"/>
		<package name="btop"/>
		<!-- fastfetch draws `fastfetch`, `neofetch` and the arctic-fetch greeting's info
		     (arctic-desktop-config requires it; named so it is never left out). -->
		<package name="fastfetch"/>
		<package name="arctic-installer"/>
		<package name="arctic-live"/>
		<package name="livesys-scripts"/>
		<!-- Kernel and boot (BootCoreLive) -->
		<package name="kernel"/>
		<package name="kernel-modules"/>
		<package name="kernel-modules-extra"/>
		<package name="dracut-live"/>
		<package name="grubby"/>
		<package name="grub2-efi-ia32"/>
		<package name="grub2-efi-ia32-modules"/>
		<package name="grub2-efi-x64"/>
		<package name="grub2-efi-x64-modules"/>
		<package name="grub2-pc"/>
		<package name="grub2-pc-modules"/>
		<package name="grub2-tools-extra"/>
		<package name="shim-signed-ia32"/>
		<package name="shim-signed-x64"/>
		<package name="efibootmgr"/>
		<package name="systemd-oomd-defaults"/>
		<package name="systemd-resolved"/>
		<package name="plymouth"/>
		<!-- LiveInstall: what the installer needs from the live system -->
		<!-- Locales for the installer's languages (internal/wizard/locale.go), not all 227 MB of
		     glibc-all-langpacks: keeps room for Zen under the 2 GiB release-asset limit. Add the
		     langpack here when the installer gains a language. -->
		<package name="glibc-langpack-en"/>
		<package name="glibc-langpack-he"/>
		<package name="glibc-langpack-de"/>
		<package name="glibc-langpack-es"/>
		<package name="glibc-langpack-fr"/>
		<package name="glibc-langpack-ja"/>
		<package name="glibc-langpack-ar"/>
		<package name="glibc-langpack-zh"/>
		<package name="glibc-langpack-cs"/>
		<package name="glibc-langpack-da"/>
		<package name="glibc-langpack-nl"/>
		<package name="glibc-langpack-fi"/>
		<package name="glibc-langpack-el"/>
		<package name="glibc-langpack-hu"/>
		<package name="glibc-langpack-it"/>
		<package name="glibc-langpack-ko"/>
		<package name="glibc-langpack-nb"/>
		<package name="glibc-langpack-pl"/>
		<package name="glibc-langpack-pt"/>
		<package name="glibc-langpack-ro"/>
		<package name="glibc-langpack-ru"/>
		<package name="glibc-langpack-sv"/>
		<package name="glibc-langpack-tr"/>
		<package name="glibc-langpack-uk"/>
		<package name="isomd5sum"/>
		<package name="btrfs-progs"/>
		<!-- Rollback: snapper snapshots around every dnf transaction on the installed system
		     (the installer copies this root and creates snapper's root configuration) -->
		<package name="snapper"/>
		<package name="libdnf5-plugin-actions"/>
		<package name="udisks2-btrfs"/>
		<package name="cryptsetup"/>
		<package name="rsync"/>
		<package name="distribution-gpg-keys"/>
		<package name="selinux-policy-targeted"/>
		<package name="policycoreutils"/>
		<!-- Desktop odds and ends -->
		<package name="google-noto-emoji-fonts"/>
		<package name="adwaita-cursor-theme"/>
		<package name="adwaita-icon-theme"/>
		<package name="bash-completion"/>
		<package name="nano"/>
		<!-- Time sync (Fedora presets enable chronyd; livesys adjusts chrony.conf) -->
		<package name="chrony"/>
		<!-- Never: Fedora branding, other greeters/display servers, Anaconda first boot -->
		<ignore name="fedora-release"/>
		<ignore name="fedora-release-*"/>
		<ignore name="fedora-logos"/>
		<ignore name="fedora-logos-*"/>
		<ignore name="generic-release*"/>
		<ignore name="generic-logos*"/>
		<ignore name="desktop-backgrounds-compat"/>
		<ignore name="f44-backgrounds*"/>
		<ignore name="sddm-wayland-generic"/>
		<ignore name="sddm-wayland-plasma"/>
		<ignore name="sddm-x11"/>
		<ignore name="sddm-themes"/>
		<ignore name="initial-setup"/>
		<ignore name="initial-setup-gui"/>
		<ignore name="kernel-*debug*"/>
		<ignore name="device-mapper-multipath"/>
		<ignore name="fcoe-utils"/>
		<ignore name="gfs2-utils"/>
		<ignore name="reiserfs-utils"/>
		<ignore name="qemu-user-static"/>
		<!-- Weak dependencies nothing here uses: EPS for kimageformats, cpp for xrdb (~70 MB) -->
		<ignore name="ghostscript"/>
		<ignore name="cpp"/>
		<ignore name="glibc-all-langpacks"/>
	</packages>

	<packages type="iso" patternType="plusRecommended">
		<!-- Filter unwanted EFI files out of the embedded ESP (rhbz#2358785), as Fedora does -->
		<file name="iso-esp-excludes.yaml" target="image/exclude_files_efifatimage.yaml"/>
		<package name="grub2-efi-ia32-cdboot"/>
		<package name="grub2-efi-x64-cdboot"/>
	</packages>
</image>
