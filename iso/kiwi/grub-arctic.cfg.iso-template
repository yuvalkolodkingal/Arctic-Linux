# Arctic Linux live USB boot menu (BIOS and UEFI).
#
# kiwi renders this file into /boot/grub2/grub.cfg on the ISO (bootloader grub_template in
# config.kiwi) with Python string.Template: dollar-brace names are kiwi's parameters and a
# doubled dollar is a literal one for GRUB (so no bare dollar signs, even in comments).
# Entries and copy: design components/BootMenu and docs/BUILD-SPEC.md section 7.
# boot_options = kernelcmdline from config.kiwi ("quiet rhgb") plus
#                root=live:CDLABEL=(volid) rd.live.image.

search ${search_params}
set default=0
set timeout=${boot_timeout}
set timeout_style=menu

insmod all_video
insmod gfxterm
insmod gfxmenu
insmod png
insmod font
insmod regexp
insmod gzio
insmod part_gpt
insmod part_msdos
insmod iso9660
insmod ext2

if [ "$${grub_platform}" = "efi" ]; then
	set basicgfx="nomodeset"
else
	set basicgfx="nomodeset vga=791"
fi

# Largest common mode first (BIOS VBE would otherwise pick 640x480).
set gfxmode=1920x1080,1600x900,1280x800,1280x720,1024x768,auto
set gfxpayload=keep
terminal_input console

# The arctic GRUB theme (package arctic-grub-theme, copied onto the ISO by kiwi through
# <bootloader-theme>). Without it, a plain text menu.
set arctic_theme=($$root)/boot/${boot_directory_name}/themes/arctic
if [ -f "$${arctic_theme}/theme.txt" ]; then
	if [ -f ($$root)/boot/${boot_directory_name}/fonts/unicode.pf2 ]; then
		loadfont ($$root)/boot/${boot_directory_name}/fonts/unicode.pf2
	fi
	for arctic_font in $${arctic_theme}/*.pf2; do
		loadfont "$${arctic_font}"
	done
	terminal_output gfxterm
	set theme="$${arctic_theme}/theme.txt"
	export theme
else
	terminal_output console
fi

menuentry "Try Arctic Linux" --class arctic --class gnu-linux --class os --id try {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} arctic.mode=try
	initrd ($$root)${bootpath}/${initrd_file}
}
menuentry "Install Arctic Linux" --class arctic --class gnu-linux --class os --id install {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} arctic.mode=install
	initrd ($$root)${bootpath}/${initrd_file}
}
menuentry "Safe graphics mode" --class arctic --class gnu-linux --class os --id safe {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} arctic.mode=try $${basicgfx}
	initrd ($$root)${bootpath}/${initrd_file}
}
menuentry "Check USB for errors" --class arctic --class gnu-linux --class os --id check {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} arctic.mode=try rd.live.check
	initrd ($$root)${bootpath}/${initrd_file}
}
menuentry "Boot from first disk" --class hd --id disk {
	if [ "$${grub_platform}" = "efi" ]; then
		# Back to the firmware, which boots its next entry (the internal disk).
		exit 1
	else
		# The first hard disk that is not this USB stick.
		set arctic_disk=hd0
		regexp --set=1:arctic_media '^(hd[0-9]+)' "$${root}"
		if [ "$${arctic_media}" = "hd0" ]; then
			set arctic_disk=hd1
		fi
		set root=$${arctic_disk}
		chainloader +1
		boot
	fi
}
