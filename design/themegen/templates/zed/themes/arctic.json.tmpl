{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Arctic",
  "author": "Arctic Linux (arctic-themegen: design/themegen/templates/zed/themes/arctic.json.tmpl, {{label}})",
  "themes": [
    {
      "name": "Arctic",
      "appearance": "{{mode}}",
      "style": {
        "background.appearance": "opaque",
        "accents": ["{{accent|hex}}", "{{info|hex}}", "{{success|hex}}", "{{ansi-5|hex}}", "{{ansi-6|hex}}", "{{warning|hex}}"],

        "background": "{{ground|hex}}",
        "surface.background": "{{surface|hex}}",
        "elevated_surface.background": "{{surface-raised|hex}}",
        "border": "{{line|hex}}",
        "border.variant": "{{line|hex}}",
        "border.focused": "{{focus|hex}}",
        "border.selected": "{{accent-edge|hex}}",
        "border.transparent": "#00000000",
        "border.disabled": "{{line|hex}}80",
        "drop_target.background": "{{accent|hex}}33",

        "element.background": "{{surface-raised|hex}}",
        "element.hover": "{{ink|hex}}14",
        "element.active": "{{ink|hex}}24",
        "element.selected": "{{accent-soft|hex}}",
        "element.disabled": "{{surface-sunken|hex}}",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{ink|hex}}14",
        "ghost_element.active": "{{ink|hex}}24",
        "ghost_element.selected": "{{accent-soft|hex}}",
        "ghost_element.disabled": "#00000000",

        "text": "{{ink|hex}}",
        "text.muted": "{{ink-muted|hex}}",
        "text.placeholder": "{{ink-subtle|hex}}",
        "text.disabled": "{{ink-disabled|hex}}",
        "text.accent": "{{accent-text|hex}}",
        "icon": "{{ink|hex}}",
        "icon.muted": "{{ink-muted|hex}}",
        "icon.disabled": "{{ink-disabled|hex}}",
        "icon.placeholder": "{{ink-subtle|hex}}",
        "icon.accent": "{{accent-text|hex}}",
        "link_text.hover": "{{info|hex}}",

        "title_bar.background": "{{ground|hex}}",
        "title_bar.inactive_background": "{{ground|hex}}",
        "status_bar.background": "{{ground|hex}}",
        "toolbar.background": "{{surface|hex}}",
        "tab_bar.background": "{{ground|hex}}",
        "tab.inactive_background": "{{ground|hex}}",
        "tab.active_background": "{{surface|hex}}",
        "panel.background": "{{ground|hex}}",
        "panel.focused_border": "{{focus|hex}}",
        "panel.indent_guide": "{{line|hex}}",
        "panel.indent_guide_active": "{{line-strong|hex}}",
        "panel.indent_guide_hover": "{{line-strong|hex}}",
        "pane.focused_border": "{{line-strong|hex}}",
        "pane_group.border": "{{line|hex}}",
        "search.match_background": "{{accent|hex}}40",
        "scrollbar.thumb.background": "{{line-strong|hex}}66",
        "scrollbar.thumb.hover_background": "{{line-strong|hex}}b3",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",

        "editor.foreground": "{{ink|hex}}",
        "editor.background": "{{surface|hex}}",
        "editor.gutter.background": "{{surface|hex}}",
        "editor.subheader.background": "{{ground|hex}}",
        "editor.active_line.background": "{{ink|hex}}0d",
        "editor.highlighted_line.background": "{{accent|hex}}1a",
        "editor.line_number": "{{ink-disabled|hex}}",
        "editor.active_line_number": "{{ink-muted|hex}}",
        "editor.invisible": "{{ink-disabled|hex}}",
        "editor.wrap_guide": "{{line|hex}}",
        "editor.active_wrap_guide": "{{line-strong|hex}}",
        "editor.indent_guide": "{{line|hex}}",
        "editor.indent_guide_active": "{{line-strong|hex}}",
        "editor.document_highlight.read_background": "{{info|hex}}26",
        "editor.document_highlight.write_background": "{{warning|hex}}26",
        "editor.document_highlight.bracket_background": "{{accent|hex}}26",

        "terminal.background": "{{term-background|hex}}",
        "terminal.foreground": "{{term-foreground|hex}}",
        "terminal.bright_foreground": "{{ansi-15|hex}}",
        "terminal.dim_foreground": "{{ink-subtle|hex}}",
        "terminal.ansi.background": "{{term-background|hex}}",
        "terminal.ansi.black": "{{ansi-0|hex}}",
        "terminal.ansi.red": "{{ansi-1|hex}}",
        "terminal.ansi.green": "{{ansi-2|hex}}",
        "terminal.ansi.yellow": "{{ansi-3|hex}}",
        "terminal.ansi.blue": "{{ansi-4|hex}}",
        "terminal.ansi.magenta": "{{ansi-5|hex}}",
        "terminal.ansi.cyan": "{{ansi-6|hex}}",
        "terminal.ansi.white": "{{ansi-7|hex}}",
        "terminal.ansi.bright_black": "{{ansi-8|hex}}",
        "terminal.ansi.bright_red": "{{ansi-9|hex}}",
        "terminal.ansi.bright_green": "{{ansi-10|hex}}",
        "terminal.ansi.bright_yellow": "{{ansi-11|hex}}",
        "terminal.ansi.bright_blue": "{{ansi-12|hex}}",
        "terminal.ansi.bright_magenta": "{{ansi-13|hex}}",
        "terminal.ansi.bright_cyan": "{{ansi-14|hex}}",
        "terminal.ansi.bright_white": "{{ansi-15|hex}}",
        "terminal.ansi.dim_black": "{{ansi-0|hex}}",
        "terminal.ansi.dim_red": "{{ansi-1|hex}}",
        "terminal.ansi.dim_green": "{{ansi-2|hex}}",
        "terminal.ansi.dim_yellow": "{{ansi-3|hex}}",
        "terminal.ansi.dim_blue": "{{ansi-4|hex}}",
        "terminal.ansi.dim_magenta": "{{ansi-5|hex}}",
        "terminal.ansi.dim_cyan": "{{ansi-6|hex}}",
        "terminal.ansi.dim_white": "{{ansi-7|hex}}",

        "conflict": "{{warning|hex}}",
        "conflict.background": "{{warning-soft|hex}}",
        "conflict.border": "{{warning|hex}}",
        "created": "{{success|hex}}",
        "created.background": "{{success-soft|hex}}",
        "created.border": "{{success|hex}}",
        "deleted": "{{error|hex}}",
        "deleted.background": "{{error-soft|hex}}",
        "deleted.border": "{{error|hex}}",
        "error": "{{error|hex}}",
        "error.background": "{{error-soft|hex}}",
        "error.border": "{{error|hex}}",
        "hidden": "{{ink-subtle|hex}}",
        "hidden.background": "{{surface-sunken|hex}}",
        "hidden.border": "{{line|hex}}",
        "hint": "{{ink-subtle|hex}}",
        "hint.background": "{{info-soft|hex}}",
        "hint.border": "{{line|hex}}",
        "ignored": "{{ink-disabled|hex}}",
        "ignored.background": "{{surface-sunken|hex}}",
        "ignored.border": "{{line|hex}}",
        "info": "{{info|hex}}",
        "info.background": "{{info-soft|hex}}",
        "info.border": "{{info|hex}}",
        "modified": "{{accent-text|hex}}",
        "modified.background": "{{accent-soft|hex}}",
        "modified.border": "{{accent-edge|hex}}",
        "predictive": "{{ink-subtle|hex}}",
        "predictive.background": "{{surface-sunken|hex}}",
        "predictive.border": "{{line|hex}}",
        "renamed": "{{info|hex}}",
        "renamed.background": "{{info-soft|hex}}",
        "renamed.border": "{{info|hex}}",
        "success": "{{success|hex}}",
        "success.background": "{{success-soft|hex}}",
        "success.border": "{{success|hex}}",
        "unreachable": "{{ink-disabled|hex}}",
        "unreachable.background": "{{surface-sunken|hex}}",
        "unreachable.border": "{{line|hex}}",
        "warning": "{{warning|hex}}",
        "warning.background": "{{warning-soft|hex}}",
        "warning.border": "{{warning|hex}}",

        "players": [
          { "cursor": "{{accent|hex}}", "background": "{{accent|hex}}", "selection": "{{accent|hex}}3d" },
          { "cursor": "{{info|hex}}", "background": "{{info|hex}}", "selection": "{{info|hex}}3d" },
          { "cursor": "{{success|hex}}", "background": "{{success|hex}}", "selection": "{{success|hex}}3d" },
          { "cursor": "{{ansi-5|hex}}", "background": "{{ansi-5|hex}}", "selection": "{{ansi-5|hex}}3d" },
          { "cursor": "{{ansi-6|hex}}", "background": "{{ansi-6|hex}}", "selection": "{{ansi-6|hex}}3d" },
          { "cursor": "{{error|hex}}", "background": "{{error|hex}}", "selection": "{{error|hex}}3d" }
        ],

        "syntax": {
          "attribute": { "color": "{{ansi-3|hex}}" },
          "boolean": { "color": "{{ansi-11|hex}}" },
          "comment": { "color": "{{ink-subtle|hex}}", "font_style": "italic" },
          "comment.doc": { "color": "{{ink-subtle|hex}}", "font_style": "italic" },
          "constant": { "color": "{{ansi-11|hex}}" },
          "constructor": { "color": "{{ansi-12|hex}}" },
          "embedded": { "color": "{{ink|hex}}" },
          "emphasis": { "color": "{{accent-text|hex}}", "font_style": "italic" },
          "emphasis.strong": { "color": "{{accent-text|hex}}", "font_weight": 700 },
          "enum": { "color": "{{ansi-6|hex}}" },
          "function": { "color": "{{ansi-4|hex}}" },
          "hint": { "color": "{{ink-subtle|hex}}" },
          "keyword": { "color": "{{ansi-5|hex}}" },
          "label": { "color": "{{accent-text|hex}}" },
          "link_text": { "color": "{{info|hex}}" },
          "link_uri": { "color": "{{info|hex}}", "font_style": "italic" },
          "number": { "color": "{{ansi-11|hex}}" },
          "operator": { "color": "{{ansi-6|hex}}" },
          "predictive": { "color": "{{ink-subtle|hex}}", "font_style": "italic" },
          "preproc": { "color": "{{ansi-5|hex}}" },
          "primary": { "color": "{{ink|hex}}" },
          "property": { "color": "{{ansi-12|hex}}" },
          "punctuation": { "color": "{{ink-muted|hex}}" },
          "punctuation.bracket": { "color": "{{ink-muted|hex}}" },
          "punctuation.delimiter": { "color": "{{ink-muted|hex}}" },
          "punctuation.list_marker": { "color": "{{accent-text|hex}}" },
          "punctuation.special": { "color": "{{ansi-13|hex}}" },
          "string": { "color": "{{ansi-2|hex}}" },
          "string.escape": { "color": "{{ansi-13|hex}}" },
          "string.regex": { "color": "{{ansi-14|hex}}" },
          "string.special": { "color": "{{ansi-14|hex}}" },
          "string.special.symbol": { "color": "{{ansi-6|hex}}" },
          "tag": { "color": "{{ansi-4|hex}}" },
          "text.literal": { "color": "{{ansi-2|hex}}" },
          "title": { "color": "{{accent-text|hex}}", "font_weight": 700 },
          "type": { "color": "{{ansi-6|hex}}" },
          "variable": { "color": "{{ink|hex}}" },
          "variable.special": { "color": "{{accent-text|hex}}" },
          "variant": { "color": "{{ansi-6|hex}}" }
        }
      }
    }
  ]
}
