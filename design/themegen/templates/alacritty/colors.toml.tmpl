# Arctic Linux — {{label}} for Alacritty (terminal; kitty is the default).
# Rendered by arctic-themegen from design/themegen/templates/alacritty/colors.toml.tmpl.
# ~/.config/alacritty/alacritty.toml imports ~/.config/arctic/current/alacritty/colors.toml.
# Same palette as kitty (the term-* and ansi-* tokens).

[colors.primary]
background = "{{term-background|hex}}"
foreground = "{{term-foreground|hex}}"

[colors.cursor]
text = "{{term-cursor-text-color|hex}}"
cursor = "{{term-cursor|hex}}"

[colors.selection]
text = "{{term-selection-foreground|hex}}"
background = "{{term-selection-background|hex}}"

[colors.hints.start]
foreground = "{{on-accent|hex}}"
background = "{{accent|hex}}"

[colors.hints.end]
foreground = "{{ink|hex}}"
background = "{{accent-soft|hex}}"

[colors.search.matches]
foreground = "{{on-accent|hex}}"
background = "{{accent-soft|hex}}"

[colors.search.focused_match]
foreground = "{{on-accent|hex}}"
background = "{{accent|hex}}"

[colors.normal]
black = "{{ansi-0|hex}}"
red = "{{ansi-1|hex}}"
green = "{{ansi-2|hex}}"
yellow = "{{ansi-3|hex}}"
blue = "{{ansi-4|hex}}"
magenta = "{{ansi-5|hex}}"
cyan = "{{ansi-6|hex}}"
white = "{{ansi-7|hex}}"

[colors.bright]
black = "{{ansi-8|hex}}"
red = "{{ansi-9|hex}}"
green = "{{ansi-10|hex}}"
yellow = "{{ansi-11|hex}}"
blue = "{{ansi-12|hex}}"
magenta = "{{ansi-13|hex}}"
cyan = "{{ansi-14|hex}}"
white = "{{ansi-15|hex}}"
