# Generated by arctic-themegen from the {{label}} palette — do not edit by hand.
# Arctic Linux — {{label}} (mako). Spec: components/Notification, components/OSD.
font={{font.sans}} 10
width=340
height=160
margin=12
padding=12,16
border-size=1
border-radius=14
icons=1
max-icon-size=36
icon-location=left
background-color={{surface-raised}}
text-color={{ink}}
border-color={{line}}
progress-color=over {{accent}}
default-timeout=6000
ignore-timeout=0
layer=overlay
anchor=top-right
max-visible=4
format=<b>%s</b>\n<span color="{{ink-muted|hex}}">%b</span>
# Left click runs a notification's main action (a screenshot opens); middle click lists its
# other actions (Show in Files, Edit, Move to Trash…) in fuzzel.
on-button-middle=exec makoctl menu -n "$id" -- fuzzel --dmenu --prompt "Action  "

[hidden]
format=<span color="{{ink-subtle|hex}}">%h more</span>

[urgency=critical]
border-color={{error}}
default-timeout=0

[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0

# On-screen display for volume and brightness (arctic-osd): 280x48 pill, bottom centre.
[app-name=arctic-osd]
anchor=bottom-center
margin=44
width=280
height=48
padding=14,16
border-radius=24
background-color={{frost}}
icons=1
max-icon-size=20
default-timeout=1200
format=<b>%s</b>
progress-color=over {{accent}}
