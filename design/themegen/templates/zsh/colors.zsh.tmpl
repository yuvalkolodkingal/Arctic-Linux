# Arctic Linux — {{label}}: colours for zsh (prompt, completion menu, plugins).
# Rendered by arctic-themegen from design/themegen/templates/zsh/colors.zsh.tmpl.
# ~/.zshrc sources ~/.config/arctic/current/zsh/colors.zsh, and sources it again before the
# next prompt whenever the theme changes, so open terminals follow a theme switch.

typeset -g ARCTIC_THEME_MODE={{mode}}

# Prompt colours ("~/projects ❯"): directory, arrow, arrow after a failed command, git branch.
# Used as 24-bit colours when the terminal supports them (COLORTERM=truecolor); otherwise the
# prompt keeps ANSI colours 2, 3, 1 and 8, which the terminal's own palette maps.
typeset -gA ARCTIC_PROMPT_COLORS
ARCTIC_PROMPT_COLORS=(
  dir   '{{ansi-2|hex}}'
  arrow '{{accent-text|hex}}'
  error '{{error|hex}}'
  git   '{{ink-subtle|hex}}'
)

# Completion menu (menu select): the selected entry on accent-soft, as in the launcher.
typeset -g ARCTIC_MENU_SELECTION="48;2;{{accent-soft|rgb}};38;2;{{ink|rgb}}"
ARCTIC_MENU_SELECTION=${ARCTIC_MENU_SELECTION//, /;}

# zsh-autosuggestions and zsh-syntax-highlighting, if you install them.
typeset -g ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg={{ink-subtle|hex}}'
typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg={{ansi-2|hex}}'
ZSH_HIGHLIGHT_STYLES[builtin]='fg={{ansi-2|hex}}'
ZSH_HIGHLIGHT_STYLES[alias]='fg={{ansi-2|hex}}'
ZSH_HIGHLIGHT_STYLES[function]='fg={{ansi-4|hex}}'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg={{ansi-5|hex}}'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg={{error|hex}}'
ZSH_HIGHLIGHT_STYLES[path]='fg={{ink|hex}},underline'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg={{accent-text|hex}}'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg={{accent-text|hex}}'
ZSH_HIGHLIGHT_STYLES[comment]='fg={{ink-subtle|hex}}'
