# Arctic Linux — {{label}} for foot (terminal; kitty is the default).
# Rendered by arctic-themegen from design/themegen/templates/foot/colors.ini.tmpl.
# ~/.config/foot/foot.ini includes ~/.config/arctic/current/foot/colors.ini; new foot windows
# use the active theme. Same palette as kitty (the term-* and ansi-* tokens).
[main]
initial-color-theme={{mode}}

[colors-{{mode}}]
background={{term-background|nohash}}
foreground={{term-foreground|nohash}}
cursor={{term-cursor-text-color|nohash}} {{term-cursor|nohash}}
selection-foreground={{term-selection-foreground|nohash}}
selection-background={{term-selection-background|nohash}}
urls={{info|nohash}}
regular0={{ansi-0|nohash}}
regular1={{ansi-1|nohash}}
regular2={{ansi-2|nohash}}
regular3={{ansi-3|nohash}}
regular4={{ansi-4|nohash}}
regular5={{ansi-5|nohash}}
regular6={{ansi-6|nohash}}
regular7={{ansi-7|nohash}}
bright0={{ansi-8|nohash}}
bright1={{ansi-9|nohash}}
bright2={{ansi-10|nohash}}
bright3={{ansi-11|nohash}}
bright4={{ansi-12|nohash}}
bright5={{ansi-13|nohash}}
bright6={{ansi-14|nohash}}
bright7={{ansi-15|nohash}}
