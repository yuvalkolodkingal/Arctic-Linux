#!/usr/bin/env python3
"""arctic-gpu — run an app on the offload graphics chip selected by switcheroo-control.

    arctic-gpu status [--json]     the graphics chips switcheroo-control knows, whether another
                                   chip is available for offload, and the apps that ask for it
                                   (PrefersNonDefaultGPU=true in their desktop entry)
    arctic-gpu run COMMAND…        run COMMAND on the offload chip (switcherooctl launch sets
                                   the variables that chip's driver needs, e.g. NVIDIA's PRIME ones)

The launcher can use it for Shift + Enter, and for apps whose entry prefers the other chip.
Each status prints one JSON line; failures print {"ok": false, "error": "…"} and exit 1.
"""
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path


class Failure(Exception):
    """A sentence for the person."""


def launch_environment(value):
    """Recognize opaque NAME=value metadata, without applying or interpreting its values."""
    assignments = value.split()
    names = set()
    for assignment in assignments:
        name, separator, content = assignment.partition('=')
        if not separator or not content or not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', name) or name in names:
            return False
        names.add(name)
    return bool(assignments)


def gpus():
    """`switcherooctl list` → [{index, name, default, discrete, offload}] ([] without the service).

    Discrete is the provider's hardware flag. Older versions omit it; their non-default
    GPU with launch metadata is an offload target, without claiming it is physically discrete.
    """
    if not shutil.which('switcherooctl'):
        return []
    try:
        result = subprocess.run(['switcherooctl', 'list'], capture_output=True, text=True, timeout=10,
                                env=dict(os.environ, LC_ALL='C'))
    except (OSError, subprocess.SubprocessError):
        return []
    if result.returncode:
        return []
    found = []
    current = None
    for line in result.stdout.splitlines():
        key, separator, value = line.strip().partition(':')
        field = key.split(None, 1)[0] if key else ''
        value = value.strip()
        if field == 'Device':
            # Never invent an ID for a malformed record or attach its fields to the previous GPU.
            current = None
            if key == 'Device' and separator and re.fullmatch(r'[0-9]{1,10}', value) and int(value) < 2**31:
                current = dict(index=int(value), name='', default=False, discrete=False,
                               _default=None, _discrete=None, _environment=False, _seen=set(), _valid=True)
                found.append(current)
        elif current is not None and field in ('Name', 'Default', 'Discrete', 'Environment'):
            if field in current['_seen'] or key != field or not separator:
                current['_valid'] = False
            current['_seen'].add(field)
            if field == 'Name':
                current['name'] = value
            elif field == 'Default':
                current['_default'] = value.lower() if value.lower() in ('yes', 'no') else None
                current['default'] = current['_default'] == 'yes'
            elif field == 'Discrete':
                # A present but invalid flag must not enable the older-format fallback.
                current['_discrete'] = value.lower()
                current['discrete'] = current['_discrete'] == 'yes'
            elif field == 'Environment':
                current['_environment'] = launch_environment(value)
    counts = {}
    for gpu in found:
        counts[gpu['index']] = counts.get(gpu['index'], 0) + 1
    found = [gpu for gpu in found if counts[gpu['index']] == 1]
    declared_default = sum(gpu['_default'] == 'yes' for gpu in found) == 1
    declared_default = declared_default and all(gpu['_valid'] and gpu['_default'] is not None for gpu in found)
    for gpu in found:
        if not gpu['_valid']:
            gpu['discrete'] = False
        gpu['offload'] = bool(declared_default and gpu['_default'] == 'no' and gpu['name'] and (
            gpu['_discrete'] == 'yes' or (gpu['_discrete'] is None and gpu['_environment'])))
        del gpu['_default'], gpu['_discrete'], gpu['_environment'], gpu['_seen'], gpu['_valid']
    return found


def data_dirs():
    home = Path(os.environ.get('HOME') or Path.home())
    dirs = [Path(os.environ.get('XDG_DATA_HOME') or home / '.local/share')]
    dirs += [Path(d) for d in (os.environ.get('XDG_DATA_DIRS') or '/usr/local/share:/usr/share').split(':') if d]
    dirs += [home / '.local/share/flatpak/exports/share', Path('/var/lib/flatpak/exports/share')]
    return dirs


def prefers():
    """Desktop ids whose entry asks for the other chip."""
    out = []
    seen = set()
    for folder in data_dirs():
        apps = folder / 'applications'
        if not apps.is_dir():
            continue
        for path in sorted(apps.rglob('*.desktop')):
            ident = str(path.relative_to(apps))[:-8].replace('/', '-')
            if ident in seen:
                continue
            seen.add(ident)
            try:
                text = path.read_text(encoding='utf-8', errors='replace')
            except OSError:
                continue
            section = ''
            for line in text.splitlines():
                line = line.strip()
                if line.startswith('['):
                    section = line
                elif section == '[Desktop Entry]' and line.replace(' ', '') in (
                        'PrefersNonDefaultGPU=true', 'X-KDE-RunOnDiscreteGpu=true'):
                    out.append(ident)
                    break
    return out


def main(argv):
    verb = argv[0] if argv else 'status'
    if verb in ('-h', '--help'):
        print(__doc__.strip())
        return 0
    if verb == 'status':
        found = gpus()
        hybrid = len(found) > 1 and any(g['offload'] for g in found)
        discrete = next((g['name'] for g in found if g['discrete'] and not g['default']), '')
        result = dict(ok=True, hybrid=hybrid, discrete=discrete, gpus=found, prefers=prefers() if hybrid else [])
        if '--json' not in argv[1:]:
            alternate = next((g['name'] for g in found if g['offload']), '')
            print('Hybrid graphics: {}'.format('yes, the offload chip is ' + alternate if hybrid else 'no'))
            return 0
        print(json.dumps(result))
        return 0
    if verb == 'run' and len(argv) > 1:
        if not shutil.which('switcherooctl'):
            raise Failure('Running on the other graphics chip needs switcheroo-control.')
        os.execvp('switcherooctl', ['switcherooctl', 'launch'] + argv[1:])
    print('usage: arctic-gpu status [--json] | run COMMAND…', file=sys.stderr)
    return 2


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except Failure as error:
        print(json.dumps(dict(ok=False, error=str(error))))
        sys.exit(1)
