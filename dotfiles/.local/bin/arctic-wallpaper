#!/usr/bin/env bash
# arctic-wallpaper — draw the wallpaper with swaybg.
#
#   arctic-wallpaper             the saved choice, else the theme's default
#                                (Winter: snowfield, Polar night: aurora)
#   arctic-wallpaper fox         pick a wallpaper (snowfield, aurora, fox); it follows theme switches
#   arctic-wallpaper render      only render the PNG cache (used by arctic-lock)
#
# The design ships wallpapers as 1920×1080 SVGs, one per theme; they are rendered once to
# 3840×2160 PNGs in ~/.cache/arctic/wallpapers (rsvg-convert), falling back to the SVG itself.
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/arctic"
SRC="${XDG_DATA_HOME:-$HOME/.local/share}/arctic/wallpapers"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/arctic/wallpapers"
# shellcheck source=/dev/null
source "$CONF/current/theme.env"

render() {   # render <file-stem> -> prints the image path to use
  local svg="$SRC/$1.svg" png="$CACHE/$1.png"
  if [[ -f "$png" && "$png" -nt "$svg" ]]; then echo "$png"; return; fi
  if command -v rsvg-convert >/dev/null 2>&1; then
    mkdir -p "$CACHE"
    if rsvg-convert -w 3840 -h 2160 -o "$png.tmp" "$svg"; then mv "$png.tmp" "$png"; echo "$png"; return; fi
  fi
  echo "$svg"
}

case "${1:-}" in
  render)
    for f in "$SRC"/*.svg; do render "$(basename "$f" .svg)" >/dev/null; done
    exit 0 ;;
  snowfield|aurora|fox)
    printf '%s\n' "$1" > "$CONF/wallpaper"
    stem="$1-$ARCTIC_THEME" ;;
  "")
    if [[ -s "$CONF/wallpaper" ]]; then stem="$(cat "$CONF/wallpaper")-$ARCTIC_THEME"; else stem="$ARCTIC_WALLPAPER"; fi ;;
  *)
    echo "usage: arctic-wallpaper [snowfield|aurora|fox|render]" >&2; exit 2 ;;
esac

[[ -f "$SRC/$stem.svg" ]] || stem="$ARCTIC_WALLPAPER"
img="$(render "$stem")"

# Replace the running swaybg without a flash: start the new one, then stop the old.
old="$(pgrep -x swaybg || true)"
setsid -f swaybg -m fill -c "$ARCTIC_GROUND" -i "$img" >/dev/null 2>&1
sleep 0.3
if [[ -n "$old" ]]; then kill $old 2>/dev/null || true; fi
