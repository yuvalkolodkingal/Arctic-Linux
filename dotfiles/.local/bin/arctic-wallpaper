#!/usr/bin/env bash
# arctic-wallpaper — draw the wallpaper with swaybg.
#
#   arctic-wallpaper                    the saved choice, else the theme's default
#                                       (Winter: snowfield, Polar night: aurora)
#   arctic-wallpaper fox                an Arctic wallpaper (snowfield, aurora, fox); it follows theme switches
#   arctic-wallpaper ~/Pictures/x.jpg   any picture of your own (stays the same across theme switches)
#   arctic-wallpaper render             only render the PNG cache (used by arctic-lock)
#   arctic-wallpaper current            print the picture in use
#   arctic-wallpaper rotate 30m|1h|1d [FOLDER|arctic] [--shuffle]
#                                       change the picture every 30 minutes, hour or day, from
#                                       FOLDER (default: your wallpaper folder) or Arctic's own
#   arctic-wallpaper rotate off|apply   stop, or start again at login (autostart.conf)
#   arctic-wallpaper rotate             print the rotation as JSON
#   arctic-wallpaper next               the next picture now (what the rotation runs)
#
# Arctic wallpapers are looked up in ~/.local/share/arctic/wallpapers, then
# /usr/share/backgrounds/arctic: 1920×1080 SVGs, one per theme (plus rendered PNGs when packaged).
# SVGs are rendered once to 3840×2160 PNGs in ~/.cache/arctic/wallpapers (rsvg-convert).
# The choice is saved in ~/.config/arctic/wallpaper (a name or a path). The picture actually
# drawn is recorded in ~/.cache/arctic/wallpaper-current (the lock screen blurs it).
# The wallpaper picker in the shell (launcher → Wallpapers) uses this command too.
#
# Choosing a wallpaper also runs `arctic-theme sync`: with auto colours on (the default), your
# own pictures colour the desktop (the 'wallpaper' theme) and Arctic's wallpapers bring back
# Winter / Polar night. ARCTIC_WALLPAPER_NO_SYNC=1 skips that. A new choice also runs your
# wallpaper hooks (arctic-hook wallpaper PICTURE).
#
# Rotation changes the wallpaper and the colours with it: each picture is saved as your choice
# and the desktop follows (your pictures colour it, Arctic's bring back Winter / Polar night),
# so the rotation never leaves the colours behind. It is kept in
# ~/.config/arctic/wallpaper-rotate.json and runs as the transient systemd user timer
# arctic-wallpaper-rotate; in shuffle order every picture comes once per round.
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/arctic"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/arctic"
CACHE="$CACHE_DIR/wallpapers"
DIRS=("${XDG_DATA_HOME:-$HOME/.local/share}/arctic/wallpapers" "${ARCTIC_BACKGROUNDS_DIR:-/usr/share/backgrounds/arctic}")
NAMES="snowfield aurora fox"

load_theme() {   # the active theme's theme.env; VARIANT = which design wallpapers fit it
  local env_file="$CONF/current/theme.env"
  [[ -f "$env_file" ]] || env_file=/usr/share/arctic/themes/polar-night/theme.env
  ARCTIC_THEME="" ARCTIC_THEME_BASE="" ARCTIC_THEME_MODE="" ARCTIC_WALLPAPER="" ARCTIC_GROUND=""
  # shellcheck source=/dev/null
  [[ -f "$env_file" ]] && source "$env_file"
  ARCTIC_THEME="${ARCTIC_THEME:-polar-night}"
  if [[ -z "$ARCTIC_WALLPAPER" ]]; then
    for d in "${DIRS[@]}"; do
      if [[ -f "$d/default.jpg" ]]; then ARCTIC_WALLPAPER="$d/default.jpg"; break; fi
    done
  fi
  ARCTIC_WALLPAPER="${ARCTIC_WALLPAPER:-aurora-polar-night}"
  ARCTIC_GROUND="${ARCTIC_GROUND:-#12171e}"
  # Arctic's wallpapers come in a Winter and a Polar night drawing: the theme's own, or (for
  # themes made from a picture or your own) the one matching light / dark.
  case "${ARCTIC_THEME_BASE:-$ARCTIC_THEME}" in
    winter|polar-night) VARIANT="${ARCTIC_THEME_BASE:-$ARCTIC_THEME}" ;;
    *) if [[ "${ARCTIC_THEME_MODE:-dark}" == light ]]; then VARIANT=winter; else VARIANT=polar-night; fi ;;
  esac
}
load_theme

sync_colours() {   # after a new choice: colours follow the wallpaper (arctic-theme decides)
  [[ "${ARCTIC_WALLPAPER_NO_SYNC:-0}" == 1 ]] && return 0
  command -v arctic-theme >/dev/null 2>&1 || return 0
  arctic-theme sync --no-redraw || echo "arctic-wallpaper: the colours could not follow the wallpaper" >&2
  load_theme
}

find_design() {   # find_design <stem> -> the PNG (preferred) or SVG for it
  local d
  for d in "${DIRS[@]}"; do
    if [[ -f "$d/$1.png" ]]; then echo "$d/$1.png"; return 0; fi
    if [[ -f "$d/$1.svg" ]]; then echo "$d/$1.svg"; return 0; fi
  done
  return 1
}

render() {   # render <image> -> an image swaybg draws well (SVGs rendered to a cached PNG)
  local src="$1" png
  if [[ "$src" != *.svg ]]; then echo "$src"; return; fi
  png="$CACHE/$(basename "$src" .svg).png"
  if [[ -f "$png" && "$png" -nt "$src" ]]; then echo "$png"; return; fi
  if command -v rsvg-convert >/dev/null 2>&1; then
    mkdir -p "$CACHE"
    if rsvg-convert -w 3840 -h 2160 -o "$png.tmp" "$src"; then mv "$png.tmp" "$png"; echo "$png"; return; fi
    rm -f "$png.tmp"
  fi
  echo "$src"
}

is_name() { [[ " $NAMES " == *" $1 "* ]]; }

design_name() {   # design_name PICTURE: the Arctic wallpaper a rotated picture is one of, or ''
  local img="$1" n v
  for n in $NAMES; do
    for v in winter polar-night; do
      [[ "$img" == "$(find_design "$n-$v" || true)" ]] && { echo "$n"; return 0; }
    done
  done
  return 1
}

# detach CMD…: start CMD in the background, in a systemd scope of its own when there is a user
# manager. The rotation timer and arctic-daylight run this script as a service, and systemd stops
# whatever is left in a service's cgroup when the service ends: swaybg would go with it.
detach() {
  if command -v systemd-run >/dev/null 2>&1 \
      && systemd-run --user --scope --quiet --collect -- setsid -f "$@" 9>&- >/dev/null 2>&1; then
    return 0
  fi
  setsid -f "$@" 9>&- >/dev/null 2>&1
}

# ---- rotation (stream 6) ----
ROTATE="$CONF/wallpaper-rotate.json"
QUEUE="$CACHE_DIR/wallpaper-rotate-queue"

rotate_get() {   # rotate_get KEY: one value of wallpaper-rotate.json ('' when missing)
  [[ -f "$ROTATE" ]] || return 0
  python3 -c 'import json,sys
try: v = json.load(open(sys.argv[1])).get(sys.argv[2], "")
except Exception: v = ""
print("1" if v is True else "" if v is False else v)' "$ROTATE" "$1" 2>/dev/null || true
}

your_folder() {   # the wallpaper picker's folder (wallpapers.py): its setting, else ~/Pictures/Wallpapers
  local f="" pics=""
  if [[ -f "$CONF/wallpapers.json" ]]; then
    f="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("folder") or "")' "$CONF/wallpapers.json" 2>/dev/null || true)"
  fi
  if [[ -z "$f" ]]; then
    pics="$(xdg-user-dir PICTURES 2>/dev/null || true)"
    [[ -n "$pics" && "$pics" != "$HOME" ]] || pics="$HOME/Pictures"
    f="$pics/Wallpapers"
  fi
  echo "${f/#\~/$HOME}"
}

rotation_pictures() {   # rotation_pictures FOLDER|arctic: the pictures to rotate through, sorted
  local n f photos
  if [[ "$1" == arctic ]]; then
    for f in "${DIRS[@]}"; do
      if [[ -f "$f/collection.json" ]]; then
        photos=$(python3 - "$f" <<'PY'
import json, re, sys
from pathlib import Path
folder = Path(sys.argv[1])
try:
    data = json.loads((folder / 'collection.json').read_text())
    assert data['schema'] == 1
    photos = []
    for item in data['wallpapers']:
        slug = item['slug']
        if not re.fullmatch('[a-z0-9]+(?:-[a-z0-9]+)*', slug) or item['file'] != slug + '.jpg':
            continue
        photo = folder / item['file']
        if photo.is_file() and not photo.is_symlink():
            photos.append(str(photo.resolve()))
    print('\n'.join(photos), end='')
except (OSError, ValueError, KeyError, TypeError, AssertionError):
    sys.exit(1)
PY
        ) || continue
        [[ -n "$photos" ]] || continue
        printf '%s\n' "$photos"
        return 0
      fi
    done
    for n in $NAMES; do find_design "$n-$VARIANT" || true; done
    return 0
  fi
  [[ -d "$1" ]] || return 0
  find "$1" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \
    -o -iname '*.bmp' -o -iname '*.gif' -o -iname '*.svg' -o -iname '*.tif' -o -iname '*.tiff' \) -print \
    | LC_ALL=C sort | while IFS= read -r f; do readlink -f "$f"; done
}

is_drawn() {   # is_drawn PICTURE NOW: is PICTURE the one drawn now (an SVG: its rendered PNG)
  [[ "$1" == "$2" ]] || [[ "$1" == *.svg && "$2" == "$CACHE/$(basename "$1" .svg).png" ]]
}

next_picture() {   # next_picture FOLDER SHUFFLE: the picture after the one drawn now
  local folder="$1" shuffle="$2" now all pick="" line found=0 left others=""
  now="$(cat "$CACHE_DIR/wallpaper-current" 2>/dev/null || true)"
  all="$(rotation_pictures "$folder")"
  [[ -n "$all" ]] || return 1
  if [[ -n "$shuffle" ]]; then
    mkdir -p "$CACHE_DIR"
    # A round: every picture once, in random order, then a new round. The queue file holds the
    # folder, then the pictures left in this round (only ones still there count).
    left=""
    if [[ -f "$QUEUE" && "$(head -n1 "$QUEUE")" == "# $folder" ]]; then
      left="$(tail -n +2 "$QUEUE" | grep -xF -- "$all" || true)"
    fi
    if [[ -z "$left" ]]; then
      while IFS= read -r line; do    # not the one on the screen now, unless it's the only one
        is_drawn "$line" "$now" || others+="$line"$'\n'
      done <<<"$all"
      left="$(printf '%s' "${others:-$all}" | shuf)"
    fi
    pick="$(head -n1 <<<"$left")"
    { echo "# $folder"; tail -n +2 <<<"$left"; } > "$QUEUE"
  else
    while IFS= read -r line; do
      if (( found )); then pick="$line"; break; fi
      is_drawn "$line" "$now" && found=1
    done <<<"$all"
    [[ -n "$pick" ]] || pick="$(head -n1 <<<"$all")"
  fi
  echo "$pick"
}

arm_rotation() {   # arm_rotation EVERY: the transient timer (replacing an older one)
  command -v systemd-run >/dev/null 2>&1 || { echo "arctic-wallpaper: systemd-run is needed to rotate" >&2; return 1; }
  systemctl --user stop arctic-wallpaper-rotate.timer arctic-wallpaper-rotate.service >/dev/null 2>&1 || true
  systemctl --user reset-failed arctic-wallpaper-rotate.timer arctic-wallpaper-rotate.service >/dev/null 2>&1 || true
  systemd-run --user --unit=arctic-wallpaper-rotate --collect --quiet --property=KillMode=process \
    --on-active="$1" --on-unit-active="$1" -- arctic-wallpaper next
}

rotate_cmd() {
  local every="${1:-}" folder shuffle=""
  case "$every" in
    "")
      if [[ -f "$ROTATE" ]]; then cat "$ROTATE"; else echo '{"every": "off"}'; fi ;;
    off)
      rm -f "$ROTATE" "$QUEUE"
      systemctl --user stop arctic-wallpaper-rotate.timer arctic-wallpaper-rotate.service >/dev/null 2>&1 || true ;;
    apply)
      every="$(rotate_get every)"
      case "$every" in 30m|1h|1d) arm_rotation "$every" ;; esac ;;
    30m|1h|1d)
      shift
      folder=""
      while (( $# )); do
        case "$1" in
          --shuffle) shuffle=1 ;;
          *) [[ -z "$folder" ]] || { echo "usage: arctic-wallpaper rotate 30m|1h|1d [FOLDER|arctic] [--shuffle]" >&2; return 2; }
             folder="$1" ;;
        esac
        shift
      done
      [[ -n "$folder" ]] || folder="$(your_folder)"
      if [[ "$folder" != arctic ]]; then
        folder="$(readlink -f "$folder" 2>/dev/null || true)"
        [[ -d "$folder" ]] || { echo "arctic-wallpaper: there is no folder ${folder:-like that}" >&2; return 2; }
      fi
      [[ -n "$(rotation_pictures "$folder")" ]] || { echo "arctic-wallpaper: no pictures in $folder" >&2; return 2; }
      mkdir -p "$CONF"
      python3 -c 'import json,sys
json.dump({"every": sys.argv[2], "folder": sys.argv[3], "shuffle": sys.argv[4] == "1"}, open(sys.argv[1] + ".tmp", "w"))
print("", file=open(sys.argv[1] + ".tmp", "a"))' "$ROTATE" "$every" "$folder" "${shuffle:-0}"
      mv "$ROTATE.tmp" "$ROTATE"
      rm -f "$QUEUE"
      arm_rotation "$every" ;;
    *)
      echo "usage: arctic-wallpaper rotate [30m|1h|1d [FOLDER|arctic] [--shuffle] | off | apply]" >&2; return 2 ;;
  esac
}

img=""
# Serialize choices, theme redraws and timer ticks. Detached programs close fd 9 so
# swaybg and wallpaper hooks cannot retain this lock after the command finishes.
case "${1:-}" in
  render|current|rotate|-h|--help) ;;
  *) mkdir -p "$CACHE_DIR"; exec 9>"$CACHE_DIR/wallpaper-apply.lock"; flock 9; load_theme ;;
esac
case "${1:-}" in
  render)
    for d in "${DIRS[@]}"; do
      for f in "$d"/*.svg; do [[ -f "$f" ]] && render "$f" >/dev/null; done
    done
    exit 0 ;;
  current)
    cat "$CACHE_DIR/wallpaper-current" 2>/dev/null || true
    exit 0 ;;
  rotate)
    shift
    rotate_cmd "$@"
    exit $? ;;
  next)
    # The rotation's next picture: it becomes your wallpaper and the colours follow it, so the
    # desktop keeps matching what is on screen. Arctic's own wallpapers are saved by name, so
    # arctic-theme brings back Winter / Polar night; your pictures get the 'wallpaper' theme.
    folder="$(rotate_get folder)"
    [[ -n "$folder" ]] || folder="$(your_folder)"
    img="$(next_picture "$folder" "$(rotate_get shuffle)" || true)"
    [[ -n "$img" ]] || { echo "arctic-wallpaper: no pictures to rotate in $folder" >&2; exit 1; }
    mkdir -p "$CONF"
    printf '%s\n' "$(design_name "$img" || printf '%s' "$img")" > "$CONF/wallpaper"
    sync_colours
    hook=1 ;;
  -h|--help)
    # the header comment, without its leading '#': everything up to the first line of code
    sed -n '2,${/^[^#]/q;s/^# \{0,1\}//;p;}' "$0"; exit 0 ;;
  "")
    saved="$(cat "$CONF/wallpaper" 2>/dev/null || true)"
    if is_name "$saved"; then
      img="$(find_design "$saved-$VARIANT" || true)"
    elif [[ -n "$saved" && -f "$saved" ]]; then
      img="$saved"
    fi ;;
  *)
    mkdir -p "$CONF"
    chosen=1
    if is_name "$1"; then
      printf '%s\n' "$1" > "$CONF/wallpaper"
      sync_colours
      img="$(find_design "$1-$VARIANT" || true)"
    elif [[ -f "$1" ]]; then
      path="$(readlink -f "$1")"
      case "${path,,}" in
        *.png|*.jpg|*.jpeg|*.webp|*.bmp|*.gif|*.svg|*.tif|*.tiff) ;;
        *) echo "arctic-wallpaper: $1 isn't a picture (PNG, JPEG, WebP, SVG…)" >&2; exit 2 ;;
      esac
      printf '%s\n' "$path" > "$CONF/wallpaper"
      sync_colours
      img="$path"
    else
      echo "usage: arctic-wallpaper [snowfield|aurora|fox|<picture>|render|current|rotate|next]" >&2; exit 2
    fi ;;
esac

if [[ -z "$img" ]]; then
  # The documented dotfiles install owns its photos in the user's data directory.
  if [[ "$ARCTIC_WALLPAPER" == /usr/share/backgrounds/arctic/default.jpg ]]; then
    for d in "${DIRS[@]}"; do
      if [[ -f "$d/default.jpg" ]]; then img="$d/default.jpg"; break; fi
    done
  fi
fi
if [[ -z "$img" ]]; then
  if [[ "$ARCTIC_WALLPAPER" == /* && -f "$ARCTIC_WALLPAPER" ]]; then img="$ARCTIC_WALLPAPER"
  else img="$(find_design "$ARCTIC_WALLPAPER" || find_design "aurora-$VARIANT" || true)"; fi
fi
if [[ -z "$img" ]]; then
  echo "arctic-wallpaper: no Arctic wallpapers found in ${DIRS[*]}" >&2
  exit 1
fi
img="$(render "$img")"
mkdir -p "$CACHE_DIR"
command -v swaybg >/dev/null 2>&1 || { echo "arctic-wallpaper: swaybg is not installed" >&2; exit 1; }
# Replace the running swaybg without a flash: start the new one, then stop the old.
old="$(pgrep -u "$UID" -x swaybg || true)"
detach swaybg -m fill -c "$ARCTIC_GROUND" -i "$img"
sleep 0.3
if [[ -n "$old" ]]; then
  # shellcheck disable=SC2086
  kill $old 2>/dev/null || true
fi
printf '%s\n' "$img" > "$CACHE_DIR/wallpaper-current.new"
mv "$CACHE_DIR/wallpaper-current.new" "$CACHE_DIR/wallpaper-current"
# Publishing is opt-in. The broker checks the authorized owner and active local session.
# A failed publication retains the previous public copy and never blocks the desktop.
if command -v arctic-login-wallpaper >/dev/null 2>&1; then
  detach arctic-login-wallpaper follow || true
fi
# A new choice (not a redraw): your wallpaper hooks (arctic-hook), in the background.
if [[ -n "${chosen:-}${hook:-}" ]] && command -v arctic-hook >/dev/null 2>&1; then
  detach arctic-hook wallpaper "$img" || true
fi
