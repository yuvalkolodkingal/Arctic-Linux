#!/usr/bin/env bash
# arctic-osd — volume and brightness keys with an on-screen display. Spec: design components/OSD.
# A 280×48 frosted pill, bottom centre, 44px above the edge: 20px icon, 6px amber bar, value.
# Drawn by the shell (`arctic-shell-ipc osd volume|brightness`); without the shell, mako draws
# it as a notification (see mako.ini [app-name=arctic-osd]). Shown for 1.2 s after the last press.
#
#   arctic-osd volume up|down|mute
#   arctic-osd mic mute
#   arctic-osd brightness up|down
#   arctic-osd kbd up|down          keyboard backlight (no keyboard light: nothing happens)
#   arctic-osd lock-keys [--seed]    Caps Lock / Num Lock on or off (their keys run it; --seed at
#                                    login only records the lights)
#   arctic-osd notice ICON TEXT [DETAIL]   an icon and a few words, for scripts
#
# Brightness keys act on the monitor you're on: the laptop panel, or an external monitor over
# DDC/CI, through the shell's brightness.py (`step focused ±5`). Without the shell's scripts,
# brightnessctl changes the laptop panel as before.
set -uo pipefail

STEP=5
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/arctic"
ICONS="$CONF/current/icons"

show() {   # show <icon> <value 0-100> <label>  (notification fallback)
  notify-send -a arctic-osd -e -t 1200 \
    -h string:x-canonical-private-synchronous:arctic-osd \
    -h "int:value:$2" -i "$ICONS/$1.svg" "$3" 2>/dev/null || true
}

notice() {   # notice <icon> <text> [detail]: the shell's icon-and-words OSD, else a notification
  arctic-shell-ipc osd notice "$1" "$2" "${3:-}" >/dev/null 2>&1 && return 0
  local icon=() body="$2"
  [[ -f "$ICONS/$1.svg" ]] && icon=(-i "$ICONS/$1.svg")
  [[ -n "${3:-}" ]] && body="$2 · $3"
  notify-send -a arctic-osd -e -t 1600 -h string:x-canonical-private-synchronous:arctic-osd \
    "${icon[@]}" "$body" 2>/dev/null || true
}

# The Caps Lock and Num Lock lights, as "caps=0|1 num=0|1" (a light that isn't there stays out).
lock_lights() {
  local name led on out=""
  for name in caps num; do
    on=""
    for led in "${ARCTIC_LEDS_DIR:-/sys/class/leds}"/*::"${name}lock"/brightness; do
      [[ -r "$led" ]] || continue
      on=0
      if [[ "$(cat "$led" 2>/dev/null)" != 0 ]]; then on=1; break; fi
    done
    [[ -n "$on" ]] && out+="$name=$on "
  done
  echo "${out% }"
}

case "${1:-}" in
  notice)   # notice ICON TEXT [DETAIL], for scripts: "Touchpad off", a mode turned on
    notice "${2:-info}" "${3:-}" "${4:-}"; exit 0 ;;
  lock-keys)   # after Caps Lock or Num Lock (binds.conf): say what changed; --seed only records
    state_dir="${XDG_RUNTIME_DIR:-/tmp}/arctic"
    mkdir -p "$state_dir"
    now="$(lock_lights)"
    before="$(cat "$state_dir/lock-keys" 2>/dev/null)"
    printf '%s\n' "$now" > "$state_dir/lock-keys"
    [[ "${2:-}" == --seed || -z "$before" ]] && exit 0
    # Only a light that changed: a Caps key remapped in Settings, or one that switches the
    # layout, changes nothing, so it says nothing (and neither does a keyboard without lights).
    for pair in $now; do
      [[ " $before " == *" $pair "* ]] && continue
      case "$pair" in
        caps=1) notice keyboard "Caps Lock on" ;;
        caps=0) notice keyboard "Caps Lock off" ;;
        num=1)  notice hash "Num Lock on" ;;
        num=0)  notice hash "Num Lock off" ;;
      esac
    done
    exit 0 ;;
esac

volume() {   # volume <sink|source> -> "<percent> <muted:0|1>"
  local out; out="$(wpctl get-volume "$1" 2>/dev/null)" || { echo "0 0"; return; }
  local v; v="$(awk '{printf "%d", $2 * 100 + 0.5}' <<<"$out")"
  if [[ "$out" == *MUTED* ]]; then echo "$v 1"; else echo "$v 0"; fi
}

brightness_step() {   # brightness_step +5|-5 → "<percent>\t<monitor>" when brightness.py did it
  local dir out percent label=''
  dir="$(arctic-shell --path 2>/dev/null)" && [[ -f "$dir/scripts/brightness.py" ]] || return 1
  out="$(python3 "$dir/scripts/brightness.py" step focused "$1" 2>/dev/null)" || return 1
  [[ "$out" =~ \"percent\":\ ([0-9]+) ]] || return 1
  percent="${BASH_REMATCH[1]}"
  [[ "$out" =~ \"label\":\ \"([^\"]*)\" ]] && label="${BASH_REMATCH[1]}"
  printf '%s\t%s\n' "$percent" "$label"
}

case "${1:-} ${2:-}" in
  "brightness up"|"brightness down")
    if [[ "$2" == up ]]; then delta="+$STEP"; else delta="-$STEP"; fi
    if IFS=$'\t' read -r level monitor < <(brightness_step "$delta"); then
      arctic-shell-ipc osd brightnessLevel "$level" "$monitor" >/dev/null 2>&1 && exit 0
      show brightness "$level" "${monitor:+$monitor · }$level"
      exit 0
    fi ;;
esac

case "${1:-} ${2:-}" in
  "volume up")
    wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
    wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "${STEP}%+" ;;
  "volume down")
    wpctl set-volume @DEFAULT_AUDIO_SINK@ "${STEP}%-" ;;
  "volume mute")
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  "mic mute")
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    read -r v m <<<"$(volume @DEFAULT_AUDIO_SOURCE@)"
    if (( m )); then show volume-mute 0 "Microphone off"; else show volume "$v" "Microphone on"; fi
    exit 0 ;;
  "brightness up")
    brightnessctl -q set "${STEP}%+" ;;
  "brightness down")
    # Never all the way to a black screen: stop at 1% of the maximum. --min-value takes a raw
    # value, not a percentage, and only in the --min-value=N form (its argument is optional:
    # in "-n 1% set …", "1%" would be read as the command and nothing would change).
    max="$(brightnessctl max 2>/dev/null)"
    [[ "$max" =~ ^[0-9]+$ ]] || max=0
    floor=$(( max / 100 )); (( floor > 0 )) || floor=1
    brightnessctl -q --min-value="$floor" set "${STEP}%-" ;;
  "kbd up"|"kbd down")
    # Keyboard lights have a few steps (often 2 or 3): one step at a time, else 10 %.
    kbd='*::kbd_backlight'
    max="$(brightnessctl --device="$kbd" max 2>/dev/null)"
    [[ "$max" =~ ^[0-9]+$ ]] && (( max > 0 )) || exit 0
    step="10%"; (( max <= 10 )) && step=1
    sign=+; [[ "$2" == down ]] && sign=-
    brightnessctl -q --device="$kbd" set "$step$sign"
    k="$(brightnessctl --device="$kbd" -m 2>/dev/null | awk -F, '{gsub("%","",$4); print $4}')"
    show brightness "${k:-0}" "Keyboard light ${k:-0}%"
    exit 0 ;;
  *)
    echo "usage: arctic-osd volume up|down|mute | mic mute | brightness up|down | kbd up|down | lock-keys | notice ICON TEXT [DETAIL]" >&2; exit 2 ;;
esac

arctic-shell-ipc osd "$1" >/dev/null 2>&1 && exit 0

case "$1" in
  volume)
    read -r v m <<<"$(volume @DEFAULT_AUDIO_SINK@)"
    if (( m )); then show volume-mute 0 "Muted"; else show volume "$v" "$v"; fi ;;
  brightness)
    b="$(brightnessctl -m 2>/dev/null | awk -F, '{gsub("%","",$4); print $4}')"
    show brightness "${b:-0}" "${b:-0}" ;;
esac
