#!/usr/bin/env bash
# arctic-osd — volume and brightness keys with an on-screen display. Spec: design components/OSD.
# A 280×48 frosted pill, bottom centre, 44px above the edge: 20px icon, 6px amber bar, value.
# Drawn by the shell (`arctic-shell-ipc osd volume|brightness`); without the shell, mako draws
# it as a notification (see mako.ini [app-name=arctic-osd]). Shown for 1.2 s after the last press.
#
#   arctic-osd volume up|down|mute
#   arctic-osd mic mute
#   arctic-osd brightness up|down
#   arctic-osd kbd up|down          keyboard backlight (no keyboard light: nothing happens)
set -uo pipefail

STEP=5
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/arctic"
ICONS="$CONF/current/icons"

show() {   # show <icon> <value 0-100> <label>  (notification fallback)
  notify-send -a arctic-osd -e -t 1200 \
    -h string:x-canonical-private-synchronous:arctic-osd \
    -h "int:value:$2" -i "$ICONS/$1.svg" "$3" 2>/dev/null || true
}

volume() {   # volume <sink|source> -> "<percent> <muted:0|1>"
  local out; out="$(wpctl get-volume "$1" 2>/dev/null)" || { echo "0 0"; return; }
  local v; v="$(awk '{printf "%d", $2 * 100 + 0.5}' <<<"$out")"
  if [[ "$out" == *MUTED* ]]; then echo "$v 1"; else echo "$v 0"; fi
}

case "${1:-} ${2:-}" in
  "volume up")
    wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
    wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "${STEP}%+" ;;
  "volume down")
    wpctl set-volume @DEFAULT_AUDIO_SINK@ "${STEP}%-" ;;
  "volume mute")
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  "mic mute")
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    read -r v m <<<"$(volume @DEFAULT_AUDIO_SOURCE@)"
    if (( m )); then show volume-mute 0 "Microphone off"; else show volume "$v" "Microphone on"; fi
    exit 0 ;;
  "brightness up")
    brightnessctl -q set "${STEP}%+" ;;
  "brightness down")
    # Never all the way to a black screen: stop at 1% of the maximum. --min-value takes a raw
    # value, not a percentage, and only in the --min-value=N form (its argument is optional:
    # in "-n 1% set …", "1%" would be read as the command and nothing would change).
    max="$(brightnessctl max 2>/dev/null)"
    [[ "$max" =~ ^[0-9]+$ ]] || max=0
    floor=$(( max / 100 )); (( floor > 0 )) || floor=1
    brightnessctl -q --min-value="$floor" set "${STEP}%-" ;;
  "kbd up"|"kbd down")
    # Keyboard lights have a few steps (often 2 or 3): one step at a time, else 10 %.
    kbd='*::kbd_backlight'
    max="$(brightnessctl --device="$kbd" max 2>/dev/null)"
    [[ "$max" =~ ^[0-9]+$ ]] && (( max > 0 )) || exit 0
    step="10%"; (( max <= 10 )) && step=1
    sign=+; [[ "$2" == down ]] && sign=-
    brightnessctl -q --device="$kbd" set "$step$sign"
    k="$(brightnessctl --device="$kbd" -m 2>/dev/null | awk -F, '{gsub("%","",$4); print $4}')"
    show brightness "${k:-0}" "Keyboard light ${k:-0}%"
    exit 0 ;;
  *)
    echo "usage: arctic-osd volume up|down|mute | mic mute | brightness up|down | kbd up|down" >&2; exit 2 ;;
esac

arctic-shell-ipc osd "$1" >/dev/null 2>&1 && exit 0

case "$1" in
  volume)
    read -r v m <<<"$(volume @DEFAULT_AUDIO_SINK@)"
    if (( m )); then show volume-mute 0 "Muted"; else show volume "$v" "$v"; fi ;;
  brightness)
    b="$(brightnessctl -m 2>/dev/null | awk -F, '{gsub("%","",$4); print $4}')"
    show brightness "${b:-0}" "${b:-0}" ;;
esac
