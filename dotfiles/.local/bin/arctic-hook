#!/usr/bin/env python3
"""arctic-hook — run your own scripts when something happens on the desktop.

  arctic-hook EVENT [VALUE]      run EVENT's hooks (what the desktop does; theme hooks are
                                 arctic-theme's own)
  arctic-hook --list [--json]    every event, its folders and the hooks that would run
  arctic-hook --open             make ~/.config/arctic and open it in the file manager

Events, their folders (Arctic's in /usr/share/arctic, then yours in ~/.config/arctic; a file of
yours replaces Arctic's of the same name, and one of yours that isn't executable turns it off)
and $1:
  wallpaper    wallpaper-hooks.d     arctic-wallpaper, after drawing a new picture   the picture
  font         font-hooks.d          arctic-font, after the code font changed        the family
  lock         lock-hooks.d          the screen has locked                           —
  unlock       unlock-hooks.d        the screen has unlocked                         —
  battery-low  battery-low-hooks.d   the battery is low                              percentage
  post-update  post-update-hooks.d   the first login after updates were installed    Arctic version
  login        login-hooks.d         every login, after the desktop has started      —
  theme        theme-hooks.d         after a theme switch (arctic-theme runs these)  —

The rules are arctic-theme's: every executable file runs in name order, with stdin from
/dev/null, ARCTIC_HOOK_EVENT and ARCTIC_HOOK_VALUE set (the value is also $1); names starting
with "." or ending in ~, .rpmnew, .rpmsave, .rpmorig, .disabled or .sample are skipped; each hook
is stopped after 5 s; what it prints (up to 4 KB) is passed on as a warning, also to the journal
(journalctl --user -t arctic-hook); a hook that fails never fails the event. One run per event
at a time.
"""
import contextlib
import fcntl
import json
import os
import shutil
import signal
import subprocess
import sys
import syslog
import tempfile

HOME = os.path.expanduser("~")
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "arctic")
SYSTEM = os.environ.get("ARCTIC_DATA_DIR") or "/usr/share/arctic"
RUNTIME = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir(), "arctic")
EVENTS = ("wallpaper", "font", "lock", "unlock", "battery-low", "post-update", "login", "theme")
TIMEOUT = float(os.environ.get("ARCTIC_HOOK_TIMEOUT", "5"))
OUTPUT_MAX = 4096
SKIP_SUFFIXES = ("~", ".rpmnew", ".rpmsave", ".rpmorig", ".disabled", ".sample")


def folders(event):
    return (os.path.join(SYSTEM, event + "-hooks.d"), os.path.join(CONFIG, event + "-hooks.d"))


def hooks(event):
    """The hooks that run for EVENT, in order: [(name, path)]."""
    found = {}
    for folder in folders(event):
        try:
            names = sorted(os.listdir(folder))
        except OSError:
            continue
        for name in names:
            if name.startswith(".") or name.endswith(SKIP_SUFFIXES):
                continue
            found[name] = os.path.join(folder, name)      # yours replaces Arctic's
    return [(name, found[name]) for name in sorted(found)
            if os.path.isfile(found[name]) and os.access(found[name], os.X_OK)]


def warn(message):
    print("arctic-hook: " + message, file=sys.stderr)
    with contextlib.suppress(Exception):
        syslog.openlog("arctic-hook")
        syslog.syslog(syslog.LOG_WARNING, message)


def run(event, value):
    env = dict(os.environ, ARCTIC_HOOK_EVENT=event, ARCTIC_HOOK_VALUE=value)
    for _name, path in hooks(event):
        # Output to an unlinked file, never our own pipes: a program a hook leaves running would
        # hold the caller's pipe open.
        with tempfile.TemporaryFile() as out:
            try:
                proc = subprocess.Popen([path] + ([value] if value else []), env=env, stdin=subprocess.DEVNULL,
                                        stdout=out, stderr=subprocess.STDOUT, start_new_session=True)
            except OSError as e:
                warn("{} hook {}: {}".format(event, path, e))
                continue
            try:
                rc = proc.wait(timeout=TIMEOUT)
                problem = "failed (exit {})".format(rc) if rc else None
            except subprocess.TimeoutExpired:
                with contextlib.suppress(OSError):
                    os.killpg(proc.pid, signal.SIGKILL)
                proc.wait()
                problem = "took longer than {:g}s and was stopped".format(TIMEOUT)
            out.seek(0)
            text = out.read(OUTPUT_MAX).decode("utf-8", "replace").rstrip()
        if text:
            warn("{} hook {}: {}".format(event, path, text.replace("\n", "\n  ")))
        if problem:
            warn("{} hook {} {}".format(event, path, problem))


def listing(as_json):
    rows = [dict(event=e, folders=list(folders(e)), hooks=[p for _n, p in hooks(e)]) for e in EVENTS]
    if as_json:
        print(json.dumps({"ok": True, "events": rows}))
        return
    for r in rows:
        print("{}: {}".format(r["event"], ", ".join(r["hooks"]) or "no hooks"))


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 2
    if argv[0] == "--list":
        listing("--json" in argv)
        return 0
    if argv[0] == "--open":
        os.makedirs(CONFIG, exist_ok=True)
        opener = shutil.which("xdg-open")
        if opener:
            subprocess.Popen([opener, CONFIG], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        print(CONFIG)
        return 0
    event, value = argv[0], (argv[1] if len(argv) > 1 else "")
    if event == "theme":
        print("arctic-hook: theme hooks run with arctic-theme (arctic-theme reload)", file=sys.stderr)
        return 2
    if event not in EVENTS or len(argv) > 2:
        print("arctic-hook: no event called {!r}; see arctic-hook --help".format(event), file=sys.stderr)
        return 2
    if not hooks(event):
        return 0
    os.makedirs(RUNTIME, exist_ok=True)
    with open(os.path.join(RUNTIME, "hook-{}.lock".format(event)), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        run(event, value)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
