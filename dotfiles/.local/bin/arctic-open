#!/usr/bin/env bash
# arctic-open — open the app you picked for a role.
#
#   arctic-open terminal | browser | editor | files | files-tui
#   arctic-open terminal [--hold] -e COMMAND [ARGUMENTS…]
#                        run a command in your terminal (--hold: keep it open afterwards);
#                        the launcher uses this for terminal apps, Fetch and "> command"
#   arctic-open terminal --app-id ID [-e COMMAND…]
#                        the terminal's window gets the Wayland app id ID, which window rules
#                        match (the drop-down terminal): kitty, foot, alacritty or ghostty (your
#                        terminal if it is one of them, else the first of them installed)
#   arctic-open --focus DESKTOP-ID
#                        bring the app's window back if it is open (Mango), else start it
#                        (gtk-launch); shortcuts made in Settings use this
#
# The installer writes your picks to /etc/arctic/default-apps; you can override any of them in
# ~/.config/arctic/default-apps. Both files are simple  role=command  lines, e.g.
#     browser=gtk-launch org.mozilla.firefox
# If the chosen app is missing, the next app in the role's fallback list is used. To run a
# command, the terminal must take `-e COMMAND…` and `--hold`, as kitty, foot and alacritty do.
set -uo pipefail

usage() {
  echo "usage: arctic-open terminal|browser|editor|files|files-tui" >&2
  echo "       arctic-open terminal [--hold] [--app-id ID] [-e COMMAND [ARGUMENTS…]]" >&2
  echo "       arctic-open --focus DESKTOP-ID" >&2
  exit 2
}

role="${1:-}"
[[ -n "$role" ]] || usage
shift

# Launch or focus: the first window whose app id is the desktop entry's (its id, the part after
# its last dot, or its StartupWMClass, in any case) comes to the front, on its workspace.
if [[ "$role" == --focus ]]; then
  id="${1:-}"
  [[ "$id" =~ ^[A-Za-z0-9._-]+$ ]] || usage
  dirs="${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:/var/lib/flatpak/exports/share:$HOME/.local/share/flatpak/exports/share"
  client="$(mmsg get all-clients 2>/dev/null | python3 -c '
import json, os, sys
ident, dirs = sys.argv[1], sys.argv[2].split(":")
names = {ident.lower(), ident.rsplit(".", 1)[-1].lower()}
for d in dirs:
    try:
        with open(os.path.join(d, "applications", ident + ".desktop"), encoding="utf-8") as f:
            names |= {l.split("=", 1)[1].strip().lower() for l in f if l.startswith("StartupWMClass=")}
        break
    except OSError:
        pass
for c in json.load(sys.stdin).get("clients", []):
    if str(c.get("appid") or c.get("app_id") or "").lower() in names:
        print(c["id"])
        break' "$id" "$dirs" 2>/dev/null)"
  if [[ "$client" =~ ^[0-9]+$ ]] && mmsg dispatch focusid "client,$client" >/dev/null 2>&1; then exit 0; fi
  setsid -f gtk-launch "$id" >/dev/null 2>&1
  exit 0
fi

# Running a command in the terminal: [--hold] [--app-id ID] [-e COMMAND…]
exec_args=()
app_id=""
if (( $# )); then
  [[ "$role" == terminal ]] || usage
  hold=0 run=0
  while (( $# )); do
    case "$1" in
      --hold) hold=1; shift ;;
      --app-id) app_id="${2:-}"; [[ "$app_id" =~ ^[A-Za-z0-9._-]+$ ]] || usage; shift 2 ;;
      -e) shift; run=1; break ;;
      *) usage ;;
    esac
  done
  if (( run )); then (( $# )) || usage; else [[ -n "$app_id" ]] || usage; fi
  (( hold )) && exec_args+=(--hold)
  (( run )) && exec_args+=(-e "$@")
fi

id_args() {   # id_args <terminal command line> — how that terminal sets its window's app id
  [[ -n "$app_id" ]] || return 0
  case "$(basename "${1%% *}")" in
    kitty|alacritty) printf '%s\n' --class "$app_id" ;;
    foot) printf '%s\n' --app-id "$app_id" ;;
    ghostty) printf '%s\n' "--class=$app_id" ;;
  esac
}

declare -A FALLBACK=(
  [terminal]="kitty|foot|alacritty"
  [browser]="gtk-launch app.zen_browser.zen|gtk-launch org.mozilla.firefox|firefox|gtk-launch com.brave.Browser|chromium-browser"
  [editor]="gtk-launch dev.zed.Zed|zeditor|zed|gtk-launch com.vscodium.codium|kitty -e nvim|foot -e nvim|alacritty -e nvim"
  [files]="thunar|nautilus|pcmanfm-qt|kitty -e yazi|foot -e yazi|alacritty -e yazi"
  [files-tui]="kitty -e yazi|foot -e yazi|alacritty -e yazi|kitty -e ranger"
)

configured=""
for f in /etc/arctic/default-apps "${XDG_CONFIG_HOME:-$HOME/.config}/arctic/default-apps"; do
  [[ -r "$f" ]] || continue
  line="$(grep -E "^${role}=" "$f" | tail -n1 || true)"
  [[ -n "$line" ]] && configured="${line#*=}"
done

available() {   # available <command line> — is its program (or desktop entry) present?
  local cmd="$1" prog
  prog="${cmd%% *}"
  if [[ "$prog" == gtk-launch ]]; then
    local id="${cmd#gtk-launch }"
    local dirs="${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:/var/lib/flatpak/exports/share:$HOME/.local/share/flatpak/exports/share"
    local d
    IFS=: read -ra ds <<<"$dirs"
    for d in "${ds[@]}"; do [[ -f "$d/applications/$id.desktop" ]] && return 0; done
    return 1
  fi
  command -v "$prog" >/dev/null 2>&1
}

IFS='|' read -ra candidates <<<"${configured:+$configured|}${FALLBACK[$role]:-}"
for c in "${candidates[@]}"; do
  [[ -n "$c" ]] || continue
  # A desktop entry can't be handed a command to run.
  (( ${#exec_args[@]} )) && [[ "$c" == gtk-launch* ]] && continue
  if available "$c"; then
    mapfile -t ids < <(id_args "$c")
    # A window rule needs the app id: skip to a terminal that can set one (kitty, foot…).
    [[ -n "$app_id" && ${#ids[@]} -eq 0 ]] && continue
    # Detach so the app outlives the keybinding's process. The role's command line is a
    # command line (word-split by sh); the command to run is passed as separate arguments.
    setsid -f sh -c "exec $c \"\$@\"" arctic-open "${ids[@]}" "${exec_args[@]}" >/dev/null 2>&1
    exit 0
  fi
done

notify-send -a "Arctic Linux" -i dialog-warning "No app set for $role" \
  "Pick one with the Software app, or set $role= in ~/.config/arctic/default-apps." 2>/dev/null
exit 1
