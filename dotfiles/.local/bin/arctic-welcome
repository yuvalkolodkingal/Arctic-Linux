#!/usr/bin/env bash
# arctic-welcome — the greeting at login (autostart.conf runs it).
#
# Live USB: "You're trying Arctic Linux" (spec: design components/LiveDesktop), once per live
# boot, as the shell's frosted card (Install Arctic Linux / Keep trying); closing it leaves the
# Install item on the bar and the Install tile on the desktop, and Super+I starts the installer
# from anywhere. Without the shell it falls back to a notification (click it to install).
#
# Installed system: "Welcome to Arctic Linux" at the first login of a new account (the keys that
# get you everywhere, getting online, Get apps, light or dark). New accounts get
# ~/.local/state/arctic/first-login from /etc/skel; showing the welcome deletes it, so accounts
# from before 0.3 never see it. Without the shell it is a notification.
#
#   arctic-welcome            what login runs
#   arctic-welcome --again    the installed system's welcome, now (the command menu's Learn › Welcome)
set -uo pipefail

again=0
[[ "${1:-}" == --again ]] && again=1

logo="${XDG_DATA_HOME:-$HOME/.local/share}/arctic/logos/arctic-mark-polar-night.svg"
[[ -f "$logo" ]] || logo=/usr/share/arctic/logos/arctic-mark-polar-night.svg

# Try the shell's card for up to a minute: the shell starts alongside this script at login, and
# on a slow machine (or a VM without acceleration) that can take a while.
shell_card() {   # shell_card <ipc function>
  [[ "${ARCTIC_SHELL:-quickshell}" != waybar ]] || return 1
  local tries=120
  (( again )) && tries=1
  for _ in $(seq "$tries"); do
    arctic-shell-ipc welcome "$1" >/dev/null 2>&1 && return 0
    (( tries > 1 )) && sleep 0.5
  done
  return 1
}

if ! arctic-is-live; then
  first="${XDG_STATE_HOME:-$HOME/.local/state}/arctic/first-login"
  (( again )) || [[ -e "$first" ]] || exit 0
  rm -f "$first"
  shell_card firstLogin && exit 0
  (( again )) || sleep 2   # let mako and the bar come up first
  notify-send -a "Arctic Linux" -u normal -i "$logo" "Welcome to Arctic Linux" \
    "Super + Space: apps, settings and files
Super + Alt + Space: every system action
Super + /: all the shortcuts" 2>/dev/null
  exit 0
fi

# "Install Arctic Linux" in the boot menu opens the installer instead (live-session).
[[ "$(cat /run/arctic/live-mode 2>/dev/null)" == install ]] && exit 0
grep -qw 'arctic.mode=install' /proc/cmdline 2>/dev/null && exit 0
flag="${XDG_RUNTIME_DIR:-/tmp}/arctic-welcome-shown"
[[ -e "$flag" ]] && exit 0
touch "$flag"

shell_card open && exit 0

sleep 2   # let mako and the bar come up first
action="$(notify-send -a "Arctic Linux" -u normal -t 0 \
  -i "$logo" \
  -A default="Install Arctic Linux" \
  "You’re trying Arctic Linux" \
  "Nothing is saved to this computer. Look around, open apps, then install when you’re ready.
Click here or press Super + I to install · Super + Space for apps" 2>/dev/null)"

[[ "$action" == default ]] && exec arctic-start-installer
exit 0
