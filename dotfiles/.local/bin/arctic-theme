#!/usr/bin/env python3
"""arctic-theme — the desktop's colours: Winter, Polar night, your wallpaper's, or a theme of your own.

  arctic-theme                      print the active theme's name
  arctic-theme set NAME             switch to NAME: winter, polar-night, wallpaper (colours made
                                    from the wallpaper now) or a folder in ~/.config/arctic/themes.
                                    Choosing anything but wallpaper turns auto colours off.
  arctic-theme auto [on|off]        colours follow the wallpaper: every new wallpaper remakes the
                                    'wallpaper' theme and switches to it (Arctic's own wallpapers
                                    keep Winter / Polar night). Without on|off, print on or off.
  arctic-theme mode [auto|dark|light]   light or dark for wallpaper colours (auto: from the picture)
  arctic-theme toggle               light <-> dark (Super+Shift+T)
  arctic-theme zen [on|off]         give Zen Browser the theme's accent colour (read when Zen
                                    starts; default off). Without on|off, print on or off.
  arctic-theme current [--json]     the active theme (JSON: name, label, mode, colours, settings)
  arctic-theme list [--json]        the themes you can switch to
  arctic-theme reload               re-apply the active theme to running apps and run the hooks
  arctic-theme apply                re-apply the saved theme (runs at login)
  arctic-theme sync [--force] [--no-redraw]   follow the wallpaper now if auto colours are on
                                    (arctic-wallpaper runs this after a change)
  arctic-theme winter|polar-night|light|dark  shortcuts kept from earlier versions

~/.config/arctic/current links to the active theme folder; the shell, Mango, kitty, mako,
fuzzel, swaylock, waybar and GTK read their colours through it. Settings live in
~/.config/arctic/settings.json ("auto_colors", default on; "wallpaper_mode", default auto;
"zen_theme", default off).
After a switch, every executable in /usr/share/arctic/theme-hooks.d and
~/.config/arctic/theme-hooks.d runs with ARCTIC_THEME_DIR, ARCTIC_THEME_MODE and ARCTIC_THEME_NAME
(a file of yours replaces the system hook of the same name; 5 s limit; failures are ignored;
what a hook prints is passed on as a warning).
"""
import contextlib
import fcntl
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile

HOME = os.path.expanduser("~")
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "arctic")
DATA_HOME = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share")
SYSTEM = os.environ.get("ARCTIC_DATA_DIR") or "/usr/share/arctic"
BACKGROUNDS = os.environ.get("ARCTIC_BACKGROUNDS_DIR") or "/usr/share/backgrounds/arctic"
STATE = os.path.join(CONFIG, "theme")
CURRENT = os.path.join(CONFIG, "current")
SETTINGS = os.path.join(CONFIG, "settings.json")
USER_THEMES = os.path.join(CONFIG, "themes")
SYSTEM_THEMES = os.path.join(SYSTEM, "themes")
HOOK_DIRS = (os.path.join(SYSTEM, "theme-hooks.d"), os.path.join(CONFIG, "theme-hooks.d"))
USER_TEMPLATES = os.path.join(CONFIG, "templates")
WALLPAPER_CHOICE = os.path.join(CONFIG, "wallpaper")
DESIGN_WALLPAPERS = ("snowfield", "aurora", "fox")
DESIGN_DIRS = (os.path.join(DATA_HOME, "arctic", "wallpapers"), BACKGROUNDS)
DEFAULT_THEME = "polar-night"      # live USB and first login
BUILTIN_FOR_MODE = {"dark": "polar-night", "light": "winter"}
WALLPAPER_THEME = "wallpaper"
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$")
HOOK_TIMEOUT = float(os.environ.get("ARCTIC_THEME_HOOK_TIMEOUT", "5"))
HOOK_OUTPUT_MAX = 4096                # bytes of a hook's output passed on as a warning


class Error(Exception):
    def __init__(self, message, status=1):
        super().__init__(message)
        self.status = status


def warn(message):
    print("arctic-theme: " + message, file=sys.stderr)


# ---- settings ------------------------------------------------------------------------------------

def load_settings():
    try:
        with open(SETTINGS, encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_settings(**changes):
    """Merge changes into settings.json (other programs' keys are kept)."""
    data = load_settings()
    data.update(changes)
    write_atomic(SETTINGS, json.dumps(data, indent=2, sort_keys=True) + "\n")


def auto_colors(settings=None):
    value = (settings if settings is not None else load_settings()).get("auto_colors", True)
    return value if isinstance(value, bool) else True


def wallpaper_mode(settings=None):
    value = (settings if settings is not None else load_settings()).get("wallpaper_mode", "auto")
    return value if value in ("auto", "dark", "light") else "auto"


def write_atomic(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "{}.tmp-{}".format(path, os.getpid())
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


# ---- themes --------------------------------------------------------------------------------------

def theme_dir(name):
    """(folder, 'user'|'system') for a theme name, or (None, None). ~/.config/arctic/themes wins."""
    if not NAME_RE.match(name or ""):
        return None, None
    for folder, source in ((os.path.join(USER_THEMES, name), "user"), (os.path.join(SYSTEM_THEMES, name), "system")):
        if os.path.isfile(os.path.join(folder, "theme.json")):
            return folder, source
    return None, None


def read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def css_color(qml):
    """QML #aarrggbb -> CSS #rrggbbaa (theme.json stores QML colours)."""
    if isinstance(qml, str) and len(qml) == 9:
        return "#" + qml[3:] + qml[1:3]
    return qml


def theme_info(name, folder, source):
    """What arctic-theme knows about a theme folder (palette.json, else theme.json)."""
    pal = read_json(os.path.join(folder, "palette.json"))
    tj = read_json(os.path.join(folder, "theme.json"))
    if pal.get("colors"):
        mode = pal.get("mode", "dark")
        colors = pal["colors"]
        label = pal.get("label") or name
        base = pal.get("base") or BUILTIN_FOR_MODE.get(mode, DEFAULT_THEME)
    else:
        mode = "dark" if tj.get("dark", True) else "light"
        label = tj.get("name") or name
        base = BUILTIN_FOR_MODE[mode]
        qml = tj.get("colors", {})
        colors = {}
        for key, value in qml.items():
            role = re.sub(r"([A-Z]|(?<=[a-z])[0-9])", lambda m: "-" + m.group(1).lower(), key)
            colors[role] = css_color(value)
    return {"name": name, "label": label, "mode": mode if mode in ("dark", "light") else "dark",
            "base": base, "dir": folder, "source": source, "colors": colors}


def all_themes():
    names = set()
    for d in (USER_THEMES, SYSTEM_THEMES):
        try:
            names.update(n for n in os.listdir(d) if NAME_RE.match(n))
        except OSError:
            pass
    out = []
    for n in sorted(names):
        folder, source = theme_dir(n)
        if folder:
            out.append(theme_info(n, folder, source))
    return out


def active_name():
    try:
        with open(STATE, encoding="utf-8") as f:
            name = f.read().strip()
        if NAME_RE.match(name):
            return name
    except OSError:
        pass
    try:
        name = os.path.basename(os.path.realpath(CURRENT))
        if NAME_RE.match(name) and os.path.isfile(os.path.join(CURRENT, "theme.json")):
            return name
    except OSError:
        pass
    return DEFAULT_THEME


def active_info():
    name = active_name()
    folder, source = theme_dir(name)
    if folder is None and os.path.isfile(os.path.join(CURRENT, "theme.json")):
        folder, source = os.path.realpath(CURRENT), "link"
    if folder is None:
        return {"name": name, "label": name, "mode": "dark", "base": DEFAULT_THEME, "dir": "",
                "source": "missing", "colors": {}}
    return theme_info(name, folder, source)


# ---- wallpaper -----------------------------------------------------------------------------------

def saved_wallpaper():
    """arctic-wallpaper's saved choice: a design name, a picture path, or ''."""
    try:
        with open(WALLPAPER_CHOICE, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def is_design_wallpaper(choice):
    """Arctic's own wallpapers are drawn for Winter and Polar night: they keep the static palettes."""
    if not choice or choice in DESIGN_WALLPAPERS:
        return True
    real = os.path.realpath(choice)
    cache = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "arctic", "wallpapers")
    for d in DESIGN_DIRS + (cache,):
        if real.startswith(os.path.realpath(d) + os.sep):
            return True
    return False


def design_file(name, variant):
    for d in DESIGN_DIRS:
        for ext in (".png", ".svg"):
            path = os.path.join(d, "{}-{}{}".format(name, variant, ext))
            if os.path.isfile(path):
                return path
    return None


def wallpaper_picture():
    """The picture to take colours from: the saved one, else the drawn one, else the default."""
    choice = saved_wallpaper()
    info = active_info()
    variant = info["base"] if info["base"] in BUILTIN_FOR_MODE.values() else static_for_mode(info["mode"])
    if choice in DESIGN_WALLPAPERS:
        return design_file(choice, variant)
    if choice and os.path.isfile(choice):
        return choice
    cache = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "arctic", "wallpaper-current")
    try:
        with open(cache, encoding="utf-8") as f:
            drawn = f.read().strip()
        if drawn and os.path.isfile(drawn):
            return drawn
    except OSError:
        pass
    return design_file("aurora", variant)


# ---- the engine ----------------------------------------------------------------------------------

def themegen():
    """Import the theme engine (design/themegen, ~/.local/share/arctic/themegen,
    /usr/share/arctic/themegen), or raise Error."""
    here = os.path.dirname(os.path.realpath(__file__))
    for d in (os.environ.get("ARCTIC_THEMEGEN_DIR"), os.path.join(here, "..", "..", "..", "design", "themegen"),
              os.path.join(DATA_HOME, "arctic", "themegen"), os.path.join(SYSTEM, "themegen")):
        if d and os.path.isfile(os.path.join(d, "cli.py")):
            parent = os.path.dirname(os.path.realpath(d))
            if parent not in sys.path:
                sys.path.insert(0, parent)
            import themegen as tg
            import themegen.derive
            import themegen.render  # noqa: F401
            return tg
    raise Error("the theme engine is missing (/usr/share/arctic/themegen)")


def template_dirs():
    return [USER_TEMPLATES] if os.path.isdir(USER_TEMPLATES) else []


def fingerprint(tg):
    """Changes when the engine (its code or version), its templates or yours change (the wallpaper theme is then remade)."""
    parts = [getattr(tg, "__version__", "")]
    engine = os.path.dirname(os.path.abspath(tg.__file__))
    for fn in sorted(os.listdir(engine)):
        if fn.endswith(".py"):              # derive.py, wallpaper.py, ...: an update remakes it
            with contextlib.suppress(OSError):
                st = os.stat(os.path.join(engine, fn))
                parts.append("engine/{}:{}:{}".format(fn, st.st_size, st.st_mtime_ns))
    for d in [tg.render.TEMPLATES_DIR] + template_dirs():
        for root, _dirs, files in os.walk(d):
            for fn in sorted(files):
                try:
                    st = os.stat(os.path.join(root, fn))
                except OSError:
                    continue
                parts.append("{}:{}:{}".format(os.path.relpath(os.path.join(root, fn), d), st.st_size, st.st_mtime_ns))
    try:
        st = os.stat(os.path.join(tg.palette.data_dir(), "exports", "arctic-tokens.json"))
        parts.append("tokens:{}:{}".format(st.st_size, st.st_mtime_ns))
    except Exception:  # no design data: the engine reports that when it renders
        pass
    import hashlib
    return hashlib.sha1("\n".join(sorted(parts)).encode()).hexdigest()[:16]


def make_wallpaper_theme(picture, mode, force=False):
    """(Re)make ~/.config/arctic/themes/wallpaper from a picture. Returns True if it changed."""
    tg = themegen()
    folder = os.path.join(USER_THEMES, WALLPAPER_THEME)
    fp = fingerprint(tg)
    old = read_json(os.path.join(folder, "palette.json")).get("source", {})
    try:
        st = os.stat(picture)
    except OSError:
        raise Error("the wallpaper {} is missing".format(picture))
    if (not force and old.get("image") == os.path.abspath(picture) and old.get("size") == st.st_size
            and old.get("mtime_ns") == st.st_mtime_ns and old.get("mode_setting") == mode
            and old.get("fingerprint") == fp and os.path.isfile(os.path.join(folder, "theme.json"))):
        return False
    try:
        p = tg.derive.from_wallpaper(picture, mode)
        p["source"]["fingerprint"] = fp
        tg.render.render(p, folder, template_dirs())
    except tg.palette.ThemegenError as e:
        raise Error(str(e))
    return True


# ---- switching -----------------------------------------------------------------------------------

def link_current(name):
    folder, source = theme_dir(name)
    if folder is None:
        known = ", ".join(t["name"] for t in all_themes()) or "winter, polar-night"
        raise Error("unknown theme '{}' ({})".format(name, known), 2)
    os.makedirs(CONFIG, exist_ok=True)
    if os.path.isdir(CURRENT) and not os.path.islink(CURRENT):
        raise Error("{} is a folder, not a link; move it away and try again".format(CURRENT))
    # A theme of yours is linked relatively (the home folder can move); a packaged one absolutely.
    target = os.path.join("themes", name) if source == "user" else folder
    tmp = os.path.join(CONFIG, ".current.tmp-{}".format(os.getpid()))
    with contextlib.suppress(FileNotFoundError):
        os.unlink(tmp)
    os.symlink(target, tmp)
    os.replace(tmp, CURRENT)
    # The shell watches this file: rewriting it (even unchanged) restyles it from the new link.
    write_atomic(STATE, name + "\n")


def activate(name, redraw=True):
    link_current(name)
    reload(redraw=redraw)


def static_for_mode(mode):
    return BUILTIN_FOR_MODE.get(mode, DEFAULT_THEME)


def follow_wallpaper(force=False):
    """(theme, changed) the wallpaper calls for: Arctic's own wallpapers -> Winter / Polar night
    (light or dark as set, else as now), your pictures -> the 'wallpaper' theme, (re)made from
    the picture when needed."""
    mode = wallpaper_mode()
    current = active_info()
    choice = saved_wallpaper()
    picture = None if is_design_wallpaper(choice) else choice
    if picture and not os.path.isfile(picture):
        # At login the picture's drive may not be mounted yet: keep its colours unless forced.
        made = os.path.isfile(os.path.join(USER_THEMES, WALLPAPER_THEME, "theme.json"))
        if not force and made and current["name"] == WALLPAPER_THEME:
            warn("the wallpaper {} is missing; keeping its colours".format(picture))
            return WALLPAPER_THEME, False
        warn("the wallpaper {} is missing; keeping Arctic's colours".format(picture))
        picture = None
    if picture is None:
        return static_for_mode(current["mode"] if mode == "auto" else mode), False
    return WALLPAPER_THEME, make_wallpaper_theme(picture, mode, force=force)


def sync(force=False, redraw=True):
    """If auto colours are on, follow the wallpaper now; switches (and reloads) only when the
    theme or its colours change, or with force. Returns the active theme."""
    if not auto_colors():
        return active_name()
    target, changed = follow_wallpaper(force=force)
    linked = os.path.realpath(CURRENT) == os.path.realpath(theme_dir(target)[0] or CURRENT + "-missing")
    if changed or force or target != active_name() or not linked:
        activate(target, redraw=redraw)
    return target


# ---- live reload ---------------------------------------------------------------------------------

def run_quiet(cmd, timeout=3):
    try:
        return subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                               timeout=timeout, text=True)
    except (OSError, subprocess.SubprocessError):
        return None


def spawn(cmd):
    """Start a command in the background, detached (it outlives arctic-theme)."""
    try:
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass


def have(cmd):
    return shutil.which(cmd) is not None


def gtk3_theme_installed(name):
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share")
    dirs = [os.path.join(data_home, "themes"), os.path.join(HOME, ".themes")]
    for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":"):
        if d:
            dirs.append(os.path.join(d, "themes"))
    return any(os.path.isdir(os.path.join(d, name, "gtk-3.0")) for d in dirs)


def gtk3_theme(dark):
    """GTK 3's theme: adw-gtk3(-dark), which takes the Arctic colours (the 10-gtk hook and the
    dconf defaults use the same names, so a switch changes it once); plain Adwaita only when
    adw-gtk3 is not installed."""
    name = "adw-gtk3-dark" if dark else "adw-gtk3"
    if gtk3_theme_installed(name):
        return name
    return "Adwaita-dark" if dark else "Adwaita"


def reload_gtk(dark):
    scheme = "prefer-dark" if dark else "prefer-light"
    gtk_theme = gtk3_theme(dark)
    if have("gsettings"):
        key = "org.gnome.desktop.interface"
        run_quiet(["gsettings", "set", key, "color-scheme", scheme])
        r = run_quiet(["gsettings", "get", key, "gtk-theme"])
        if r is not None and r.stdout.strip().strip("'") == gtk_theme:
            # Same theme name: GTK only re-reads gtk.css (our colours) when the name changes.
            run_quiet(["gsettings", "set", key, "gtk-theme", ""])
        run_quiet(["gsettings", "set", key, "gtk-theme", gtk_theme])
    ini = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "gtk-3.0", "settings.ini")
    try:
        with open(ini, encoding="utf-8") as f:
            text = f.read()
        new = re.sub(r"(?m)^gtk-application-prefer-dark-theme=.*$", "gtk-application-prefer-dark-theme=" + ("1" if dark else "0"), text)
        if new != text:
            write_atomic(ini, new)
    except OSError:
        pass


def run_hooks(info):
    hooks = {}
    for d in HOOK_DIRS:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for fn in names:
            if fn.startswith(".") or fn.endswith(("~", ".rpmnew", ".rpmsave", ".rpmorig", ".disabled")):
                continue
            hooks[fn] = os.path.join(d, fn)       # a user hook replaces the system one
    env = dict(os.environ, ARCTIC_THEME_DIR=os.path.realpath(CURRENT), ARCTIC_THEME_MODE=info["mode"],
               ARCTIC_THEME_NAME=info["name"])
    for fn in sorted(hooks):
        path = hooks[fn]
        if not (os.path.isfile(path) and os.access(path, os.X_OK)):
            continue
        # The hook's output goes to an unlinked file, never to our own stdout/stderr: a program
        # a hook leaves running would otherwise hold the caller's pipe open (arctic-wallpaper and
        # the shell collect arctic-theme's output and would wait for it).
        with tempfile.TemporaryFile() as out:
            try:
                proc = subprocess.Popen([path], env=env, stdin=subprocess.DEVNULL, stdout=out,
                                        stderr=subprocess.STDOUT, start_new_session=True)
            except OSError as e:
                warn("hook {}: {}".format(path, e))
                continue
            try:
                rc = proc.wait(timeout=HOOK_TIMEOUT)
                problem = "failed (exit {})".format(rc) if rc else None
            except subprocess.TimeoutExpired:
                with contextlib.suppress(OSError):
                    os.killpg(proc.pid, signal.SIGKILL)
                proc.wait()
                problem = "took longer than {:g}s and was stopped".format(HOOK_TIMEOUT)
            out.seek(0)
            text = out.read(HOOK_OUTPUT_MAX).decode("utf-8", "replace").rstrip()
        if text:
            warn("hook {}: {}".format(path, text.replace("\n", "\n  ")))
        if problem:
            warn("hook {} {}".format(path, problem))


def reload(redraw=True):
    """Tell running programs about the active theme, then run the hooks. Best effort: a program
    that isn't running is skipped, and nothing here fails the switch."""
    info = active_info()
    dark = info["mode"] == "dark"
    uid = str(os.getuid())
    if os.environ.get("MANGO_INSTANCE_SIGNATURE") and have("mmsg"):
        run_quiet(["mmsg", "dispatch", "reload_config"])        # Mango re-reads mango-colors.conf
    if have("pkill"):
        run_quiet(["pkill", "-USR1", "-u", uid, "-x", "kitty"])    # kitty re-reads kitty.conf
        run_quiet(["pkill", "-USR2", "-u", uid, "-x", "waybar"])   # waybar reloads its style
    if have("makoctl"):
        run_quiet(["makoctl", "reload"])
    if have("arctic-shell-ipc"):
        spawn(["arctic-shell-ipc", "shell", "reload"])  # the shell also follows theme.json by itself
    if redraw and have("arctic-wallpaper"):
        spawn(["arctic-wallpaper"])                     # Arctic's wallpapers come in both variants
    run_hooks(info)
    # GTK last: the 10-gtk hook refreshes the copies of gtk.css GTK apps read
    # (~/.config/gtk-{3,4}.0/arctic-colors.css), and GTK re-reads them when the theme changes.
    reload_gtk(dark)


# ---- commands ------------------------------------------------------------------------------------

@contextlib.contextmanager
def locked():
    os.makedirs(CONFIG, exist_ok=True)
    with open(os.path.join(CONFIG, ".theme.lock"), "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def cmd_set(name):
    if name == WALLPAPER_THEME:
        picture = wallpaper_picture()
        if not picture:
            raise Error("no wallpaper to take colours from")
        make_wallpaper_theme(picture, wallpaper_mode())
        activate(WALLPAPER_THEME)
        return
    if theme_dir(name)[0] is None:
        link_current(name)          # raises the "unknown theme" error
    if auto_colors():
        save_settings(auto_colors=False)
        warn("auto colours are off now (arctic-theme auto on turns them back on)")
    activate(name)


def cmd_auto(value):
    if value is None:
        print("on" if auto_colors() else "off")
        return
    if value not in ("on", "off"):
        raise Error("usage: arctic-theme auto on|off", 2)
    save_settings(auto_colors=value == "on")
    if value == "on":
        sync()
    elif active_name() == WALLPAPER_THEME:
        activate(static_for_mode(active_info()["mode"]))


def cmd_mode(value):
    if value is None:
        print(wallpaper_mode())
        return
    if value not in ("auto", "dark", "light"):
        raise Error("usage: arctic-theme mode auto|dark|light", 2)
    save_settings(wallpaper_mode=value)
    if auto_colors():
        sync()
    elif active_name() == WALLPAPER_THEME:
        source = read_json(os.path.join(USER_THEMES, WALLPAPER_THEME, "palette.json")).get("source", {})
        picture = source.get("image") if source.get("image") and os.path.isfile(source.get("image")) else wallpaper_picture()
        if picture and make_wallpaper_theme(picture, value):
            activate(WALLPAPER_THEME)


def zen_theme(settings=None):
    return (settings if settings is not None else load_settings()).get("zen_theme") is True


def cmd_zen(value):
    if value is None:
        print("on" if zen_theme() else "off")
        return
    if value not in ("on", "off"):
        raise Error("usage: arctic-theme zen on|off", 2)
    save_settings(zen_theme=value == "on")
    run_hooks(active_info())        # the 40-zen hook adds or removes the accent in user.js


def cmd_toggle():
    info = active_info()
    other = "light" if info["mode"] == "dark" else "dark"
    if auto_colors() or info["name"] == WALLPAPER_THEME:
        cmd_mode(other)
    else:
        activate("polar-night" if info["name"] == "winter" else "winter")


def cmd_apply():
    name = active_name()
    if auto_colors():
        try:
            name = follow_wallpaper()[0]
        except Error as e:      # login must always end with a theme applied
            warn("{}; keeping {}".format(e, name))
    if theme_dir(name)[0] is None:
        warn("theme '{}' is missing; using {}".format(name, DEFAULT_THEME))
        name = DEFAULT_THEME
    activate(name)


def cmd_current(as_json):
    info = active_info()
    if not as_json:
        print(info["name"])
        return
    settings = load_settings()
    info.update(auto_colors=auto_colors(settings), wallpaper_mode=wallpaper_mode(settings), wallpaper=saved_wallpaper(),
                zen_theme=zen_theme(settings))
    print(json.dumps(info, indent=2))


def cmd_list(as_json):
    active = active_name()
    themes = all_themes()
    if as_json:
        out = []
        for t in themes:
            c = t.pop("colors")
            t["active"] = t["name"] == active
            t["swatches"] = {k: c.get(k) for k in ("ground", "surface", "accent", "ink")}
            out.append(t)
        print(json.dumps(out, indent=2))
        return
    for t in themes:
        print("{} {}\t{}\t{}\t{}".format("*" if t["name"] == active else " ", t["name"], t["label"], t["mode"], t["source"]))


def usage(stream=sys.stdout):
    doc = __doc__.split("\n\n")[0] + "\n\n" + __doc__.split("\n\n")[1]
    print(doc.strip("\n"), file=stream)


def main(argv):
    args = list(argv)
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    verb = args[0] if args else ""
    rest = args[1:]
    if verb in ("-h", "--help", "help"):
        usage()
        return 0
    if verb in ("", "current"):
        cmd_current(as_json)
        return 0
    if verb == "list":
        cmd_list(as_json)
        return 0
    with locked():
        if verb == "set" and len(rest) == 1:
            cmd_set(rest[0])
        elif verb == "auto" and len(rest) <= 1:
            cmd_auto(rest[0] if rest else None)
        elif verb == "mode" and len(rest) <= 1:
            cmd_mode(rest[0] if rest else None)
        elif verb == "zen" and len(rest) <= 1:
            cmd_zen(rest[0] if rest else None)
        elif verb == "toggle" and not rest:
            cmd_toggle()
        elif verb == "apply" and not rest:
            cmd_apply()
        elif verb == "reload" and not rest:
            reload()
        elif verb == "sync" and set(rest) <= {"--force", "--no-redraw"}:
            sync(force="--force" in rest, redraw="--no-redraw" not in rest)
        elif verb in ("winter", "polar-night") and not rest:
            cmd_set(verb)
        elif verb in ("dark", "light") and not rest:
            if auto_colors():
                cmd_mode(verb)
            else:
                cmd_set(static_for_mode(verb))
        else:
            usage(sys.stderr)
            return 2
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Error as e:
        warn(str(e))
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
