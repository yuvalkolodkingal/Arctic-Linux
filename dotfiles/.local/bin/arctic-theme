#!/usr/bin/env bash
# arctic-theme — switch the whole desktop between Winter (light) and Polar night (dark).
#
#   arctic-theme                 show the current theme
#   arctic-theme winter          switch to Winter
#   arctic-theme polar-night     switch to Polar night
#   arctic-theme toggle          switch to the other one (Super+Shift+T)
#   arctic-theme apply           re-apply the saved theme (runs at login)
#
# One setting drives everything (design: guidelines/10-platforms.md "Theme switching"):
# ~/.config/arctic/current points at themes/<name>; kitty, waybar, mako, fuzzel, swaylock,
# GTK and Mango all read their colours through it. The GTK colour scheme follows along.
set -euo pipefail

ARCTIC_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/arctic"
STATE="$ARCTIC_DIR/theme"
DEFAULT_THEME="polar-night"   # live USB and first login default to Polar night

current() {
  if [[ -f "$STATE" ]]; then cat "$STATE"; else echo "$DEFAULT_THEME"; fi
}

set_theme() {
  local name="$1"
  if [[ ! -d "$ARCTIC_DIR/themes/$name" ]]; then
    echo "arctic-theme: unknown theme '$name' (winter or polar-night)" >&2
    exit 2
  fi
  echo "$name" > "$STATE"
  ln -sfn "themes/$name" "$ARCTIC_DIR/current"
  # shellcheck source=/dev/null
  source "$ARCTIC_DIR/current/theme.env"

  # GTK / libadwaita / portals (Qt follows through the portal).
  if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface color-scheme "$ARCTIC_COLOR_SCHEME" 2>/dev/null || true
    if [[ "$ARCTIC_GTK_PREFER_DARK" == 1 ]]; then
      gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark 2>/dev/null || true
    else
      gsettings set org.gnome.desktop.interface gtk-theme Adwaita 2>/dev/null || true
    fi
  fi
  local ini="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini"
  if [[ -f "$ini" ]]; then
    sed -i "s/^gtk-application-prefer-dark-theme=.*/gtk-application-prefer-dark-theme=$ARCTIC_GTK_PREFER_DARK/" "$ini"
  fi

  reload_all
}

reload_all() {
  # Everything below is best effort: a component that isn't running is skipped.
  pkill -USR1 -x kitty 2>/dev/null || true            # kitty re-reads kitty.conf
  pkill -USR2 -x waybar 2>/dev/null || true           # waybar reloads config + style
  command -v makoctl >/dev/null && makoctl reload 2>/dev/null || true
  command -v mmsg >/dev/null && mmsg dispatch reload_config >/dev/null 2>&1 || true
  command -v arctic-wallpaper >/dev/null && arctic-wallpaper >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

case "${1:-}" in
  "")            current ;;
  winter)        set_theme winter ;;
  polar-night|dark) set_theme polar-night ;;
  light)         set_theme winter ;;
  toggle)        if [[ "$(current)" == winter ]]; then set_theme polar-night; else set_theme winter; fi ;;
  apply)         set_theme "$(current)" ;;
  -h|--help)     sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)             echo "usage: arctic-theme [winter|polar-night|toggle|apply]" >&2; exit 2 ;;
esac
